<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The shell's settings file, telemetry payloads and freshness rule are
       app-layer facts with public promises attached (HM-DEC-018/019/020), so
       they are tested here rather than being pushed into the engine to make
       them reachable. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hamlet.App\Hamlet.App.csproj" />
  </ItemGroup>

  <!-- ONE LOCATOR FOR UPSTREAM'S OFF-AIR RECORDINGS, NOT TWO (unit 226). See the
       matching comment in Hamlet.RadioEngine.Tests. The measurement that ends on
       the view model's own collection has to open the same recordings the engine
       measurement opens, by the same rule. -->
  <ItemGroup>
    <Compile Include="..\Shared\OffAirRecordings.cs" Link="Shared\OffAirRecordings.cs" />
  </ItemGroup>

  <!-- ONE READER FOR THE PSK31 TRANSCRIPT CORPUS, NOT TWO (unit 316). The engine's parser
       test and the panel's conversation test hold the same corpus, and a second reader is
       a second way of reading one file. -->
  <ItemGroup>
    <Compile Include="..\Hamlet.RadioEngine.Tests\Psk31\Psk31Corpus.cs" Link="Shared\Psk31Corpus.cs" />
  </ItemGroup>

  <!-- ONE SCRIPTED RADIO, NOT TWO (work instruction 424). What is said about the preamp
       is said partly by the engine and partly by the main panel, so the trace that prints
       every sentence drives the setup here, against the same radio and bench the engine's
       Rig tests use. -->
  <ItemGroup>
    <Compile Include="..\Hamlet.RadioEngine.Tests\Rig\ScriptedRadio.cs" Link="Shared\ScriptedRadio.cs" />
    <Compile Include="..\Hamlet.RadioEngine.Tests\Rig\ModeEntryBench.cs" Link="Shared\ModeEntryBench.cs" />
  </ItemGroup>

  <!-- EXCLUDED FROM COMPILATION, NOT RETIRED (work instruction 392, CW phase step 1,
       decision 3). src\Hamlet.RadioEngine\Cw is 7e209cb4's (R53) and each file below
       names a type or member that commit does not have; the missing name each quotes
       is listed in docs\phase-cw\unit392-seams.md. The files stay in the tree
       unedited. Step 3 retires or repairs each one under R49, one at a time, and
       takes its line out of this group when it does. -->
  <ItemGroup>
    <Compile Remove="Views\ThePitchControlsAreOffThePanelTests.cs" />
  </ItemGroup>

</Project>
