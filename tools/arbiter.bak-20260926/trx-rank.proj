<!--
  trx-rank.proj - a way to REACH tools\arbiter\trx-rank.py, not a second copy
  of it.

  THE DEADLOCK, same shape as validate-output.proj's. This session's shell
  refuses `python <script>`, refuses `python -c`, refuses `powershell`, and
  refuses a .bat invoked directly; `dotnet build` is permitted with a wildcard
  and MSBuild's Exec task runs a command. So:

      dotnet build tools/arbiter/trx-rank.proj -p:Trx=.run-unit/trx/x.trx
      dotnet build tools/arbiter/trx-rank.proj -p:Trx=... -p:Top=20

  NOTHING HERE RANKS ANYTHING. It calls the python unmodified and fails the
  build on a non-zero exit. Delete it the moment the allow-list gains python.

  Plain MSBuild, no SDK: this needs no restore and no sources.

  Written by unit 250.
-->
<Project DefaultTargets="Build">

  <PropertyGroup>
    <Top Condition="'$(Top)' == ''">20</Top>
  </PropertyGroup>

  <Target Name="Build">
    <Error Condition="'$(Trx)' == ''" Text="Pass -p:Trx=&lt;path to a .trx&gt;" />
    <Message Importance="high" Text="Ranking $(Trx), top $(Top)" />
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)trx-rank.py&quot; &quot;$(Trx)&quot; $(Top) $(Name)"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\.."
          ContinueOnError="false" />
  </Target>

</Project>
