<!--
  outcome-append.proj - a way to REACH tools\arbiter\outcome-append.bat, for the
  same reason tools\arbiter\validate-output.proj exists and by the same route.

  .run-unit\allowed.txt does not name outcome-append.bat in any spelling, so
  every direct call is refused with "This command requires approval". It DOES
  name `dotnet build` with a wildcard, and MSBuild's Exec task runs a command.

  NOTHING HERE COMPOSES A RECORD. The fourteen arguments are properties supplied
  on the command line by the unit that is recording itself; this file only puts
  them in the order outcome-append.bat parses them and lets that script write the
  entry, update the step state in the header, and set the exit code. PHASE_OUTCOME.md
  is not opened here.

  Why through the tool rather than by hand: outcome-append.bat does TWO things in
  one call - it appends the entry and it updates the step's state in the header,
  in place. A hand-written entry gets the first and forgets the second, and a
  header that lags its entries is a position nobody can trust. That argument is
  the script's own, in its comments.

      dotnet build tools/arbiter/outcome-append.proj -p:Unit=1 -p:Step=0 ...

  Written by unit 243.
-->
<Project DefaultTargets="Build">

  <!--
    THE FOURTEEN VALUES COME FROM A FILE, NOT FROM THE COMMAND LINE, and that is
    not a preference. MSBuild's -p: switch splits a property value on commas and
    semicolons, so the first comma in a sentence becomes a second switch and the
    build fails with "Property is not valid" naming half a sentence. Measured on
    the first attempt at this. Prose without commas is not prose, and %2C
    everywhere is how a record acquires a typo it keeps forever.

        dotnet build tools/arbiter/outcome-append.proj -p:EntryProps=<file>

    where <file> is a props file setting Unit, Step, State, Approach, Hit, Move,
    Why, Decided, Licence, Cost, Accomplished, Fate and StateWhy as elements.
    XML has no comma problem. Put it under .run-unit\scratch\ so the unit's input
    does not land in the tree.
  -->
  <Import Project="$(EntryProps)" Condition="'$(EntryProps)' != ''" />

  <PropertyGroup>
    <Cost Condition="'$(Cost)' == ''">unknown</Cost>
    <OutcomeFile Condition="'$(OutcomeFile)' == ''">$(MSBuildThisFileDirectory)..\..\PHASE_OUTCOME.md</OutcomeFile>
    <Fate Condition="'$(Fate)' == ''">executed</Fate>
    <StateWhy Condition="'$(StateWhy)' == ''">not recorded</StateWhy>
  </PropertyGroup>

  <Target Name="Build">
    <Error Condition="'$(Unit)' == ''" Text="Unit is required" />
    <Error Condition="'$(Step)' == ''" Text="Step is required" />
    <Error Condition="'$(State)' == ''" Text="State is required" />
    <Error Condition="'$(Approach)' == ''" Text="Approach is required" />
    <Error Condition="'$(Hit)' == ''" Text="Hit is required" />
    <Error Condition="'$(Move)' == ''" Text="Move is required" />
    <Error Condition="'$(Why)' == ''" Text="Why is required" />
    <Error Condition="'$(Decided)' == ''" Text="Decided is required" />
    <Error Condition="'$(Licence)' == ''" Text="Licence is required" />
    <Error Condition="'$(Accomplished)' == ''" Text="Accomplished is required" />

    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\.."
          ContinueOnError="false"
          Command="&quot;$(MSBuildThisFileDirectory)outcome-append.bat&quot; &quot;$(Unit)&quot; &quot;$(Step)&quot; &quot;$(State)&quot; &quot;$(Approach)&quot; &quot;$(Hit)&quot; &quot;$(Move)&quot; &quot;$(Why)&quot; &quot;$(Decided)&quot; &quot;$(Licence)&quot; &quot;$(Cost)&quot; &quot;$(Accomplished)&quot; &quot;$(OutcomeFile)&quot; &quot;$(Fate)&quot; &quot;$(StateWhy)&quot;" />
  </Target>

</Project>
