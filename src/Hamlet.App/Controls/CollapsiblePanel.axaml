<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="using:Hamlet.App.Controls">

    <!-- The header button: no chrome of its own, a subtle hover, and a hand
         cursor so the whole bar reads as clickable (HM-DEC-021). -->
    <ControlTheme x:Key="HmPanelHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:CollapsiblePanel}" TargetType="ctl:CollapsiblePanel">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,0,14,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="Auto,*">

                        <!-- The header carries the panel's name for screen
                             readers and UI automation; without it a shut
                             panel is an unlabeled button. -->
                        <Button Grid.Row="0" Name="PART_Header"
                                Theme="{StaticResource HmPanelHeaderButton}"
                                AutomationProperties.Name="{TemplateBinding Title}"
                                Background="Transparent">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="{TemplateBinding Chevron}"
                                           FontSize="14" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding FamilyBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Title}"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding FamilyBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding Summary}"
                                           FontSize="12"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding SummaryBrush}" />
                            </Grid>
                        </Button>

                        <ContentPresenter Grid.Row="1"
                                          Name="PART_Content"
                                          IsVisible="{TemplateBinding IsExpanded}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Stretch" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- A collapsed panel takes header height and no more, even inside a
             proportional grid row. -->
        <Style Selector="^:collapsed">
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- Hover is the slate tint from the palette, literal so this theme
             depends on no application resource and can never load before the
             thing it needs. -->
        <Style Selector="^ /template/ Button#PART_Header:pointerover">
            <Setter Property="Background" Value="#EDEAE1" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
