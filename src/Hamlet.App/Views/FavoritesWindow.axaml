<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hamlet.App.ViewModels"
        x:Class="Hamlet.App.Views.FavoritesWindow"
        x:DataType="vm:FavoritesViewModel"
        Title="Manage favorites"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HmBackgroundBrush}">

    <Design.DataContext>
        <vm:FavoritesViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0" Margin="0,0,0,10"
                   Text="Each one remembers what it was for, which is the thing a numbered memory channel cannot tell you."
                   FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource HmTextMutedBrush}" />

        <Border Grid.Row="1" Background="White" CornerRadius="8"
                BorderBrush="{StaticResource HmSlateEdgeBrush}" BorderThickness="1">
            <Grid>
                <!-- Telling somebody how to fill it rather than showing a blank
                     list, because a blank list reads as something broken. -->
                <TextBlock Text="{x:Static vm:FavoritesViewModel.EmptyNote}"
                           IsVisible="{Binding IsEmpty}"
                           Margin="16" FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource HmTextMutedBrush}" />

                <ListBox ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding Selected}"
                         IsVisible="{Binding !IsEmpty}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FavoriteRowViewModel">
                            <Grid ColumnDefinitions="70,*" Margin="0,4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FrequencyLabel}"
                                           FontFamily="Consolas,Menlo,monospace"
                                           FontSize="13" VerticalAlignment="Center"
                                           Foreground="{StaticResource HmAmberDeepBrush}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBox Text="{Binding Name, Mode=TwoWay}"
                                             FontSize="13" Padding="6,3" />
                                    <TextBlock Text="{Binding Provenance}" FontSize="11"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Move up" Command="{Binding MoveUpCommand}" Padding="12,5" />
            <Button Content="Move down" Command="{Binding MoveDownCommand}" Padding="12,5" />
            <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="12,5" />
            <Button Content="Save names" Command="{Binding ApplyCommand}" Padding="12,5" />
        </StackPanel>
    </Grid>
</Window>
