<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hamlet.App.ViewModels"
        xmlns:ctl="using:Hamlet.App.Controls"
        xmlns:explore="using:Hamlet.RadioEngine.Explore"
        x:Class="Hamlet.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hamlet"
        Width="1100" Height="780"
        MinWidth="900" MinHeight="620"
        Background="{StaticResource HmBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.hm-connect">
            <Setter Property="Background" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.hm-connect:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.hm-band">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource HmTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.hm-panel-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

        <!-- Brand, menu, connection -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0,4,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="Ham" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource HmAmberBrush}" />
                <TextBlock Text="let" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource HmBlueBrush}" />
            </StackPanel>

            <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="_File">
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </MenuItem>
                <MenuItem Header="_Radio">
                    <MenuItem Header="{Binding ConnectButtonText}"
                              Command="{Binding ToggleConnectCommand}" />
                    <Separator />
                    <MenuItem Header="Send CW…  (phase 1)" IsEnabled="False" />
                    <MenuItem Header="Spectrum scope  (phase 2)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Explore">
                    <MenuItem Header="Refresh spots" Command="{Binding RefreshSpotsCommand}" />
                    <Separator />
                    <MenuItem Header="Live spot feeds  (phase 1.5)" IsEnabled="False" />
                    <MenuItem Header="Find me a CQ I can copy  (phase 2)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
                    <MenuItem Header="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Diagnostics viewer  (later)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Getting started  (phase 1.5)" IsEnabled="False" />
                    <MenuItem Header="About Hamlet" Command="{Binding OpenAboutCommand}" />
                </MenuItem>
            </Menu>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort}"
                          IsEnabled="{Binding !IsConnected}"
                          MinWidth="220" VerticalAlignment="Center" />
                <Button Classes="hm-connect"
                        Content="{Binding ConnectButtonText}"
                        Command="{Binding ToggleConnectCommand}" />
            </StackPanel>
        </Grid>

        <!-- Band buttons -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Bands}" Margin="0,6,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BandButtonViewModel">
                    <Grid RowDefinitions="Auto,Auto">
                        <Border Grid.Row="0" HorizontalAlignment="Center"
                                Background="{StaticResource HmGreenTintBrush}"
                                BorderBrush="{StaticResource HmGreenEdgeBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="6,0" Margin="0,0,0,2"
                                IsVisible="{Binding IsBestBet}">
                            <TextBlock Text="best bet now" FontSize="11"
                                       Foreground="{StaticResource HmGreenBrush}" />
                        </Border>
                        <Button Grid.Row="1" Classes="hm-band"
                                Content="{Binding Band.Name}"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectBandCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Frequency face: the rig's own LCD on the console. Deliberately
             NOT collapsible (HM-DEC-021) — it is the app's anchor. -->
        <Border Grid.Row="2"
                Background="{StaticResource HmAmberTintBrush}"
                BorderBrush="{StaticResource HmAmberEdgeBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="20,12" Margin="0,0,0,12">
            <StackPanel Spacing="6">
                <ctl:RigDisplayControl HorizontalAlignment="Center"
                    FrequencyHz="{Binding FrequencyHz}"
                    BandLowHz="{Binding SelectedBand.Band.LowHz}"
                    BandHighHz="{Binding SelectedBand.Band.HighHz}"
                    ModeText="CW" FilterText="FIL2" />
                <TextBlock Text="scroll wheel over a digit tunes that digit"
                           FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource HmAmberBrush}" />
            </StackPanel>
        </Border>

        <!-- Map, tape, then explorer beside waterfall/terminal -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*">

            <ctl:CollapsiblePanel Grid.Row="0" Margin="0,0,0,10"
                                  Family="Blue"
                                  Title="Neighborhood map"
                                  Summary="{Binding MapSummary}"
                                  IsExpanded="{Binding MapExpanded, Mode=TwoWay}">
                <StackPanel Spacing="6">
                    <TextBlock Text="hover a dot to see who it is · click a dot to tune there · click the background for a neighborhood's story · drag to tune"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                    <ctl:NeighborhoodMapControl Height="44"
                        FrequencyHz="{Binding FrequencyHz}"
                        BandLowHz="{Binding SelectedBand.Band.LowHz}"
                        BandHighHz="{Binding SelectedBand.Band.HighHz}"
                        Neighborhoods="{Binding Neighborhoods}"
                        ActivityDots="{Binding ActivityDots}"
                        PrivilegeSpans="{Binding PrivilegeSpans}"
                        TuneCommand="{Binding TuneToDotCommand}"
                        SelectCommand="{Binding ShowNeighborhoodCommand}" />

                    <!-- The status line, replacing the old mode line
                         (HM-DEC-029). Green when the frequency is theirs,
                         amber when it is listen-only — a caution, never an
                         error — and plain when the class is unknown. -->
                    <Border CornerRadius="6" Padding="10,7"
                            Background="{Binding PrivilegeStatus.Tone,
                                Converter={x:Static ctl:PrivilegeToneConverter.Background}}"
                            BorderBrush="{Binding PrivilegeStatus.Tone,
                                Converter={x:Static ctl:PrivilegeToneConverter.Border}}"
                            BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding PrivilegeStatus.Headline}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding PrivilegeStatus.Tone,
                                           Converter={x:Static ctl:PrivilegeToneConverter.Text}}" />

                            <TextBlock Text="{Binding PrivilegeStatus.Detail}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <!-- The sentence that removes the fear. Shown
                                 whenever transmitting is restricted. -->
                            <TextBlock Text="{Binding PrivilegeStatus.Reassurance}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}"
                                       IsVisible="{Binding PrivilegeStatus.Reassurance,
                                           Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding PrivilegeStatus.UpgradePrompt}"
                                        FontSize="11" Padding="9,3"
                                        Command="{Binding ToggleUpgradeLadderCommand}"
                                        IsVisible="{Binding PrivilegeStatus.UpgradePrompt,
                                            Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />

                                <TextBlock Text="{Binding PrivilegeStatus.Citation}"
                                           FontSize="10" VerticalAlignment="Center"
                                           Foreground="{StaticResource HmTextMutedBrush}"
                                           IsVisible="{Binding PrivilegeStatus.Citation,
                                               Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />
                            </StackPanel>

                            <!-- On click only, never permanent chrome. -->
                            <ItemsControl ItemsSource="{Binding UpgradeLadder}"
                                          IsVisible="{Binding UpgradeLadderVisible}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- A lookup disagreeing with a hand-set class. Both
                         values, the source, and the operator decides — never
                         a silent overwrite (HM-DEC-028). -->
                    <Border CornerRadius="6" Padding="10,7"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding LicenceMismatch,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotNull}}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding LicenceMismatch.Narration}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HmAmberDeepBrush}" />
                            <TextBlock Text="Your licence, your call. Nothing has been changed."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Use the FCC value" FontSize="11" Padding="9,3"
                                        Command="{Binding AcceptLookedUpClassCommand}" />
                                <Button Content="Keep mine" FontSize="11" Padding="9,3"
                                        Command="{Binding KeepMyLicenceClassCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ctl:CollapsiblePanel>

            <ctl:CollapsiblePanel Grid.Row="1" Margin="0,0,0,10"
                                  Family="Amber"
                                  Title="Dial tape"
                                  Summary="{Binding ModeLineText}"
                                  SummaryBrush="{Binding IsInsideCwSegment,
                                      Converter={x:Static ctl:ModeLineBrushConverter.Instance}}"
                                  IsExpanded="{Binding TapeExpanded, Mode=TwoWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="drag to tune, flick for momentum, wheel = ±10 Hz"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                    <ctl:DialTapeControl Height="74"
                        FrequencyHz="{Binding FrequencyHz}"
                        BandLowHz="{Binding SelectedBand.Band.LowHz}"
                        BandHighHz="{Binding SelectedBand.Band.HighHz}"
                        CwLowHz="{Binding SelectedBand.Band.CwLowHz}"
                        CwHighHz="{Binding SelectedBand.Band.CwHighHz}" />
                    <TextBlock Text="{Binding ModeLineText}"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{Binding IsInsideCwSegment,
                                   Converter={x:Static ctl:ModeLineBrushConverter.Instance}}" />
                </StackPanel>
            </ctl:CollapsiblePanel>

            <Grid Grid.Row="2" ColumnDefinitions="3*,2*">

                <!-- Stacked rather than proportioned: a collapsed panel must
                     hand its space to the panel below it, not leave a hole
                     where a fixed grid row used to be (HM-DEC-021). -->
                <ScrollViewer Grid.Column="0" Margin="0,0,10,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">

                        <ctl:CollapsiblePanel Family="Blue"
                                              Title="Waterfall"
                                              Summary="{Binding WaterfallSummary}"
                                              IsExpanded="{Binding WaterfallExpanded, Mode=TwoWay}">
                            <StackPanel Spacing="6">

                                <!-- The persistent label of HM-DEC-026. Bound
                                     to a property with no setter, derived from
                                     the source itself, so it cannot be shown
                                     without the signals being simulated or
                                     hidden while they are. -->
                                <Border Background="{StaticResource HmAmberTintBrush}"
                                        BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="8,4"
                                        IsVisible="{Binding SignalsAreSimulated}">
                                    <TextBlock Text="{Binding SpectrumNotice}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource HmAmberDeepBrush}" />
                                </Border>

                                <ctl:WaterfallControl MinHeight="260"
                                    Source="{Binding SpectrumSource}"
                                    FrequencyHz="{Binding FrequencyHz}"
                                    BandLowHz="{Binding SelectedBand.Band.LowHz}"
                                    BandHighHz="{Binding SelectedBand.Band.HighHz}"
                                    Gain="{Binding WaterfallGain}"
                                    TuneCommand="{Binding TuneToCommand}" />

                                <TextBlock Text="click a signal to tune to it — the axis matches the map and the dial tape above"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource HmTextMutedBrush}" />
                            </StackPanel>
                        </ctl:CollapsiblePanel>

                        <ctl:CollapsiblePanel Family="Green"
                                              Title="CW terminal"
                                              Summary="{Binding TerminalSummary}"
                                              IsExpanded="{Binding TerminalExpanded, Mode=TwoWay}">
                            <TextBlock Text="&gt; decoded text will arrive here — phase 1"
                                       MinHeight="150"
                                       FontFamily="{StaticResource HmMonoFont}"
                                       Foreground="{StaticResource HmGreenBrush}"
                                       VerticalAlignment="Top" />
                        </ctl:CollapsiblePanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- The Explorer (HM-DEC-016) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">

                        <!-- The lead card and the band-conditions line
                             (HM-DEC-025): one written suggestion for somebody
                             with no idea where to start, and an honest answer
                             to "is tonight worth it". -->
                        <ctl:CollapsiblePanel Family="Amber"
                                              Title="Where to start"
                                              Summary="{Binding Lead.Headline}"
                                              IsExpanded="{Binding LeadExpanded, Mode=TwoWay}">
                            <StackPanel Spacing="10">

                                <Border Background="{StaticResource HmAmberTintBrush}"
                                        BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Lead.Headline}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Lead.Body}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                                        <!-- The evidence, never hidden: the
                                             same reason line the ranked card
                                             carries (HM-DEC-009). -->
                                        <TextBlock Text="{Binding Lead.Reason}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />

                                        <Button Content="{Binding Lead.FrequencyLabel,
                                                    StringFormat='Tune {0}'}"
                                                FontSize="12"
                                                HorizontalAlignment="Left"
                                                IsVisible="{Binding Lead.HasSuggestion}"
                                                Command="{Binding TuneToCommand}"
                                                CommandParameter="{Binding Lead.TuneHz}" />
                                    </StackPanel>
                                </Border>

                                <Border Background="White"
                                        BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding Conditions.Claim}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Conditions.Evidence}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ctl:CollapsiblePanel>

                        <ctl:CollapsiblePanel Family="Amber"
                                              Title="Field notes"
                                              Summary="{Binding StoryTitle}"
                                              IsExpanded="{Binding StoryExpanded, Mode=TwoWay}">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding StoryTitle}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource HmAmberDeepBrush}"
                                               TextWrapping="Wrap" />
                                    <Border Grid.Column="1"
                                            Background="{StaticResource HmAmberTintBrush}"
                                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="{Binding StoryBadge}" FontSize="11"
                                                   Foreground="{StaticResource HmAmberDeepBrush}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding StoryBody}" FontSize="13"
                                           TextWrapping="Wrap" LineHeight="19"
                                           Foreground="{StaticResource HmTextPrimaryBrush}" />
                                <Button Content="Take me there" FontSize="12"
                                        Command="{Binding TuneToCommand}"
                                        CommandParameter="{Binding StoryTuneHz}" />
                            </StackPanel>
                        </ctl:CollapsiblePanel>

                        <ctl:CollapsiblePanel Family="Blue"
                                              Title="Field guide"
                                              Summary="{Binding GuideSummary}"
                                              IsExpanded="{Binding GuideExpanded, Mode=TwoWay}">
                            <ItemsControl ItemsSource="{Binding ModeCards}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModeCardViewModel">
                                        <Border Margin="0,0,0,8" Padding="10,8"
                                                Background="White"
                                                BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <StackPanel Spacing="6">

                                                <!-- The animated fingerprint:
                                                     the same synthesiser that
                                                     draws the waterfall, so
                                                     ear and eye learn one
                                                     picture (HM-DEC-027). -->
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <ctl:ModeFingerprintControl Grid.Column="0"
                                                        Kind="{Binding Mode.Signature}"
                                                        VerticalAlignment="Center" />

                                                    <StackPanel Grid.Column="1"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Mode.Name}"
                                                                   FontSize="13" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Mode.Sound}"
                                                                   FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="?"
                                                            FontSize="12" Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="What is this mode, and why bother?"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowModeCommand}"
                                                            CommandParameter="{Binding Mode}" />
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                            IsVisible="{Binding HasSamples}">
                                                    <TextBlock Text="Hear it:" FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                                    <ItemsControl ItemsSource="{Binding Samples}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ModeSampleButton">
                                                                <Button Content="{Binding Label}"
                                                                        FontSize="11" Padding="9,3"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlaySampleCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ctl:CollapsiblePanel>

                        <ctl:CollapsiblePanel Family="Green"
                                              Title="Happening now"
                                              Summary="{Binding SpotsSummary}"
                                              SummaryBrush="{Binding SpotsFreshness,
                                                  Converter={x:Static ctl:FreshnessBrushConverter.Instance}}"
                                              IsExpanded="{Binding SpotsExpanded, Mode=TwoWay}">
                            <ItemsControl ItemsSource="{Binding Spots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SpotViewModel">
                                        <Border Background="{StaticResource HmGreenTintBrush}"
                                                BorderBrush="{StaticResource HmGreenEdgeBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="10,8" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Story}" FontSize="12"
                                                               TextWrapping="Wrap" />

                                                    <!-- Why this card is where
                                                         it is, on its face and
                                                         never in a tooltip
                                                         (HM-DEC-025). -->
                                                    <TextBlock Text="{Binding Reason}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource HmGreenBrush}" />

                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Background="{StaticResource HmAmberTintBrush}"
                                                                BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                                                BorderThickness="1" CornerRadius="6"
                                                                Padding="5,0"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsNew}">
                                                            <TextBlock Text="new" FontSize="10"
                                                                       Foreground="{StaticResource HmAmberDeepBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Provenance}" FontSize="10"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding TuneLabel}"
                                                        FontSize="12" VerticalAlignment="Center"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TuneToCommand}"
                                                        CommandParameter="{Binding FrequencyHz}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ctl:CollapsiblePanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4"
                Background="{StaticResource HmSlateTintBrush}"
                BorderBrush="{StaticResource HmSlateEdgeBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </Border>
    </Grid>
</Window>
