<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hamlet.App.ViewModels"
        xmlns:ctl="using:Hamlet.App.Controls"
        xmlns:explore="using:Hamlet.RadioEngine.Explore"
        xmlns:rig="using:Hamlet.RadioEngine.Rig"
        xmlns:cw="using:Hamlet.RadioEngine.Cw"
        xmlns:lay="using:Hamlet.App.Layout"
        x:Class="Hamlet.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Hamlet"
        Width="1100" Height="780"
        MinWidth="900" MinHeight="620"
        Background="{StaticResource HmBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.hm-connect">
            <Setter Property="Background" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.hm-connect:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- THE SEND BUTTONS HAD NO STYLE AT ALL (HM-DEC-080), so they fell
             through to the theme's default, which is a pale grey fill in every
             state including the working one. Nothing was dimming them: grey WAS
             their ordinary appearance, and a working button and a refused one
             were near enough identical that the operator reasonably assumed the
             worse of the two. Three sessions went looking for a state bug that
             was not there.

             Filled and colored per state now, from the app's own palette
             (HM-DEC-012): amber for ready because amber is what this app already
             uses for "do this", deeper amber for a message waiting on its
             confirming press, green for one going out, and pale outline only for
             a refusal. Grey is now the only thing that means unpressable, which
             is what HM-DEC-079 ruled and what the theme was quietly
             contradicting. -->
        <Style Selector="Button.hm-send">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.hm-send.ready /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.hm-send.ready:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.hm-send.armed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.hm-send.armed:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- The one state grey is for. -->
        <Style Selector="Button.hm-send.refused /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HmTextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- THE TWO WAYS A NOTE ABOUT AN ABSENT WIDGET IS DRAWN (HM-DEC-087).
             Quiet is the resting one and is nearly the paper it sits on; live is
             the app's amber, which is what it already uses for "look at this".
             Color is not the only carrier: a live note also has a mark beside it
             (§0.6). -->
        <Style Selector="Border.hm-note">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
        </Style>

        <Style Selector="Border.hm-note.live">
            <Setter Property="Background" Value="{StaticResource HmAmberTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberEdgeBrush}" />
        </Style>

        <!-- **THE ONE THAT KEYS THE RADIO LOOKS DIFFERENT FROM THE ONES THAT
             DO NOT** (Tim's ruling of 2026-08-27, and §0.5.1). Send is filled
             amber, which is this application's colour for Morse and for the
             transmitter; Clear is an action rather than a message and is drawn
             apart from the macros beside it; and the macros are ordinary buttons
             because filling a line is an ordinary thing.

             **GREY IS RESERVED FOR REFUSED** (HM-DEC-080), so neither of these
             is dimmed for any other reason, and a refusal always prints why. -->
        <Style Selector="Button.hm-send">
            <Setter Property="Background" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.hm-send:disabled">
            <Setter Property="Background" Value="{StaticResource HmSlateTintBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HmTextMutedBrush}" />
        </Style>

        <Style Selector="Button.hm-clear">
            <Setter Property="Background" Value="{StaticResource HmSlateTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource HmTextMutedBrush}" />
        </Style>

        <!-- **A TAB LOOKS PRESSABLE AND THE CHOSEN ONE LOOKS CHOSEN** (§0.5.1).
             Grey is reserved for what genuinely cannot be used, so an unselected
             tab is drawn at full strength and the selected one is filled. -->
        <Style Selector="RadioButton.hm-tab">
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource HmSlateTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{StaticResource HmTextPrimaryBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- **THE SELECTED TAB MERGES INTO THE SPACE IT CONTROLS** (Tim,
             2026-08-27). Same fill and same edge as the boundary below it, and
             no bottom border, so the two read as one shape rather than as a
             button sitting above a box. It overlaps the boundary's top edge by
             one pixel so no hairline shows through between them. -->
        <Style Selector="RadioButton.hm-tab:checked">
            <Setter Property="Background" Value="{StaticResource HmPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Margin" Value="0,0,0,-1" />
        </Style>

        <Style Selector="Button.hm-band">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource HmTextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmSlateEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- The segmented control at the head of the happening-now panel
             (HM-DEC-057). Both lenses are always visible, because two words on
             screen teach more than any inference, and the one in use is filled
             so there is never a question which is answering. -->
        <Style Selector="ToggleButton.hm-lens">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource HmTextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmGreenEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ToggleButton.hm-lens:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmGreenTintBrush}" />
            <Setter Property="Foreground" Value="{StaticResource HmGreenBrush}" />
        </Style>
        <Style Selector="ToggleButton.hm-lens:checked">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.hm-panel-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <!-- THE THIRTEEN PANELS, KEYED BY WIDGET (HM-DEC-086).

         Each one is exactly the markup it was before it gained a position,
         and what it binds against is still the main view model, so not one
         binding inside thirteen panels had to be rewritten to put them on a
         canvas. The only things taken away are the row and column numbers a
         fixed layout needed.

         They keep their own headers, their own family colors and their own
         collapse, because none of that stopped being true (§0.5, §0.6). -->
    <Window.Resources>
        <!-- Neighborhood map -->
        <DataTemplate x:Key="widget.map" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel
                                  Family="Blue"
                                  Title="Neighborhood map"
                                  Summary="{Binding MapSummary}"
                                  IsExpanded="{Binding MapExpanded, Mode=TwoWay}">
                <StackPanel Spacing="6">
                    <TextBlock Text="hover a dot to see who it is · click a dot to tune there · click the background for a neighborhood's story · drag to tune"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                    <ctl:NeighborhoodMapControl Height="44"
                        FrequencyHz="{Binding FrequencyHz}"
                        BandLowHz="{Binding MapLowHz}"
                        BandHighHz="{Binding MapHighHz}"
                        Neighborhoods="{Binding Neighborhoods}"
                        ActivityDots="{Binding ActivityDots}"
                        PrivilegeSpans="{Binding PrivilegeSpans}"
                        TuneCommand="{Binding TuneToDotCommand}"
                        SelectCommand="{Binding ShowNeighborhoodCommand}" />

                    <!-- The key to the colors (HM-DEC-032). Without it the
                         washes are decoration; with it they are a language the
                         operator learns once. -->
                    <ctl:MapLegendControl Margin="0,2,0,0" />

                    <!-- The status line, replacing the old mode line
                         (HM-DEC-029). Green when the frequency is theirs,
                         amber when it is listen-only — a caution, never an
                         error — and plain when the class is unknown. -->
                    <Border CornerRadius="6" Padding="10,7"
                            Background="{Binding PrivilegeStatus.Tone,
                                Converter={x:Static ctl:PrivilegeToneConverter.Background}}"
                            BorderBrush="{Binding PrivilegeStatus.Tone,
                                Converter={x:Static ctl:PrivilegeToneConverter.Border}}"
                            BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding PrivilegeStatus.Headline}"
                                       FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding PrivilegeStatus.Tone,
                                           Converter={x:Static ctl:PrivilegeToneConverter.Text}}" />

                            <TextBlock Text="{Binding PrivilegeStatus.Detail}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <!-- What the map knows and the regulation cannot:
                                 what would actually happen if you called here
                                 (HM-DEC-054). A consequence, never an
                                 instruction. -->
                            <TextBlock Text="{Binding PrivilegeStatus.Culture}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextPrimaryBrush}"
                                       IsVisible="{Binding PrivilegeStatus.Culture,
                                           Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />

                            <!-- The sentence that removes the fear. Shown
                                 whenever transmitting is restricted. -->
                            <TextBlock Text="{Binding PrivilegeStatus.Reassurance}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}"
                                       IsVisible="{Binding PrivilegeStatus.Reassurance,
                                           Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{Binding PrivilegeStatus.UpgradePrompt}"
                                        FontSize="11" Padding="9,3"
                                        Command="{Binding ToggleUpgradeLadderCommand}"
                                        IsVisible="{Binding PrivilegeStatus.UpgradePrompt,
                                            Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />

                                <TextBlock Text="{Binding PrivilegeStatus.Citation}"
                                           FontSize="10" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource HmTextMutedBrush}"
                                           IsVisible="{Binding PrivilegeStatus.Citation,
                                               Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}" />
                            </StackPanel>

                            <!-- On click only, never permanent chrome. -->
                            <ItemsControl ItemsSource="{Binding UpgradeLadder}"
                                          IsVisible="{Binding UpgradeLadderVisible}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,3"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- A lookup disagreeing with a hand-set class. Both
                         values, the source, and the operator decides — never
                         a silent overwrite (HM-DEC-028). -->
                    <Border CornerRadius="6" Padding="10,7"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding LicenseMismatch,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotNull}}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding LicenseMismatchNarration}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HmAmberDeepBrush}" />
                            <TextBlock Text="Your license, your call. Nothing has been changed."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Use the FCC value" FontSize="11" Padding="9,3"
                                        Command="{Binding AcceptLookedUpClassCommand}" />
                                <Button Content="Keep mine" FontSize="11" Padding="9,3"
                                        Command="{Binding KeepMyLicenseClassCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- A looked-up grid disagreeing with a typed one. Same
                         rule and same shape as the class above: both values,
                         the operator decides, nothing changed until they do
                         (HM-DEC-028, HM-DEC-037). -->
                    <Border CornerRadius="6" Padding="10,7"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding GridMismatch,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotNull}}">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding GridMismatchNarration}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HmAmberDeepBrush}" />
                            <TextBlock Text="Nothing has been changed. If you're operating from where your license is registered, the looked-up one is right."
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Use the looked-up grid" FontSize="11" Padding="9,3"
                                        Command="{Binding AcceptLookedUpGridCommand}" />
                                <Button Content="Keep mine" FontSize="11" Padding="9,3"
                                        Command="{Binding KeepMyGridCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Dial tape -->
        <DataTemplate x:Key="widget.tape" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel
                                  Family="Amber"
                                  Title="Dial tape"
                                  Summary="{Binding ModeLineText}"
                                  SummaryBrush="{Binding IsInsideCwSegment,
                                      Converter={x:Static ctl:ModeLineBrushConverter.Instance}}"
                                  IsExpanded="{Binding TapeExpanded, Mode=TwoWay}">
                <StackPanel Spacing="4">
                    <TextBlock Text="drag to tune, flick for momentum, wheel = ±10 Hz. the marks along the top are the same stations the map is showing, so hover one to see who it is or click it to go there"
                               FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                    <ctl:DialTapeControl Height="74"
                        FrequencyHz="{Binding FrequencyHz}"
                        BandLowHz="{Binding SelectedBand.Band.LowHz}"
                        BandHighHz="{Binding SelectedBand.Band.HighHz}"
                        CwLowHz="{Binding SelectedBand.Band.CwLowHz}"
                        CwHighHz="{Binding SelectedBand.Band.CwHighHz}"
                        ActivityDots="{Binding ActivityDots}"
                        TuneCommand="{Binding TuneToTapeMarkerCommand}" />
                    <TextBlock Text="{Binding ModeLineText}"
                               FontSize="12" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{Binding IsInsideCwSegment,
                                   Converter={x:Static ctl:ModeLineBrushConverter.Instance}}" />

                    <!-- SUSPENDED IS A VISIBLE STATE AND NEVER A SILENT ONE
                         (HM-DEC-056). The operator always knows who is driving
                         the mode knob, because an app that quietly stopped
                         doing a thing it had been doing is worse than one that
                         never did it. -->
                    <Border IsVisible="{Binding ModeFollowSuspended}"
                            HorizontalAlignment="Center" Margin="0,4,0,0"
                            CornerRadius="10" Padding="10,3"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="You are setting the mode, so Hamlet is not"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Waterfall -->
        <DataTemplate x:Key="widget.waterfall" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Blue"
                                  Title="Waterfall"
                                  Summary="{Binding WaterfallSummary}"
                                  IsExpanded="{Binding WaterfallExpanded, Mode=TwoWay}">
                <StackPanel Spacing="6">

                    <!-- The persistent label of HM-DEC-026. Bound
                         to a property with no setter, derived from
                         the source itself, so it cannot be shown
                         without the signals being simulated or
                         hidden while they are. -->
                    <Border Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="8,4"
                            IsVisible="{Binding SignalsAreSimulated}">
                        <TextBlock Text="{Binding SpectrumNotice}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>

                    <!-- WHAT THE SCOPE PATH HAS ACTUALLY DONE (HM-DEC-093).
                         An empty waterfall and a waterfall that has never
                         received a byte paint the same picture, and they are
                         completely different facts. Three sessions reported
                         this working while the second was true. -->
                    <Border IsVisible="{Binding HasScopeStages}"
                            Background="{StaticResource HmSlateTintBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,6" Margin="0,0,0,6">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ScopeStages}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <TextBlock Text="{Binding ScopeRejection}"
                                       FontSize="10" TextWrapping="Wrap"
                                       IsVisible="{Binding HasScopeRejection}"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- THE NUMBERS ARE ONE HOVER AWAY (HM-DEC-093). The row
                         above hides while every stage is working, because a
                         line that never changes is a line people stop reading
                         and that is the line that has to be read on the evening
                         a stage goes to zero. Hiding it may not mean losing the
                         counters: they are what proved the scope path was
                         discarding 2,740 parts. -->
                    <ctl:WaterfallControl MinHeight="260"
                        ToolTip.Tip="{Binding ScopeCounts}"
                        ToolTip.ShowDelay="600"
                        Source="{Binding SpectrumSource}"
                        FrequencyHz="{Binding FrequencyHz}"
                        BandLowHz="{Binding SelectedBand.Band.LowHz}"
                        BandHighHz="{Binding SelectedBand.Band.HighHz}"
                        Gain="{Binding WaterfallGain}"
                        TuneCommand="{Binding TuneToCommand}" />

                    <!-- WHAT IS MISSING, RATHER THAN AN EMPTY
                         WATERFALL (HM-DEC-062). The scope stream
                         needs two settings on the radio and two more
                         on its CI-V screens, and none of them is a
                         command Hamlet can send. -->
                    <Border Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,7"
                            IsVisible="{Binding ScopeNote,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}">
                        <ctl:GlossaryTextControl
                            Text="{Binding ScopeNote}"
                            FontSize="12" LineSpacing="1.4"
                            Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>

                    <TextBlock Text="click a signal to tune to it. the axis matches the map and the dial tape above"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Calling CQ on a cycle, into a dummy load (HM-DEC-098, §0.2) -->
        <DataTemplate x:Key="widget.autocall" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Green"
                                  Title="Call CQ on a cycle"
                                  Summary="{Binding AutoCall.Summary}"
                                  IsExpanded="{Binding AutoCallExpanded, Mode=TwoWay}">
                <StackPanel Spacing="8">

                    <ctl:GlossaryTextControl
                        Text="Calling CQ over and over is most of what finding a contact is, and it is the part that wears you out before anybody answers. Hamlet will do the calling and listen between rounds, and it stops the moment it hears somebody. It sends into a dummy load while this is being proved, which is not caution for its own sake: an automatic transmitter that goes wrong goes wrong on a frequency somebody else is using."
                        FontSize="12" LineSpacing="1.45"
                        Foreground="{StaticResource HmTextMutedBrush}" />

                    <!-- THE MESSAGE IS HIS AND HAMLET NEVER WRITES ONE. There is
                         no default and no suggestion here: a plausible CQ Hamlet
                         composed is somebody else's callsign on the air. -->
                    <TextBlock Text="What to send" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource HmTextMutedBrush}" />

                    <TextBox Text="{Binding AutoCall.Message, Mode=TwoWay}"
                             Watermark="CQ CQ DE YOURCALL YOURCALL K"
                             AcceptsReturn="False" MaxLength="60"
                             IsEnabled="{Binding !AutoCall.IsCalling}"
                             FontFamily="Consolas,Menlo,monospace" FontSize="13" />

                    <!-- REFUSED WHERE HE CAN SEE IT AND CHANGE IT, never
                         discovered on the air as a message that went out cut
                         short (§0.0). -->
                    <Border IsVisible="{Binding AutoCall.HasMessageRefusal}"
                            Padding="9,6" CornerRadius="6"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding AutoCall.MessageRefusal}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>

                    <!-- WHAT CONSENT IS GIVEN AGAINST (phase 4). Arming is a
                         separate act from starting, and these are the facts it is
                         an act against: what goes out, where, how often, at what
                         power, and whether keying would reach the air at all.
                         Consent given by pressing a button whose state the
                         operator is inferring is not consent. -->
                    <Border Padding="10,8" CornerRadius="6"
                            Background="{StaticResource HmSlateTintBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding AutoCall.WillSendLine}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <TextBlock Text="{Binding AutoCall.RoundsLine}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Text="{Binding AutoCall.BreakInLine}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Text="{Binding AutoCall.PowerLine}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Text="{Binding AutoCall.ReadyLine}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- ARM, THEN START. Two acts, and the second is not offered
                         until the first has happened. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="hm-send"
                                Content="Arm"
                                IsVisible="{Binding !AutoCall.IsArmed}"
                                IsEnabled="{Binding AutoCall.CanArm}"
                                Command="{Binding AutoCall.ArmCommand}" />

                        <Button Classes="hm-send"
                                Content="Start calling"
                                FontWeight="Bold"
                                IsVisible="{Binding AutoCall.CanStart}"
                                Command="{Binding AutoCall.StartCommand}" />

                        <Button Content="Disarm"
                                IsVisible="{Binding AutoCall.CanStart}"
                                Command="{Binding AutoCall.DisarmCommand}" />

                        <Button Classes="hm-send"
                                Content="STOP TRANSMITTING"
                                FontWeight="Bold"
                                IsVisible="{Binding AutoCall.IsCalling}"
                                Command="{Binding AutoCall.StopCommand}" />
                    </StackPanel>

                    <!-- A REFUSAL ALWAYS PRINTS ITS REASON (HM-DEC-080). -->
                    <Border IsVisible="{Binding AutoCall.Refusal, Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                            Padding="9,6" CornerRadius="6"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding AutoCall.Refusal}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>

                    <TextBlock Text="{Binding AutoCall.OutcomeLine}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource HmTextMutedBrush}" />

                    <!-- THE AUDIT TRAIL. What the operator's callsign put on the
                         air, with where and when, which is the least a feature
                         that transmits unattended owes him. -->
                    <TextBlock Text="What went out" FontSize="11" FontWeight="SemiBold"
                               IsVisible="{Binding AutoCall.HasSent}"
                               Foreground="{StaticResource HmTextMutedBrush}" />

                    <ItemsControl ItemsSource="{Binding AutoCall.Sent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutoCallRow">
                                <TextBlock Text="{Binding Line}"
                                           FontFamily="Consolas,Menlo,monospace"
                                           FontSize="11" TextWrapping="Wrap"
                                           Margin="0,0,0,2"
                                           Foreground="{StaticResource HmTextMutedBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- The scanner (HM-DEC-107) -->
        <DataTemplate x:Key="widget.scan" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Blue"
                                  Title="Scanner"
                                  Summary="{Binding Scan.Summary}"
                                  IsExpanded="{Binding ScanExpanded, Mode=TwoWay}">
                <StackPanel Spacing="8">

                    <ctl:GlossaryTextControl
                        Text="The waterfall watches a stretch of band about a thousand times wider than you can hear at once, so it can say which parts of it are busy. It cannot tell Morse from anything else, and that is what the scanner is for: it points the radio at each busy patch in turn and lets the decoder decide whether there is really somebody there."
                        FontSize="12" LineSpacing="1.45"
                        Foreground="{StaticResource HmTextMutedBrush}" />

                    <!-- THE START AND THE STOP SIT TOGETHER, and the stop is
                         also in the pinned strip above, where it cannot be
                         scrolled away from or closed (§0.2.1). -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="hm-send"
                                Content="Scan the band"
                                IsVisible="{Binding !Scan.IsScanning}"
                                IsEnabled="{Binding Scan.CanStart}"
                                Command="{Binding Scan.StartCommand}" />

                        <Button Classes="hm-send"
                                Content="Stop the scan"
                                IsVisible="{Binding Scan.IsScanning}"
                                Command="{Binding Scan.StopCommand}" />
                    </StackPanel>

                    <!-- A REFUSAL ALWAYS PRINTS ITS REASON (HM-DEC-080), and a
                         scan file that could not be read is refused loudly
                         rather than quietly replaced with Hamlet's own list
                         (§0.2.1). -->
                    <Border IsVisible="{Binding Scan.Refusal,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                            Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <TextBlock Text="{Binding Scan.Refusal}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>

                    <TextBlock Text="{Binding Scan.OutcomeLine}"
                               IsVisible="{Binding Scan.OutcomeLine,
                                   Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <!-- WHAT THE WATERFALL PROPOSED, named as proposals because
                         nothing here is a claim that anybody is on any of them
                         (§0.0). -->
                    <TextBlock Text="places worth a look"
                               IsVisible="{Binding Scan.HasCandidates}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource HmTextMutedBrush}" />

                    <ItemsControl ItemsSource="{Binding Scan.Candidates}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanCandidateRow">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,4">
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontFamily="Consolas,Menlo,monospace"
                                               FontSize="12" Margin="0,0,10,0"
                                               VerticalAlignment="Top"
                                               Foreground="{StaticResource HmTextPrimaryBrush}" />

                                    <TextBlock Grid.Column="1" Text="{Binding Why}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- EVERYWHERE IT LISTENED, INCLUDING WHERE IT FOUND NOBODY.
                         A scan whose record holds only its stops cannot be told
                         from one that never ran, and the places it passed over
                         are half of what it measured (§0.5, §0.0.1). -->
                    <TextBlock Text="what it heard"
                               IsVisible="{Binding Scan.HasDwells}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource HmTextMutedBrush}" />

                    <ItemsControl ItemsSource="{Binding Scan.Dwells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanDwellRow">
                                <Border Margin="0,0,0,5" Padding="9,6" CornerRadius="6"
                                        Background="{StaticResource HmSlateTintBrush}"
                                        BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Label}"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       FontSize="12"
                                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                                            <!-- HOW SURE, CARRIED FROM THE
                                                 ENGINE VERDICT AND NEVER
                                                 RE-DERIVED. A call assembled
                                                 from dim letters may not be
                                                 drawn like a solid one (§0.0,
                                                 HM-DEC-108), and this is a row
                                                 the operator acts on, so the
                                                 colour follows the words rather
                                                 than staying green whatever
                                                 they say. Amber is the default
                                                 and green is earned. -->
                                            <Border Grid.Column="2"
                                                    Classes.solid="{Binding IsSolid}"
                                                    IsVisible="{Binding HasSureness}"
                                                    CornerRadius="4" Padding="6,1"
                                                    Background="{StaticResource HmAmberTintBrush}"
                                                    BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                                    BorderThickness="1">
                                                <Border.Styles>
                                                    <Style Selector="Border.solid">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource HmGreenTintBrush}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource HmGreenEdgeBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.solid > TextBlock">
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource HmGreenBrush}" />
                                                    </Style>
                                                </Border.Styles>
                                                <TextBlock Text="{Binding SurenessText}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource HmAmberBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Sentence}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />

                                        <!-- THE PAYOFF ON A SCAN (§0.2.1). A
                                             list of stations is a report and
                                             this is a destination. It stops the
                                             scan on the way, because a dial
                                             still hunting while he reads is
                                             §0.2.1's own practical test
                                             failing. -->
                                        <Button Content="{Binding TuneLabel}"
                                                HorizontalAlignment="Left"
                                                FontSize="11" Padding="8,3" Margin="0,3,0,0"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Scan.TuneToDwellCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- CW terminal -->
        <DataTemplate x:Key="widget.terminal" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Green"
                                  Title="CW terminal"
                                  Summary="{Binding TerminalSummary}"
                                  IsExpanded="{Binding TerminalExpanded, Mode=TwoWay}">

                <!-- Worded, not an icon. "Clear" is what it does and
                     a broom would need explaining. It sits beside
                     the header button rather than in it, so it
                     cannot collapse the panel on its way past. -->
                <ctl:CollapsiblePanel.HeaderAction>
                    <Button Content="Clear"
                            FontSize="11" Padding="10,2"
                            Command="{Binding ClearTerminalCommand}"
                            ToolTip.Tip="Wipes what is on screen. The decoder keeps listening, and keeps the speed and the noise floor it has worked out."
                            ToolTip.ShowDelay="300" />
                </ctl:CollapsiblePanel.HeaderAction>

                <StackPanel Spacing="6">

                    <!-- The header carries the sending speed live,
                         because an operator deciding whether they
                         can copy somebody needs the number more
                         than anything else on this panel. -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                                   Text="what the radio is hearing, as it arrives"
                                   FontSize="12" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource HmTextMutedBrush}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Spacing="6">
                            <!-- THE RECEIVER'S FRONT END, WHERE HE IS ALREADY
                                 LOOKING WHILE TUNING (HM-DEC-091). On 20 metres
                                 in daylight at S9 with nothing readable, the
                                 radio was reporting its front end overloading
                                 with the preamp on, Hamlet was reading it every
                                 quarter of a second, and he found out from a text
                                 file the next day.

                                 Always present, so it appearing cannot move
                                 anything, and it says "unknown" rather than
                                 going blank when a read has never been answered.
                                 The tint carries the same meaning the words do
                                 and never carries it alone (0.6). -->
                            <Border BorderThickness="1" CornerRadius="6"
                                    Padding="8,2"
                                    ToolTip.Tip="What the radio's own front end is set to. The preamp makes weak signals louder and a strong band can overload it, at which point everything in the passband is squashed together and nothing decodes."
                                    Background="{StaticResource HmSlateTintBrush}"
                                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                    IsVisible="{Binding !FrontEndIsOverloading}">
                                <TextBlock Text="{Binding FrontEndText}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />
                            </Border>

                            <Border BorderThickness="1" CornerRadius="6"
                                    Padding="8,2"
                                    ToolTip.Tip="The radio says its front end is overloading. Nothing will decode until that stops, and the message under the transcript says which button to press."
                                    Background="{StaticResource HmAmberTintBrush}"
                                    BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                    IsVisible="{Binding FrontEndIsOverloading}">
                                <TextBlock Text="{Binding FrontEndText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource HmAmberDeepBrush}" />
                            </Border>

                            <!-- The filter width, because it is the
                                 number that explains a bad decode:
                                 a passband wide open at 3 kHz puts
                                 several signals into the decoder at
                                 once (HM-DEC-050). -->
                            <Border Background="{StaticResource HmBlueTintBrush}"
                                    BorderBrush="{StaticResource HmBlueEdgeBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="8,2"
                                    ToolTip.Tip="How wide the radio's filter is right now. Everything inside it reaches the decoder together."
                                    IsVisible="{Binding HasFilterBandwidth}">
                                <TextBlock Text="{Binding FilterBandwidthText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource HmBlueBrush}" />
                            </Border>

                            <Border Background="{StaticResource HmGreenTintBrush}"
                                    BorderBrush="{StaticResource HmGreenEdgeBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="8,2"
                                    IsVisible="{Binding HasDetectedSpeed}">
                                <TextBlock Text="{Binding TerminalSpeedText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource HmGreenBrush}" />
                            </Border>

                            <!-- THE BLANK SPEED SAYS WHY IT IS BLANK
                                 (HM-OPEN-022). No speed is named until a clock
                                 has been proved, because a number between two
                                 stations describes neither, so the field goes
                                 quiet across a handover. A bare gap reads as
                                 something broken; this is what makes it read as
                                 Hamlet working. -->
                            <Border Background="{StaticResource HmSlateTintBrush}"
                                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                    BorderThickness="1" CornerRadius="6"
                                    Padding="8,2"
                                    IsVisible="{Binding SpeedIsReacquiring}">
                                <TextBlock Text="{Binding SpeedReacquiringText}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{StaticResource HmTextMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- WHAT THE DECODER IS ACTUALLY BEING FED (HM-DEC-088).

                         The operator hears the speaker and the decoder hears the
                         USB codec, and those are two paths with two gains.
                         Turning the volume up to hear a faint signal better does
                         nothing at all for the decoder, and until now nothing on
                         screen said so. If this bar is on the floor while a
                         signal is plainly audible, that is the whole diagnosis
                         and it takes one glance. -->
                    <!-- THE SENTENCE SITS UNDER THE BAR RATHER THAN BESIDE IT,
                         and that is the fix rather than a preference. It was in
                         a third column sized to its own content, so "audio has
                         stopped arriving" made the row wider than the widget and
                         the widget clipped it. Half a sentence the operator
                         cannot tell is half a sentence is §0.0 broken by the
                         layout: this is the line that says the decoder is
                         hearing nothing, and it is the one that was cut.

                         On its own row it wraps to whatever width there is and
                         can never be cut, at whatever size the widget is dragged
                         to. -->
                    <StackPanel Margin="0,2,0,0" Spacing="2"
                                IsVisible="{Binding IsDecoding}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="input"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1"
                                         Height="6" VerticalAlignment="Center"
                                         Value="{Binding InputLevelFraction}"
                                         Foreground="{StaticResource HmGreenBrush}" />
                        </Grid>

                        <!-- RESERVED SPACE, NOT A ROW THAT APPEARS (HM-DEC-080).
                             This sits above the transcript, so it appearing
                             pushed the thing he is reading down the screen. -->
                        <TextBlock Text="{Binding InputLevelText}"
                                   FontSize="11" Height="15"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource HmTextMutedBrush}" />
                    </StackPanel>

                    <Border CornerRadius="8" ClipToBounds="True"
                            BorderThickness="1"
                            Background="{x:Static ctl:InstrumentPalette.SurfaceBrush}"
                            BorderBrush="{x:Static ctl:InstrumentPalette.EdgeBrush}">
                        <ScrollViewer MaxHeight="260" MinHeight="150"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- ONE LINE, WITH THE LEADING EDGE ON THE END OF IT
                                 (HM-DEC-096). Hamlet reads the same audio twice
                                 and the reader has to be able to tell which one
                                 is speaking: the settled text is what a
                                 transcript keeps, and the italic tail is what
                                 the streaming pass read before anything
                                 confirmed it. It is replaced as the second pass
                                 overtakes it. -->
                            <ctl:CwTerminalControl
                                FontSize="14" LineHeight="22"
                                Transcript="{Binding Transcript}"
                                Tip="{Binding TipText}"
                                IdleText="{Binding TerminalIdleText}" />
                        </ScrollViewer>
                    </Border>

                    <!-- ONE ADVISORY REGION, AND IT NEVER CHANGES HEIGHT.
                         Below the transcript sat a stack of boxes that each
                         appeared and vanished on their own, and every one of
                         them reflowed everything around it. He watches this
                         screen for half an hour at a time while tuning across a
                         band, and the thing he is reading moved under him.

                         The messages are alternatives rather than a list:
                         several of them were saying versions of the same thing
                         at the same moment, that nothing is being read. Nothing
                         was removed. What changed is that the most useful one is
                         shown and the region holds its space whether or not it
                         has anything to say.

                         The order is in MainWindowViewModel.Advisories, and a
                         message is added there rather than as another panel
                         here. -->
                    <Border Height="72" Margin="0,2,0,0"
                            CornerRadius="6" BorderThickness="1"
                            Background="{StaticResource HmSlateTintBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            Padding="10,7">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ctl:GlossaryTextControl Text="{Binding AdvisoryNote}"
                                                     FontSize="12" LineSpacing="1.4"
                                                     Foreground="{StaticResource HmTextPrimaryBrush}" />
                        </ScrollViewer>
                    </Border>

                    <!-- **PUT BACK AFTER BEING DELETED BY ACCIDENT.** The
                         commit that removed the old decoder cut from the
                         revisions row to here in one go, and the two blocks
                         below went with it: the keying meter and the press that
                         marks a case. Nothing failed, because a binding that
                         resolves and an element that is not there look the same
                         to every test this repository had. `TheCapturePressIsOnTheScreenTests`
                         is the one that would have caught it. -->
                    <!-- CAN HAMLET HEAR KEYING AT ALL (HM-DEC-091). The
                         operator hears stations Hamlet does not and finds out
                         the next morning from a roster. This says so while he is
                         sitting at the radio, so he can turn the gain, change
                         the filter or retune and watch the numbers answer. It
                         shares nothing with the decoder, which is the point: an
                         indicator that agreed with the decoder by construction
                         could never contradict it, and contradicting it is the
                         job.

                         THE WORD CARRIES THE MEANING AND THE COLOR ONLY AGREES
                         WITH IT (0.6), and the numbers are what he will actually
                         use, because a figure that moves when he turns something
                         is worth more than a word that changes. -->
                    <!-- HOLD THE PITCH WHERE THE STATION IS. The tone tracker
                         is measurably the largest source of soup in this
                         decoder: a clean generated station through the whole
                         path produced twenty-two characters that were never
                         sent, and the same window with the pitch nailed produced
                         none. This is the operator's way to take it out of the
                         path.

                         The state it produces goes into the advisory area above
                         with everything else, rather than becoming another
                         panel. -->
                    <!-- **"HOLD THIS PITCH" IS GONE FROM THE PANEL** (Tim's
                         ruling of 2026-08-27, in his words: "It shouldn't
                         involve me randomly clicking on a button I don't
                         understand.").

                         It existed because acquisition does not work, which put
                         a decoder problem in the operator's hands and asked him
                         to press a button whose meaning was never explained.
                         Decoding is Hamlet's job. The engine can still hold a
                         pitch and tests still reach it; what has gone is the
                         panel asking him to decide. -->

                    <!-- ONE VOICE. The advisory above and this block used to
                         speak at the same time and disagree: a clear tone
                         present up there and no keying down here, fifty hertz
                         apart, with this block's advice sending the operator to
                         the radio for a decoder problem. Where the advisory has
                         something to say, this waits. -->
                    <Border IsVisible="{Binding ShowKeyingMeter}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,7" Margin="0,2,0,0"
                            Background="{StaticResource HmSlateTintBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding KeyingWord}"
                                           FontSize="12" FontWeight="SemiBold"
                                           IsVisible="{Binding KeyingIsPresent}"
                                           Foreground="{StaticResource HmGreenBrush}" />
                                <TextBlock Text="{Binding KeyingWord}"
                                           FontSize="12" FontWeight="SemiBold"
                                           IsVisible="{Binding KeyingIsAbsent}"
                                           Foreground="{StaticResource HmAmberDeepBrush}" />
                                <TextBlock Text="{Binding KeyingWord}"
                                           FontSize="12" FontWeight="SemiBold"
                                           IsVisible="{Binding KeyingIsUndecided}"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <TextBlock Text="{Binding KeyingDetail}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource HmTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="the last few seconds went quiet, so this is the last thing it was sure of rather than what it is hearing now"
                                       FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding KeyingIsHeld}"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <!-- **IT RETIRES WHERE THE DECODER HAS A TONE.**
                                 This paragraph and the line above the transcript
                                 used to speak at once and disagree: a clear tone
                                 up there, no keying down here fifty hertz away,
                                 and this telling him the signal was being lost
                                 between the antenna and Hamlet. He went and
                                 checked the radio and nothing was wrong with it.
                                 Where something has found a tone, the sweep
                                 disagreeing is a fault in the sweep. -->
                            <TextBlock Text="This listens for keying on its own, without asking the decoder anything, so it can tell you a station is there even when nothing appears above. If you can hear one and this says there is nothing, the signal is being lost somewhere between the antenna and Hamlet, and the gain, the filter and the tuning are the things to try."
                                       FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding KeyingAdviceIsUseful}"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- KEEP WHAT IT HEARD (HM-DEC-088). Everything about the
                         faint-signal problem is a hypothesis until one of these
                         exists: a wrong decode with its input attached is a
                         regression test, and without one it is an argument that
                         runs for three sessions. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0"
                                   Text="Press this whenever you can hear a station, whether or not anything appeared here. It keeps the last half minute and puts the station on tonight's list, and the list is the only place the ones Hamlet missed are counted at all."
                                   FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <!-- **THE PRESS ASSERTS SOMETHING HAMLET CANNOT KNOW.**
                             Every other number it holds is downstream of its own
                             decoder, so a station it misses is a case it never
                             counts. The operator's ear is the denominator, which
                             is why the label says what he heard rather than what
                             the button writes. -->
                        <Button Grid.Column="1" Content="I hear a station"
                                FontSize="11" Padding="10,4"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding IsDecoding}"
                                ToolTip.Tip="Says you heard CW here, whether or not Hamlet read any of it. It keeps the last half minute of audio and adds a row to tonight's list, and you mark afterwards which ones it actually read."
                                Command="{Binding CaptureAudioCommand}" />
                    </Grid>

                    <!-- THE OFFER WHERE THE PROBLEM SHOWS (HM-DEC-084). A
                         popup somebody has to know to open is one they will not
                         open when they are frustrated, which is exactly when it
                         is needed. The row is always here and its contents
                         change, so the offer arriving does not move the screen.
                         The note itself is in the advisory region above. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" Height="26">
                        <ctl:GlossaryTextControl Grid.Column="0"
                            Text="{Binding ReceiveOffer}"
                            FontSize="11" LineSpacing="1.4"
                            Margin="0,0,8,0"
                            Foreground="{StaticResource HmBlueBrush}" />
                        <Button Grid.Column="1" Content="Have a look"
                                FontSize="11" Padding="8,3" Margin="0,0,6,0"
                                IsVisible="{Binding HasReceiveOffer}"
                                Command="{Binding OpenReceiveHelpCommand}" />
                        <Button Grid.Column="2" Content="No thanks"
                                FontSize="11" Padding="8,3"
                                IsVisible="{Binding HasReceiveOffer}"
                                Command="{Binding DismissReceiveOfferCommand}" />
                    </Grid>

                    <TextBlock Text="a dimmed character is one Hamlet is not sure of, and a block is something it heard and could not read. You can select any of this and copy it."
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Send -->
        <DataTemplate x:Key="widget.send" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Amber"
                                  Title="Send"
                                  Summary="{Binding Transmit.Summary}"
                                  IsExpanded="{Binding TransmitExpanded, Mode=TwoWay}">
                <StackPanel Spacing="8" DataContext="{Binding Transmit}">

                    <!-- WHAT THE RADIO IS ACTUALLY SET TO
                         (HM-DEC-074). The dummy load warning is
                         retired: it said to key into one because
                         the code had never run, and it has now. In
                         its place, what Hamlet can honestly say
                         about the socket and the power, as
                         consequences and never instructions. -->
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{StaticResource HmAmberTintBrush}"
                                        BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="10,7">
                                    <TextBlock Text="{Binding}"
                                               FontSize="12" TextWrapping="Wrap"
                                               LineHeight="18"
                                               Foreground="{StaticResource HmAmberDeepBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- RESERVED SPACE, NEVER APPEARING SPACE
                         (HM-DEC-080). This block is always here and
                         only its content and its color change. It
                         used to come and go as the transmit line
                         toggled, and every appearance reflowed
                         everything below it, so the panel jumped
                         several times a second at exactly the moment
                         the operator was watching it hardest.

                         The abort lives inside it for the same
                         reason: a control that appears beside the
                         thing it stops would move the thing it
                         stops. -->
                    <Border BorderThickness="1" CornerRadius="6"
                            Padding="10,7" MinHeight="54"
                            Background="{Binding StatusBackground}"
                            BorderBrush="{Binding StatusEdge}">
                        <Grid ColumnDefinitions="*,Auto"
                              VerticalAlignment="Center">
                            <StackPanel Spacing="2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                <ctl:GlossaryTextControl
                                    Text="{Binding Status}"
                                    FontSize="12" LineSpacing="1.4"
                                    Foreground="{StaticResource HmTextPrimaryBrush}" />
                                <TextBlock Text="{Binding Citation}" FontSize="10"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <!-- WHILE IT IS GOING OUT, THE PANEL
                                     DOES SOMETHING RATHER THAN
                                     PREVENTING SOMETHING
                                     (HM-DEC-085). The operator
                                     pressed the button and Hamlet
                                     started the send, so Hamlet
                                     knows exactly what is happening
                                     and can say how much is left
                                     rather than reporting that the
                                     radio is busy.

                                     Inside the block that is always
                                     there, so nothing below reflows
                                     when it appears. -->
                                <TextBlock Text="{Binding SendingLine}"
                                           FontSize="11" TextWrapping="Wrap"
                                           IsVisible="{Binding IsSending}"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <ProgressBar Minimum="0" Maximum="1"
                                             Value="{Binding SendingProgress}"
                                             IsVisible="{Binding IsSending}"
                                             Height="4" Margin="0,4,0,0"
                                             Foreground="{StaticResource HmGreenBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="Stop sending"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsSending}"
                                    Command="{Binding AbortCommand}"
                                    Background="{StaticResource HmAmberDeepBrush}"
                                    Foreground="White" Padding="16,6" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding StageName}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource HmAmberBrush}" />

                        <!-- OFF BY DEFAULT NOW (HM-DEC-079). The
                             confirming press guards text the
                             operator wrote, not text Hamlet wrote,
                             so it fires where it is worth firing
                             and nowhere else. This is for somebody
                             who wants it on everything. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="confirm every send" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                            <ToggleSwitch IsChecked="{Binding AlwaysConfirm}" />
                        </StackPanel>
                    </Grid>

                    <!-- An unresolved license class warns and
                         labels, and never blocks (HM-DEC-065,
                         confirming HM-DEC-029). Said once, beside
                         the buttons, where it is read before the
                         press. -->
                    <Border Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,7"
                            IsVisible="{Binding LicenseUnresolved}">
                        <ctl:GlossaryTextControl
                            Text="{x:Static vm:CwTransmitViewModel.UnresolvedLicenseNote}"
                            FontSize="12" LineSpacing="1.4"
                            Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>

                    <!-- The buttons follow the precondition
                         (HM-DEC-074). A control that cannot reach
                         the air says why rather than inviting a
                         press that produces a correct frame, a
                         correct acknowledgement and silence. -->
                    <!-- THREE STATES, THREE APPEARANCES, AND ONLY
                         ONE OF THEM IS GREY (HM-DEC-079). Grey means
                         refused and nothing else, because grey means
                         "you cannot press this" in every interface
                         anybody has ever used, and spending it on
                         three different things left it meaning
                         nothing. Armed is amber and pressable.
                         Sending is green and working. Both do
                         something, so neither is dimmed. -->
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SendButtonViewModel">
                                <Border BorderThickness="1" CornerRadius="8"
                                        Padding="10,8" Margin="0,0,0,6"
                                        Background="White"
                                        BorderBrush="{Binding EdgeBrush}"
                                        Opacity="{Binding Dimmed}"
                                        IsEnabled="{Binding !LooksRefused}">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1"
                                                        Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Meaning}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StateNote}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding StateNote,
                                                               Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                                                           Foreground="{Binding EdgeBrush}" />

                                                <!-- **BEFORE HE PRESSES, NOT
                                                     AFTER** (HM-DEC-130). A real
                                                     exchange carries two calls, a
                                                     report and a name, so a reply
                                                     that needs two keyer sends is
                                                     ordinary. Nothing said so
                                                     until the send went out, and
                                                     the gap in the middle has
                                                     never been measured. Silent
                                                     while it fits. -->
                                                <TextBlock Text="{Binding LengthNote}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding WillSplit}"
                                                           Foreground="{StaticResource HmAmberBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="hm-send"
                                                    Classes.ready="{Binding LooksReady}"
                                                    Classes.armed="{Binding LooksArmed}"
                                                    Classes.refused="{Binding LooksRefused}"
                                                    Content="{Binding ButtonLabel}"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding $parent[ItemsControl].((vm:CwTransmitViewModel)DataContext).PressCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <!-- EDITABLE, WHICH IS WHAT
                                             THE GUARD IS FOR. Change
                                             it and the next press
                                             arms rather than sends. -->
                                        <Border CornerRadius="6" Padding="2"
                                                Background="{x:Static ctl:InstrumentPalette.SurfaceBrush}">
                                            <TextBox Text="{Binding Message, Mode=TwoWay}"
                                                     FontFamily="Consolas,Menlo,monospace"
                                                     FontSize="12" TextWrapping="Wrap"
                                                     AcceptsReturn="False"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{x:Static ctl:InstrumentPalette.ConfidentBrush}" />
                                        </Border>

                                        <!-- ARMED SAYS SO, AND SAYS
                                             HOW TO GET BACK OUT.
                                             There used to be no way
                                             out of an armed message
                                             except pressing the very
                                             thing you were unsure
                                             about. -->
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              IsVisible="{Binding IsArmed}">
                                            <TextBlock Grid.Column="0"
                                                       Text="Read it over. The next press sends it exactly as it stands."
                                                       FontSize="11" TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Foreground="{StaticResource HmAmberDeepBrush}" />
                                            <Button Grid.Column="1" Content="Put it back"
                                                    FontSize="11" Padding="8,3"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:CwTransmitViewModel)DataContext).RevertCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="Cancel"
                                                    FontSize="11" Padding="8,3"
                                                    Command="{Binding $parent[ItemsControl].((vm:CwTransmitViewModel)DataContext).DisarmCommand}" />
                                        </Grid>

                                        <TextBlock Text="{Binding Note}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!-- WHAT ACTUALLY HAPPENED, LINK BY LINK
                         (HM-DEC-082). The question this application
                         exists to answer: speaking into the void and
                         speaking on the air with nobody listening are
                         different facts, and until now both came out
                         as silence. Every number here was measured or
                         it is not here. -->
                    <Border Background="{StaticResource HmGreenTintBrush}"
                            BorderBrush="{StaticResource HmGreenEdgeBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,9"
                            IsVisible="{Binding ChainNote,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}">
                        <ctl:GlossaryTextControl Text="{Binding ChainNote}"
                            FontSize="13" LineSpacing="1.45"
                            Foreground="{StaticResource HmTextPrimaryBrush}" />
                    </Border>

                    <!-- WHAT THE METER SAID DURING THE SEND
                         (HM-DEC-081). Only after one, only when
                         something was measured, and it never says
                         what is connected. -->
                    <Border Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1" CornerRadius="6"
                            Padding="10,7"
                            IsVisible="{Binding SwrNote,
                                Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}">
                        <ctl:GlossaryTextControl Text="{Binding SwrNote}"
                            FontSize="12" LineSpacing="1.4"
                            Foreground="{StaticResource HmAmberDeepBrush}" />
                    </Border>


                    <TextBlock Text="{Binding SpeedOffer}" FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SpeedOffer,
                                   Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                               Foreground="{StaticResource HmTextMutedBrush}" />

                    <!-- AN EXPLICIT KNOWN-UNKNOWN, not a control
                         that silently does nothing. -->
                    <TextBlock Text="{Binding SpacingNote}" FontSize="11"
                               TextWrapping="Wrap" LineHeight="17"
                               IsVisible="{Binding SpacingNote,
                                   Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                               Foreground="{StaticResource HmTextMutedBrush}" />
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Phrasebook -->
        <DataTemplate x:Key="widget.phrasebook" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Green"
                                  Title="Phrasebook"
                                  Summary="{Binding Phrasebook.Summary}"
                                  IsExpanded="{Binding PhrasebookExpanded, Mode=TwoWay}">
                <ItemsControl ItemsSource="{Binding Phrasebook.Columns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PhraseColumn">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Heading}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource HmGreenBrush}" />

                                <!-- The column somebody needs and
                                     would never ask for, doing the
                                     emotional work the definitions
                                     cannot (HM-DEC-041). -->
                                <ctl:GlossaryTextControl Text="{Binding Note}"
                                    FontSize="11" LineSpacing="1.4"
                                    IsVisible="{Binding Note,
                                        Converter={x:Static ctl:PrivilegeToneConverter.NotEmpty}}"
                                    Foreground="{StaticResource HmTextMutedBrush}" />

                                <ItemsControl ItemsSource="{Binding Phrases}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="cw:CwPhrase">
                                            <Grid ColumnDefinitions="90,*" Margin="0,2">
                                                <TextBlock
                                                           Text="{Binding Sent}"
                                                           FontFamily="Consolas,Menlo,monospace"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource HmAmberDeepBrush}" />
                                                <StackPanel Grid.Column="1" Spacing="0">
                                                    <TextBlock Text="{Binding Meaning}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding When}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- I can hear it and Hamlet can't -->
        <DataTemplate x:Key="widget.receiveHelp" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Blue"
                                  Title="I can hear it and Hamlet can't"
                                  Summary="{Binding ReceiveHelp.ActionLabel}"
                                  IsExpanded="{Binding ReceiveHelpExpanded, Mode=TwoWay}">
                <StackPanel Spacing="8">
                    <ctl:GlossaryTextControl Text="{Binding ReceiveHeadline}"
                                             FontSize="12" LineSpacing="1.45"
                                             Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <!-- ROWS ALREADY CORRECT STAY VISIBLE AND SAY
                         SO. Hiding them is tidier and teaches
                         nothing; showing them is the app proving
                         what it checked. -->
                    <ItemsControl ItemsSource="{Binding ReceiveHelp.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AdviceRowViewModel">
                                <Grid ColumnDefinitions="18,*,Auto">
                                    <TextBlock Text="{Binding Mark}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Top"
                                               Foreground="{StaticResource HmBlueBrush}" />
                                    <ctl:GlossaryTextControl Grid.Column="1"
                                        Text="{Binding Says}"
                                        FontSize="12" LineSpacing="1.4"
                                        Margin="0,0,8,0"
                                        Foreground="{StaticResource HmTextPrimaryBrush}" />
                                    <Button Grid.Column="2" Content="Just this one"
                                            FontSize="11" Padding="8,3"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding WouldChange}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReceiveHelp.ApplyOneCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ONE PRESS, NOT FOUR CONFIRMATIONS. None of
                         these can put anything on the air, and
                         asking permission four times trains
                         somebody to click through prompts. -->
                    <Button Classes="hm-send ready"
                            Content="{Binding ReceiveHelp.ActionLabel}"
                            HorizontalAlignment="Left"
                            Command="{Binding ReceiveHelp.FixAllCommand}" />

                    <!-- AFTER ANY CHANGE, THE FOOTER IS THE RECORD:
                         what changed, from what, to what, with
                         put-it-back beside it. -->
                    <StackPanel Spacing="4"
                                IsVisible="{Binding ReceiveHelp.HasChanges}">
                        <TextBlock Text="What Hamlet changed"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource HmBlueBrush}" />

                        <ItemsControl ItemsSource="{Binding ReceiveHelp.Changes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rig:SettingChange">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Says}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,0,8,0"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                        <Button Grid.Column="1" Content="Put it back"
                                                FontSize="11" Padding="8,3"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding CanUndo}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ReceiveHelp.UndoCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="Put all of it back"
                                FontSize="11" Padding="8,3"
                                HorizontalAlignment="Left"
                                Command="{Binding ReceiveHelp.UndoAllCommand}" />
                    </StackPanel>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Did anybody hear me -->
        <DataTemplate x:Key="widget.heard" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Green"
                                  Title="Did anybody hear me"
                                  Summary="{Binding HeardSummary}"
                                  IsExpanded="{Binding HeardExpanded, Mode=TwoWay}">
                <StackPanel Spacing="8">
                    <ctl:GlossaryTextControl Text="{Binding HeardDetail}"
                                             FontSize="12" LineSpacing="1.45"
                                             Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <ItemsControl ItemsSource="{Binding HeardReports}"
                                  IsVisible="{Binding HasHeardReports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="explore:HeardReport">
                                <Border Background="{StaticResource HmGreenTintBrush}"
                                        BorderBrush="{StaticResource HmGreenEdgeBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="10,7">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding ReceiverCall}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmGreenBrush}" />
                                        <TextBlock Text="{Binding Signal}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Speed}" FontSize="11"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                        <TextBlock Text="{Binding FrequencyLabel}"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   FontSize="11"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Where to start -->
        <DataTemplate x:Key="widget.lead" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Amber"
                                  Title="Where to start"
                                  Summary="{Binding Lead.Headline}"
                                  IsExpanded="{Binding LeadExpanded, Mode=TwoWay}">
                <StackPanel Spacing="10">

                    <Border Background="{StaticResource HmAmberTintBrush}"
                            BorderBrush="{StaticResource HmAmberEdgeBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Lead.Headline}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />
                            <ctl:GlossaryTextControl Text="{Binding Lead.Body}"
                                                     FontSize="12" LineSpacing="1.4"
                                                     Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <!-- The evidence, never hidden: the
                                 same reason line the ranked card
                                 carries (HM-DEC-009). -->
                            <TextBlock Text="{Binding Lead.Reason}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <Button Content="{Binding Lead.FrequencyLabel,
                                        StringFormat='Tune {0}'}"
                                    FontSize="12"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding Lead.HasSuggestion}"
                                    Command="{Binding TuneToCommand}"
                                    CommandParameter="{Binding Lead.TuneHz}" />
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,10">
                        <StackPanel Spacing="4">
                            <ctl:GlossaryTextControl Text="{Binding Conditions.Claim}"
                                                     FontSize="13" LineSpacing="1.4"
                                                     Foreground="{StaticResource HmTextPrimaryBrush}" />
                            <TextBlock Text="{Binding Conditions.Evidence}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Happening now -->
        <DataTemplate x:Key="widget.spots" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Green"
                                  Title="Happening now"
                                  Summary="{Binding SpotsSummary}"
                                  SummaryBrush="{Binding SpotsFreshness,
                                      Converter={x:Static ctl:FreshnessBrushConverter.Instance}}"
                                  IsExpanded="{Binding SpotsExpanded, Mode=TwoWay}">

                <!-- A bounded viewport rather than a second page
                     scroller. A busy evening puts twenty park
                     activations in here, which used to make the
                     Explorer column so much taller than the one
                     beside it that the waterfall and the terminal
                     sat in a column of empty space. Capping the list
                     keeps the window's own scrollbar meaningful, and
                     this is the same shape the CW terminal's
                     transcript already uses. -->
                <StackPanel Spacing="8">

                <!-- THE TWO QUESTIONS, AT THE HEAD OF THE PANEL AND
                     BOTH ALWAYS VISIBLE (HM-DEC-057). Two words on
                     screen teach more than any inference: a newcomer
                     who reads "what's new" learns that going hunting
                     again after a contact is a normal thing people
                     do, which is a fact about this hobby nobody
                     tells them. Inside the panel rather than in its
                     header because the header already carries the
                     lens name for when it is shut, and two copies
                     of it left no room for either. -->
                <StackPanel Orientation="Horizontal" Spacing="6"
                            ToolTip.Tip="{Binding LensQuestion}"
                            ToolTip.ShowDelay="300">
                    <ToggleButton Classes="hm-lens" Content="Best chance"
                                  IsChecked="{Binding IsBestChance, Mode=OneWay}"
                                  Command="{Binding SelectLensCommand}"
                                  CommandParameter="BestChance" />
                    <ToggleButton Classes="hm-lens" Content="What's new"
                                  IsChecked="{Binding IsWhatsNew, Mode=OneWay}"
                                  Command="{Binding SelectLensCommand}"
                                  CommandParameter="WhatsNew" />
                </StackPanel>

                <!-- THE COUNT SHOWS EVEN WHEN THE FAMILY IS OFF
                     (HM-DEC-061). Somebody who filters to Morse and
                     still sees forty-one voice stations learns the
                     band is full of people they could talk to, which
                     is the fact this whole app exists to reveal. -->
                <ItemsControl ItemsSource="{Binding FamilyChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FamilyChipViewModel">
                            <Button Padding="9,2" FontSize="11" CornerRadius="10"
                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ToggleFamilyCommand}"
                                    CommandParameter="{Binding Name}"
                                    Opacity="{Binding IsOn,
                                        Converter={x:Static ctl:ChipOpacityConverter.Instance}}"
                                    Background="{Binding Family,
                                        Converter={x:Static ctl:ModeFamilyConverter.Fill}}"
                                    Foreground="{Binding Family,
                                        Converter={x:Static ctl:ModeFamilyConverter.Ink}}"
                                    Content="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer MaxHeight="520"
                              VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Spots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpotViewModel">
                            <!-- AGE FADES THE DISPLAY across each
                                 source's ruled lifetime, so the eye
                                 finds what is current without
                                 reading a timestamp (HM-DEC-057).
                                 Never to nothing: a card faded away
                                 is a card removed. -->
                            <Border Background="{Binding Family,
                                        Converter={x:Static ctl:ModeFamilyConverter.Fill}}"
                                    BorderBrush="{StaticResource HmGreenEdgeBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Opacity="{Binding Prominence}"
                                    Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="2" Margin="0,0,8,0">
                                        <!-- The family's own ink, so
                                             the words stay legible
                                             on the family's fill
                                             (HM-DEC-036). -->
                                        <TextBlock Text="{Binding Story}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{Binding Family,
                                                       Converter={x:Static ctl:ModeFamilyConverter.Ink}}" />

                                        <!-- Why this card is where
                                             it is, on its face and
                                             never in a tooltip
                                             (HM-DEC-025). -->
                                        <TextBlock Text="{Binding Reason}" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmGreenBrush}" />

                                        <!-- A Grid rather than a horizontal StackPanel: the
                                             provenance line now carries a whole clause about
                                             whether that person is still there, and a
                                             StackPanel hands its children infinite width, so
                                             wrapping never happened and the sentence ran off
                                             the card (HM-DEC-045). -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <Border Grid.Column="0"
                                                    Background="{StaticResource HmAmberTintBrush}"
                                                    BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="5,0"
                                                    VerticalAlignment="Top"
                                                    IsVisible="{Binding IsNew}">
                                                <TextBlock Text="new" FontSize="10"
                                                           Foreground="{StaticResource HmAmberDeepBrush}" />
                                            </Border>

                                            <!-- Opportunity freshness: how long since the
                                                 spot happened and whether that person is
                                                 likely still there. Feed freshness is a
                                                 different fact and lives in the panel
                                                 header. The exact figure is one hover away. -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Provenance}" FontSize="10"
                                                       TextWrapping="Wrap"
                                                       ToolTip.Tip="{Binding AgeTooltip}"
                                                       ToolTip.ShowDelay="300"
                                                       Foreground="{StaticResource HmTextMutedBrush}" />
                                        </Grid>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding TuneLabel}"
                                            FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TuneToCommand}"
                                            CommandParameter="{Binding FrequencyHz}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Field notes -->
        <DataTemplate x:Key="widget.story" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Amber"
                                  Title="Field notes"
                                  Summary="{Binding StoryTitle}"
                                  IsExpanded="{Binding StoryExpanded, Mode=TwoWay}">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding StoryTitle}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource HmAmberDeepBrush}"
                                   TextWrapping="Wrap" />
                        <Border Grid.Column="1"
                                Background="{StaticResource HmAmberTintBrush}"
                                BorderBrush="{StaticResource HmAmberEdgeBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="6,1">
                            <TextBlock Text="{Binding StoryBadge}" FontSize="11"
                                       Foreground="{StaticResource HmAmberDeepBrush}" />
                        </Border>
                    </Grid>
                    <ctl:GlossaryTextControl Text="{Binding StoryBody}"
                                             FontSize="13" LineSpacing="1.45"
                                             Foreground="{StaticResource HmTextPrimaryBrush}" />
                    <Button Content="Take me there" FontSize="12"
                            Command="{Binding TuneToCommand}"
                            CommandParameter="{Binding StoryTuneHz}" />
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- Field guide -->
        <DataTemplate x:Key="widget.guide" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Blue"
                                  Title="Field guide"
                                  Summary="{Binding GuideSummary}"
                                  IsExpanded="{Binding GuideExpanded, Mode=TwoWay}">
                <ItemsControl ItemsSource="{Binding ModeCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeCardViewModel">
                            <Border Padding="10,8"
                                    Background="White"
                                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                    BorderThickness="1" CornerRadius="8">
                                <StackPanel Spacing="6">

                                    <!-- The animated fingerprint:
                                         the same synthesiser that
                                         draws the waterfall, so
                                         ear and eye learn one
                                         picture (HM-DEC-027). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <ctl:ModeFingerprintControl
                                            Kind="{Binding Mode.Signature}"
                                            VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Spacing="3">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="7">
                                                <TextBlock Text="{Binding Mode.Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />

                                                <!-- The family chip: the same color the
                                                     band map fills this mode's streets
                                                     with, and the same word the map's
                                                     legend uses for it (HM-DEC-032). -->
                                                <Border CornerRadius="3"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Colors.FillBrush}">
                                                    <TextBlock Text="{Binding FamilyLabel}"
                                                               FontSize="10"
                                                               Foreground="{Binding Colors.InkBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Mode.Sound}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource HmTextMutedBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" Content="?"
                                                FontSize="12" Padding="8,3"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="What is this mode, and why bother?"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowModeCommand}"
                                                CommandParameter="{Binding Mode}" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding HasSamples}">
                                        <TextBlock Text="Hear it:" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding Samples}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModeSampleButton">
                                                    <Button Content="{Binding Label}"
                                                            FontSize="11" Padding="9,3"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlaySampleCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ctl:CollapsiblePanel>
        </DataTemplate>

        <!-- What a contact sounds like -->
        <DataTemplate x:Key="widget.contact" x:DataType="vm:MainWindowViewModel">
            <ctl:CollapsiblePanel Family="Amber"
                                  Title="What a contact sounds like"
                                  Summary="{Binding ContactShape.Summary}"
                                  IsExpanded="{Binding ContactExpanded, Mode=TwoWay}">
                <StackPanel Spacing="8" DataContext="{Binding ContactShape}">

                    <ctl:GlossaryTextControl Text="{Binding Preamble}"
                                             FontSize="12" LineSpacing="1.45"
                                             Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <!-- Morse and voice are the same shape with
                         different words, so they are one toggle
                         rather than two panels. Seeing that they
                         are the same shape is most of the lesson. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Show it in" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource HmTextMutedBrush}" />
                        <ToggleSwitch IsChecked="{Binding IsVoice}"
                                      OnContent="Voice" OffContent="Morse" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContactStepViewModel">
                                <Border Padding="10,8"
                                        CornerRadius="8" BorderThickness="1"
                                        Background="{Binding IsYou,
                                            Converter={x:Static ctl:SpeakerBrushConverter.Fill}}"
                                        BorderBrush="{Binding IsYou,
                                            Converter={x:Static ctl:SpeakerBrushConverter.Edge}}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SpeakerLabel}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource HmTextMutedBrush}" />

                                        <!-- Exactly what goes out,
                                             in the monospace the
                                             rig display uses, so
                                             it reads as something
                                             sent rather than as
                                             prose. -->
                                        <SelectableTextBlock Text="{Binding Sent}"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                                        <TextBlock Text="{Binding Meaning}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   FontStyle="Italic"
                                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                                        <ctl:GlossaryTextControl Text="{Binding Note}"
                                                                 IsVisible="{Binding HasNote}"
                                                                 FontSize="11" LineSpacing="1.4"
                                                                 Foreground="{StaticResource HmTextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ctl:GlossaryTextControl Text="{Binding RstExplained}"
                                             FontSize="11" LineSpacing="1.4"
                                             Foreground="{StaticResource HmTextMutedBrush}" />

                    <!-- The part that actually gets somebody on
                         the air. -->
                    <Border Background="{StaticResource HmGreenTintBrush}"
                            BorderBrush="{StaticResource HmGreenEdgeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <ctl:GlossaryTextControl Text="{Binding Closing}"
                                                 FontSize="12" LineSpacing="1.45"
                                                 Foreground="{StaticResource HmTextPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </ctl:CollapsiblePanel>
        </DataTemplate>
    </Window.Resources>


    <!-- THE HEADER AND THE STATUS BAR ARE PINNED AND EVERYTHING ELSE
         SCROLLS (HM-DEC-051). On a 1080p screen there was no way to reach the
         waterfall or the CW terminal and no scrollbar to reach them with, which
         made the two panels that matter most for diagnosing a live signal the
         two nobody could see. Connect and the port picker stay put because they
         are what somebody reaches for when something is wrong, and the status
         line stays put because it is where the app answers them. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Brand, menu, connection, and a line of Shakespeare -->
        <StackPanel Grid.Row="0" Margin="4,0,4,12" Spacing="1">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="Ham" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource HmAmberBrush}" />
                <TextBlock Text="let" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource HmBlueBrush}" />
            </StackPanel>

            <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
                <MenuItem Header="_File">
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </MenuItem>
                <!-- EVERYTHING ABOUT THE RADIO LIVES UNDER RADIO, which is
                     what put the diagnostics window here, and is why the two
                     lists of frequencies are here rather than under Tools.
                     Favorites was ruled in HM-DEC-060 and never actually built
                     into the menu, so the manage window had no way in at all
                     until now. -->
                <MenuItem Header="_Radio">
                    <MenuItem Header="{Binding ConnectButtonText}"
                              Command="{Binding ToggleConnectCommand}" />
                    <Separator />
                    <MenuItem x:Name="FavoriteRows" Header="Favorites"
                              ItemsSource="{Binding FavoriteMenu}"
                              IsEnabled="{Binding HasFavorites}">
                        <MenuItem.Styles>
                            <!-- THE ROWS, NOT THE MENU THEY ARE IN. A bare
                                 MenuItem selector inside MenuItem.Styles also
                                 matches the owner, whose data context is the
                                 main view model, so the cast failed twice on
                                 every open and wrote two binding errors nobody
                                 was reading (HM-DEC-087). -->
                            <Style Selector="#FavoriteRows MenuItem" x:DataType="vm:TuneMenuItem">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding Tune}" />
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                    <MenuItem x:Name="RecentRows" Header="Recent"
                              ItemsSource="{Binding RecentMenu}"
                              IsEnabled="{Binding HasRecent}">
                        <MenuItem.Styles>
                            <!-- THE ROWS, NOT THE MENU THEY ARE IN. A bare
                                 MenuItem selector inside MenuItem.Styles also
                                 matches the owner, whose data context is the
                                 main view model, so the cast failed twice on
                                 every open and wrote two binding errors nobody
                                 was reading (HM-DEC-087). -->
                            <Style Selector="#RecentRows MenuItem" x:DataType="vm:TuneMenuItem">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding Tune}" />
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                    <MenuItem Header="Forget where I have been"
                              Command="{Binding ForgetAllRecentCommand}"
                              IsEnabled="{Binding HasRecent}" />
                    <MenuItem Header="Manage favorites…"
                              Command="{Binding ManageFavoritesCommand}" />
                    <Separator />
                    <MenuItem Header="What the radio is doing…"
                              Command="{Binding OpenRigDiagnosticsCommand}" />
                    <MenuItem Header="What Hamlet decided…"
                              Command="{Binding OpenDecisionLogCommand}" />
                    <Separator />
                    <MenuItem Header="Spectrum scope  (phase 2)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Explore">
                    <MenuItem Header="Refresh spots" Command="{Binding RefreshSpotsCommand}" />
                    <Separator />
                    <MenuItem Header="Live spot feeds  (phase 1.5)" IsEnabled="False" />
                    <MenuItem Header="Find me a CQ I can copy  (phase 2)" IsEnabled="False" />
                </MenuItem>
                <!-- EVERYTHING ABOUT THE RADIO BELONGS UNDER RADIO. What the
                     radio is doing moved out of here, and Tools keeps the
                     things that are about Hamlet rather than about the rig. -->
                <MenuItem Header="_Tools">
                    <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
                    <MenuItem Header="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                    <Separator />
                    <MenuItem Header="Decode log viewer  (later)" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Getting started  (phase 1.5)" IsEnabled="False" />
                    <MenuItem Header="About Hamlet" Command="{Binding OpenAboutCommand}" />
                </MenuItem>
            </Menu>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">

                <!-- THE STOP §0.2.1 REQUIRES, AND IT IS HERE RATHER THAN IN THE
                     SCANNER PANEL FOR ONE REASON: this strip is pinned and
                     outside the canvas, so it cannot be scrolled away from,
                     closed, or dragged off the edge. A stop inside a widget is
                     a stop the operator can lose while the radio goes on being
                     tuned, and a window close button was rejected for the same
                     reason: it is a way to leave the room rather than a way to
                     stop the dial.

                     It appears only while a scan runs, because a control that
                     stops something that is not happening teaches people to
                     stop reading this part of the window. -->
                <Button Classes="hm-send"
                        Content="Stop the scan"
                        IsVisible="{Binding Scan.IsScanning}"
                        Command="{Binding Scan.StopCommand}" />

                <!-- THE STOP §0.2 REQUIRES, IN THE PINNED STRIP BESIDE THE
                     SCANNER'S AND FOR THE SAME REASON: this strip cannot be
                     scrolled away from, closed, or dragged off the edge. A stop
                     for a transmitter that lived in a widget would be a stop the
                     operator can lose while his callsign goes on calling.

                     Escape does the same thing from anywhere, handled in the
                     window itself, because the one keystroke that stops a
                     transmitter has to work whatever has focus. -->
                <Button Classes="hm-send"
                        Content="STOP TRANSMITTING"
                        FontWeight="Bold"
                        IsVisible="{Binding AutoCall.IsCalling}"
                        Command="{Binding AutoCall.StopCommand}" />

                <ComboBox ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort}"
                          IsEnabled="{Binding !IsConnected}"
                          MinWidth="220" VerticalAlignment="Center" />
                <Button Classes="hm-connect"
                        Content="{Binding ConnectButtonText}"
                        Command="{Binding ToggleConnectCommand}" />
            </StackPanel>
        </Grid>

            <!-- One Shakespeare line, bent toward radio, different every
                 launch (HM-DEC-039). The play is on hover so the joke is
                 legible to somebody who does not know the original, without
                 the wordmark turning into a citation. Absent entirely when
                 the file did not load — never a placeholder. -->
            <!-- HAMLET SAYS SO WHEN IT IS MOVING THE DIAL (§0.2.1). The
                 operator must never wonder why his frequency changed, and this
                 sits in the pinned strip rather than in the scanner panel for
                 the same reason the stop does: the panel can be taken off the
                 canvas and the dial still moves. -->
            <!-- HAMLET SAYS SO WHILE IT IS TRANSMITTING (§0.2). The operator
                 must never have to work out whether his callsign is on the air,
                 and this sits in the pinned strip for the same reason the stop
                 does. -->
            <Border IsVisible="{Binding AutoCall.IsCalling}"
                    Margin="2,4,0,2" Padding="10,6" CornerRadius="6"
                    Background="{StaticResource HmGreenTintBrush}"
                    BorderBrush="{StaticResource HmGreenEdgeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding AutoCall.CallingLine}"
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource HmGreenBrush}" />

                    <TextBlock Text="{Binding AutoCall.WhereNow}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource HmGreenBrush}" />
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding Scan.IsScanning}"
                    Margin="2,4,0,2" Padding="10,6" CornerRadius="6"
                    Background="{StaticResource HmAmberTintBrush}"
                    BorderBrush="{StaticResource HmAmberEdgeBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Scan.MovingLine}"
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource HmAmberDeepBrush}" />

                    <TextBlock Text="{Binding Scan.WhereNow}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource HmAmberBrush}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Byline}"
                       IsVisible="{Binding HasByline}"
                       FontSize="12.5" FontStyle="Italic"
                       Margin="2,0,0,0"
                       Foreground="{StaticResource HmTextMutedBrush}"
                       ToolTip.Tip="{Binding BylineSource}"
                       ToolTip.ShowDelay="400" />
        </StackPanel>

        <!-- Always visible, and deliberately not the overlay bar that fades
             out when the pointer leaves. The complaint was not that scrolling
             was awkward, it was that there was no scrollbar to reach for, and a
             bar somebody has to discover by hovering is the same complaint
             wearing a thinner coat. -->

        <!-- THE CANVAS (HM-DEC-086).

             The main screen was one vertical scroll and had outgrown it. Every
             panel this application ever grew went into one column in the order
             it was built, and the operator scrolled past the ten they were not
             using to reach the two they were.

             So: the strip above stays put, a bar of starting points sits under
             it, and everything else is theirs to arrange. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- THE STRIP IS NOT PART OF THE CANVAS and cannot be closed or
                 moved. Band, frequency, mode, where you are and whether you may
                 transmit are what you need before you need anything else, and a
                 surface you can rearrange is the wrong place for them. This
                 widens HM-DEC-021's exemption for the rig display to the whole
                 strip it sits in. -->
            <!-- ONE ROW: where you are, what you are on, and whether you may
                 use it (HM-DEC-141). It is context rather than a tool, so it
                 stays fixed and outside the canvas, and it now costs a strip
                 rather than a third of the window. -->
            <!-- **THE BAND ROW COMES FIRST, THEN THIS** — Tim's ruling of
                 2026-08-26: from the top it is the Hamlet title, the line of
                 Shakespeare, then the bands. The row had drifted below the
                 readout, about two hundred pixels down the window, so the first
                 control anybody reaches for was the last thing they found. -->
            <!-- **THE HEADER IS THE SAME IN EVERY MODE** — Tim's ruling of
                 2026-08-27. The band plan is "the essential driver for a
                 session"; the neighborhood and the radio "are independent, so
                 that when we go from CW to digital to voice, that part stays the
                 same". So they sit above the divider and nothing below it can
                 move them.

                 **NEIGHBORHOOD LEFT AND WIDER, RADIO RIGHT AND NARROWER**, on
                 one row. The neighborhood is moved and not modified: it is the
                 same control with the same contents, hosted here instead of on
                 the canvas.

                 **THE PRIVILEGE LINE KEEPS ITS ROW BENEATH THEM.** The ruling
                 names two panels for this row and says nothing about where the
                 licence sentence goes, and HM-DEC-086 makes it permanent in the
                 top strip — whether you may transmit is not decoration and does
                 not get dropped for space. It stays above the divider, which is
                 where that ruling puts it. -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto" Margin="0,0,0,10">

                <!-- THE NEIGHBORHOOD, RELOCATED WHOLE (Tim, 2026-08-27: "It
                     looks exactly like it does now. We do not need to change the
                     neighborhood."). The template is the one the canvas used, so
                     there is one definition of this panel and not two. -->
                <ContentControl Grid.Row="0" Grid.Column="0"
                                Margin="0,0,14,0"
                                VerticalAlignment="Top"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource widget.map}" />


    <!-- Frequency face: the rig's own LCD on the console. Deliberately
         NOT collapsible (HM-DEC-021), and the whole strip it sits in is
         exempt from the canvas (HM-DEC-086). Padding cut from twenty by
         twelve, because the space around it was doing nothing. -->
    <Border Grid.Row="0" Grid.Column="1"
            VerticalAlignment="Top"
            Background="{StaticResource HmAmberTintBrush}"
            BorderBrush="{StaticResource HmAmberEdgeBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="12,6" Margin="0">
        <StackPanel Spacing="3">

            <!-- THE STAR IS INSIDE THE BLACK (HM-DEC-070), which reverses
                 what HM-DEC-060 built. That ruling kept Hamlet's chrome off
                 the LCD so the picture stayed a faithful IC-7300 face, and
                 Tim weighed that against being able to find the thing and
                 chose being able to find it. -->
            <ctl:RigDisplayControl HorizontalAlignment="Center"
                ToolTip.Tip="Roll the scroll wheel over any digit to tune that digit."
                HasTunedByWheel="{Binding HasTunedByWheel, Mode=TwoWay}"
                FrequencyHz="{Binding FrequencyHz}"
                BandLowHz="{Binding SelectedBand.Band.LowHz}"
                BandHighHz="{Binding SelectedBand.Band.HighHz}"
                ModeText="{Binding RigModeText}"
                FilterText="{Binding RigFilterText}"
                SMeterLevel="{Binding SMeterLevel}"
                IsFavorite="{Binding IsFavorite}"
                FavoriteLabel="{Binding FavoriteLabel}"
                ToggleFavoriteCommand="{Binding ToggleFavoriteCommand}" />

            <!-- THE HINT RETIRES ONCE IT HAS BEEN USED (HM-DEC-141). It is a
                 line somebody needs exactly once, and a line that stays on
                 screen forever after it has been learned is a line that teaches
                 people to stop reading that part of the window. Once the
                 operator has tuned by the wheel it goes, and the readout's own
                 tooltip carries it from then on. -->
            <TextBlock Text="scroll wheel over a digit tunes that digit"
                       FontSize="11" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       IsVisible="{Binding !HasTunedByWheel}"
                       Foreground="{StaticResource HmAmberBrush}" />

            <!-- **THE NUMBER SAYS HOW OLD IT IS WHEN IT IS OLD** (HM-DEC-111,
                 §0.0). The readout was drawn four times a second holding a
                 frequency the poll had last confirmed a minute earlier, which is
                 a display being current about a value that is not. It says
                 nothing while the reading is fresh, because a caption on every
                 screen is a caption nobody reads. -->
            <TextBlock Text="{Binding FrequencyAgeNote}"
                       FontSize="11" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       IsVisible="{Binding HasFrequencyAgeNote}"
                       Foreground="{StaticResource HmAmberBrush}" />

            <!-- How the conversation itself is going, which lived only in a
                 telemetry file the operator had to upload (§0.0.1). -->
            <TextBlock Text="{Binding LinkCheckLine}"
                       FontSize="11" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="420"
                       IsVisible="{Binding HasLinkCheck}"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </StackPanel>
    </Border>

    <!-- WHERE YOU ARE AND WHETHER YOU MAY TRANSMIT, which is not decoration
         and does not get dropped for space (HM-DEC-029, HM-DEC-141). It moves
         to the end of the row rather than under the readout, where it has the
         width to say the whole sentence. -->
    <!-- WHERE YOU ARE AND WHERE YOU HAVE BEEN, on one line under the bands
         (HM-DEC-141). Both used to have a row to themselves. -->
    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
          ColumnDefinitions="Auto,*"
          Margin="0,8,0,0" VerticalAlignment="Center">

    <!-- **THE FREQUENCY BLOCK RENDERED TWICE** (Tim, 2026-08-27): once inside
         the neighborhood map where it belongs, and again as a loose card beneath
         it saying the same `7.030 MHz · yours to use · 97.305(a)`. This was the
         loose one and it is gone.

         **THE COPY INSIDE THE MAP STAYS**, so HM-DEC-086's rule that whether you
         may transmit is permanent in the top strip is untouched — the map is a
         header panel and sits above the divider. -->

        <!-- The strip along the top of the warm panel (HM-DEC-070):
             which favorite you landed on at the left, and the way to
             any of them at the right. The name lives out here rather
             than in the black because a name is as long as somebody
             made it, and the LCD has a mode badge at one end and a
             clock at the other. -->
            <!-- **THE RECENT-PLACES ROW IS NOT HERE ANY MORE** (Tim's ruling
                 of 2026-08-27). `recent · places you have been · forget this
                 place` sat between the header and the tabs, which is the one
                 strip that is meant to be the same in every mode and is already
                 carrying the band plan, the neighborhood and the radio.

                 **IT IS NOT DELETED.** `FavoritesViewModel`, `RecentPlaces` and
                 the commands behind them are all still in the tree and still
                 tested; what has gone is this slot. `ABANDONED_WIDGETS.md`
                 records what it did, so rebuilding it somewhere it fits starts
                 from a description. -->
    </Grid>
            </Grid>

    <!-- **THE DIVIDER, AND IT IS NOT DECORATION** (Tim, 2026-08-27).
         Everything above it is the same in every mode and does not redraw when
         the mode changes; everything below it belongs to the mode. The line is
         how the operator can see which is which without being told. -->
    <Border Grid.Row="2" Height="1" Margin="0,2,0,12"
            Background="{StaticResource HmSlateEdgeBrush}" />

    <!-- **THE BAND ROW IS BELOW THE READOUT NOW, NOT BESIDE IT** — Tim's
         ruling of 2026-08-25, in his words: "the band's display is cut off. It
         needs to be shifted down."

         HM-DEC-141 had put the bands beside the readout to get the strip's
         height back, and that part still holds: this row is one card tall and
         the two-stacked-blocks layout it replaced cost about a third of the
         window. What it did not survive is a narrow window. The cards sit in a
         star column and the readout in an auto column beside it, and the cards
         cannot shrink, because their widths carry the wavelength ratio and that
         is the meaning rather than the size. So past some width the row runs
         under the readout, which is drawn over it, and the last card stops
         answering a click.

         **MEASURED, AND IT REACHED THE OPERATOR'S OWN WINDOW.** Hit-tested
         headless at four widths: at 1400 and 1200 every card answers its own
         centre, and at 1000 and 820 none of them does. HM-OPEN-060 recorded the
         1000-pixel case and the test was pinned at 1400, so the suite was green
         while the row was unreachable.

         The row now has a row of its own beneath the strip, so it has the whole
         window width and nothing to collide with. It is still outside the canvas
         and still cannot be closed or moved (HM-DEC-086), and nothing about the
         cards changes — the ratio that carries the meaning is untouched. -->
    <!-- **THE BADGE HANGS ABOVE THE CARDS AND THIS USED TO CLIP IT OFF**
         (Tim, 2026-08-26: the badge showed only its bottom sliver). The
         best-bet badge is drawn over its card with a negative top margin so it
         does not cost the row a line of its own, and this control's bounds are
         exactly one card tall — so everything above the card's top edge was
         outside the clip. Measured headless: the clipping ancestor is this
         `ItemsControl`, bounds 43 pixels tall, with the badge nine pixels above
         its top. The row keeps its height and stops clipping what deliberately
         overhangs it. -->
    <ItemsControl Grid.Row="0" VerticalAlignment="Top"
                  ClipToBounds="False"
                  ItemsSource="{Binding Bands}" Margin="0,14,0,10">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BandButtonViewModel">
                <!-- ONE CELL, AND THE BADGE IS DRAWN OVER IT.

                     THE BADGE USED TO BE A ROW OF ITS OWN, ABOVE THE CARD, AND
                     IT COST THE OPERATOR THE ABILITY TO TUNE. Two faults came
                     out of that one line. A band carrying the badge had its card
                     pushed down by the badge's height while every other card
                     stayed at the top, so the row no longer lined up. And the
                     badge is centred on a card whose width follows the
                     wavelength (HM-DEC-141), so on a narrow card the badge is
                     wider than the thing it labels and overhangs its
                     neighbours — where it sat in front of them and took their
                     clicks. On the evening this was found, `40 m` could not be
                     clicked at all and the only way to tune was through
                     favourites.

                     So the badge shares the card's cell, is aligned to the top
                     of it, and is `IsHitTestVisible="False"`. It cannot move a
                     card, and it cannot take a click from one — including its
                     own, which is the point: the badge is a label and the card
                     underneath it is the control. -->
                <Grid>
                    <Border ZIndex="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Background="{StaticResource HmGreenTintBrush}"
                            BorderBrush="{StaticResource HmGreenEdgeBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="6,0" Margin="0,-9,0,0"
                            IsVisible="{Binding IsBestBet}">
                        <!-- The label travels with the ranking, so a clock
                             guess can never wear the same words as an
                             observation (HM-DEC-046). -->
                        <TextBlock Text="{Binding BestBetLabel}" FontSize="11"
                                   Foreground="{StaticResource HmGreenBrush}" />
                    </Border>

                    <!-- A character card, not a plain button (HM-DEC-033).
                         Width follows wavelength, the icon and the bar say
                         whether the band is in its element, and the card
                         dims when it is not — three carriers for one fact,
                         so color is never doing the work alone. -->
                    <Button Classes="hm-band"
                            Width="{Binding CardWidth}"
                            Opacity="{Binding CardOpacity}"
                            Padding="8,6"
                            ToolTip.Tip="{Binding ActivityTooltip}"
                            ToolTip.ShowDelay="250"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectBandCommand}"
                            CommandParameter="{Binding}">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Band.Name}"
                                           VerticalAlignment="Center" />
                                <ctl:DayNightIconControl Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Icon="{Binding CardIcon}"
                                                         Tint="{Binding CardIconTint}" />
                            </Grid>

                            <Border Height="3" CornerRadius="2"
                                    Background="{Binding CardBar}" />

                            <ctl:ActivityPipsControl
                                HorizontalAlignment="Center"
                                Filled="{Binding ActivityPips}"
                                IsUnknown="{Binding ActivityUnknown}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

            <!-- **THREE WORKSPACES, AND THE CANVAS IS GONE** (Tim's ruling of
                 2026-08-27: *"CW should come up in its own canvas with send on
                 the left, receive on the right, nothing else. Data should have
                 an empty canvas. Voice should have an empty canvas. Those tabs
                 should work."*).

                 **WHAT WENT AND WHY.** He photographed the CW tab twice, a day
                 apart. The first time Receive rendered `wh at the rad io is he
                 ari ng` one or two letters to a line, squeezed beside the whole
                 arrangement. The second time Receive was fixed and the
                 arrangement was still underneath it — a second neighborhood map
                 and a second CW terminal on one screen, restored from a saved
                 layout.

                 A surface the operator arranges is a surface that can be
                 arranged wrongly, and a panel that is also a widget can appear
                 twice. So the canvas, the tray, the preset bar, the layout namer
                 and every saved arrangement are removed, and the workspaces hold
                 permanent panels instead. `ABANDONED_WIDGETS.md` records the
                 fifteen that went.

                 **HM-DEC-086 IS SUPERSEDED FOR THESE THREE**, explicitly rather
                 than worked around. What that ruling forbids is a puzzle handed
                 to somebody who came to talk on the radio; CW opens on two
                 working panels, and Digital and Voice are empty because they
                 have nothing to do yet. -->
            <Grid Grid.Row="4" RowDefinitions="Auto,*">

                <!-- **THE TABS SIT AT THE WORKSPACE'S OWN LEFT EDGE**, which is
                     now the window's, because the tray that used to occupy a
                     column to their left is gone. -->
                <ItemsControl Grid.Row="0" x:Name="ModeTabs"
                              ItemsSource="{Binding ModeTabs}"
                              Margin="0,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeTabViewModel">
                            <!-- **BOUND STRAIGHT TO THE TAB'S OWN FLAG.** It
                                 used to go through a converter with the tab's
                                 name passed as `ConverterParameter={Binding}`,
                                 and a converter parameter cannot be a binding —
                                 so it resolved to nothing, every tab read as
                                 unchecked, and the first press wrote an empty
                                 mode that no workspace matched. The screen went
                                 blank and stayed blank. -->
                            <RadioButton Classes="hm-tab"
                                         GroupName="OperatingMode"
                                         Content="{Binding Name}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- **THE TAB OWNS THE SPACE BELOW IT, AND IT HAS TO LOOK
                     LIKE IT** (Tim's ruling of 2026-08-27: *"Everything below
                     the CW Digital and Voice is the workspace canvas. That space
                     is bounded by the controlling tab. It needs to be obvious to
                     the user."*).

                     The tabs sit on the top edge of this border and the selected
                     one merges into it: same fill, same edge colour, and its
                     bottom border removed so the two are one shape. An
                     unselected tab keeps all four edges and reads as a separate
                     thing you could press.

                     **THE REGION IS THE SAME WHICHEVER TAB IS SELECTED**, which
                     is what makes it read as a space rather than as three
                     panels. What changes is only what is inside it. -->
                <Border Grid.Row="1" x:Name="WorkspaceBoundary"
                        Background="{StaticResource HmPanelBrush}"
                        BorderBrush="{StaticResource HmSlateEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="0,8,8,8"
                        Padding="12">
                    <Panel>

                <!-- **THE CW WORKSPACE IS ONE PIECE**: Send on the left,
                     Receive on the right, nothing else in it. Neither is a
                     widget: not removable, not draggable, not closable, and in
                     no catalogue. Tim: *"Makes no sense to have a CW workspace
                     without at least those two elements."* -->
                <Grid x:Name="CwWorkspace"
                      ColumnDefinitions="Auto,*"
                      IsVisible="{Binding IsCwMode}">

                    <Border Grid.Column="0" x:Name="SendPanel"
                            Width="320" Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            Padding="12" CornerRadius="8"
                            Background="{StaticResource HmSlateTintBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="8">

                            <!-- **SEND AND CLEAR SIT BESIDE THE TITLE** (Tim's
                                 ruling of 2026-08-27), so what transmits is
                                 visually apart from what composes. Clear is an
                                 action rather than a message and is coloured as
                                 one. -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="Send"
                                           FontSize="13" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource HmTextPrimaryBrush}" />

                                <!-- **THIS KEYS THE RADIO** (HM-DEC-059), through
                                     `PressCommand` — the same door the contextual
                                     options use, with the same readiness check,
                                     the same guard, the same abort and the same
                                     record. There is not a second path to the
                                     transmitter and this is not one. -->
                                <Button Grid.Column="1" x:Name="TransmitButton"
                                        Classes="hm-send"
                                        Content="Send" FontSize="12"
                                        Padding="16,5" Margin="0,0,6,0"
                                        Command="{Binding Transmit.PressCommand}"
                                        CommandParameter="{Binding Transmit.OwnWords}" />

                                <Button Grid.Column="2" Classes="hm-clear"
                                        Content="Clear" FontSize="12"
                                        Padding="12,5"
                                        Command="{Binding ComposeClearCommand}" />
                            </Grid>

                            <TextBox Text="{Binding Transmit.OwnWords.Message, Mode=TwoWay}"
                                     AcceptsReturn="False"
                                     Watermark="what you would send"
                                     FontSize="13" />

                            <!-- The macros fill the line; they do not send. -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="CQ" FontSize="12" Padding="12,5"
                                        Command="{Binding ComposeCqCommand}" />
                                <Button Content="RST" FontSize="12" Padding="12,5"
                                        Command="{Binding ComposeRstCommand}" />
                                <Button Content="73" FontSize="12" Padding="12,5"
                                        Command="{Binding ComposeSeventyThreeCommand}" />
                            </StackPanel>

                            <!-- **WHY IT WILL NOT SEND, WHEN IT WILL NOT** — the
                                 readiness reason, in the operator's words rather
                                 than a greyed button with nothing to say
                                 (§0.5.1, HM-DEC-080). -->
                            <TextBlock Text="{Binding Transmit.Status}"
                                       IsVisible="{Binding Transmit.IsRefusal}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource HmAmberBrush}" />

                            <!-- **WHAT EACH ONE DOES**, in the application's own
                                 voice (§0.7). The paragraph that used to sit here
                                 said nothing leaves the radio, which stopped
                                 being true the moment the button came back. -->
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}"
                                       Text="CQ tells the band you are looking for a conversation and puts your callsign on it. RST is the signal report, which is your honest word on how well you are hearing the other station. 73 is how a contact ends, and it means best wishes. Clear empties the line and sends nothing. Send puts what is on the line on the air." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" x:Name="ReceivePanel"
                            Padding="12" CornerRadius="8"
                            Background="{StaticResource HmPanelBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource widget.terminal}" />
                    </Border>
                </Grid>

                <!-- **THE DIGITAL WORKSPACE, AND EVERY STRING IN IT IS A
                     PLACEHOLDER** (work instruction 037). Nothing here decodes,
                     nothing moves, nothing is wired. It exists so the operator
                     can look at a finished-looking FT8 session and say what is
                     wrong with it before there is a decoder to argue with.

                     **THE PANELS ARE THE TAB'S, NOT WIDGETS** (Tim, 2026-08-28):
                     fixed, not removable, not draggable, in no catalogue. The
                     canvas is gone and nothing here reintroduces it. -->
                <Grid x:Name="DigitalWorkspace"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsDigitalMode}">

                    <!-- **THE MODE STRIP RUNS THE FULL WIDTH AND DOES NOT
                         COLLAPSE** (Tim, 2026-08-28: a row, not a column — four
                         short items and a status is a row, and a column would
                         narrow the waterfall for nothing). -->
                    <Border Grid.Row="0" x:Name="DigitalModeStrip"
                            Margin="0,0,0,10" Padding="10,7"
                            CornerRadius="8"
                            Background="{StaticResource HmPanelBrush}"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,Auto,*">

                            <TextBlock Grid.Column="0"
                                       Text="on this frequency"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Spacing="6" VerticalAlignment="Center">

                                <!-- **LIT AND UNLIT DIFFER BY MORE THAN COLOUR**
                                     (§0.6, HM-DEC-032). The lit one carries a
                                     border and semibold weight as well as the
                                     fill, so it survives a greyscale print and
                                     a colour-vision deficiency.

                                     **BOTH COLOURS COME FROM `ModePalette` AND
                                     NEITHER IS A LITERAL.** `ModeColors` already
                                     exposes them as brushes, so the strip reads
                                     the same language the map and the field
                                     guide read. -->
                                <Border x:Name="DigitalModeFt8"
                                        Padding="10,3" CornerRadius="5"
                                        Background="{x:Static ctl:ModePalette.DigitalFill}"
                                        BorderBrush="{x:Static ctl:ModePalette.DigitalInk}"
                                        BorderThickness="1">
                                    <TextBlock Text="FT8" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Static ctl:ModePalette.DigitalInk}" />
                                </Border>

                                <Border Padding="10,3" CornerRadius="5"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <TextBlock Text="FT4" FontSize="12"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                </Border>

                                <Border Padding="10,3" CornerRadius="5"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <TextBlock Text="PSK31" FontSize="12"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                </Border>

                                <Border Padding="10,3" CornerRadius="5"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <TextBlock Text="WSPR" FontSize="12"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- **THE STATIC STATUS STAYS EXACTLY AS UNIT 037
                                 WROTE IT** (work instruction 038). The clock is
                                 added beside it rather than replacing it: it is
                                 the one value on this strip that is measured,
                                 and it says so by standing apart from the ones
                                 that are not. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">

                                <TextBlock Text="{Binding ClockOffsetLine}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding !ClockIsConcerning}"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <TextBlock Text="{Binding ClockOffsetLine}"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding ClockIsConcerning}"
                                           Foreground="{StaticResource HmAmberDeepBrush}" />

                                <TextBlock Text="reading it &#183; 9 messages this slot"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource HmTextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">

                            <!-- **THE WATERFALL, WITH THE CAPTURE PRESS ON ITS
                                 HEADER** (Tim, 2026-08-28). The press is where a
                                 signal that decoded nothing is visible, rather
                                 than under a panel that can be collapsed.

                                 **IT IS DELIBERATELY NOT WIRED.** The trimming
                                 rule it has to obey — four complete slots on UTC
                                 boundaries — does not exist yet, and a press
                                 that keeps the wrong thing is worse than one
                                 that does nothing. It looks pressable because
                                 every string on this tab is a placeholder; that
                                 stops being acceptable the moment anything here
                                 is live. -->
                            <ctl:CollapsiblePanel x:Name="DigitalWaterfallPanel"
                                                  Family="Lavender"
                                                  Title="Waterfall"
                                                  Summary="{Binding DigitalWaterfallSummary}"
                                                  IsExpanded="{Binding DigitalWaterfallExpanded, Mode=TwoWay}">
                                <ctl:CollapsiblePanel.HeaderAction>
                                    <!-- **WIRED IN UNIT 041, AFTER BEING
                                         ORDERED AND DROPPED THREE TIMES.** Its
                                         label changes with what it does: it
                                         keeps the raw ring, untrimmed, because
                                         trimming is ruled out until scoring
                                         starts. A button that said "four slots"
                                         while keeping thirty raw seconds would
                                         be describing work nobody had done. -->
                                    <Button x:Name="DigitalCapturePress"
                                            Content="keep the last 30 seconds"
                                            FontSize="11"
                                            Padding="10,3"
                                            Command="{Binding CaptureDigitalCommand}"
                                            Background="{StaticResource HmSlateTintBrush}"
                                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                            BorderThickness="1"
                                            Foreground="{StaticResource HmTextPrimaryBrush}" />
                                </ctl:CollapsiblePanel.HeaderAction>

                                <ctl:WaterfallControl MinHeight="180"
                                                      Source="{Binding DigitalSpectrum}"
                                                      BandLowHz="200"
                                                      BandHighHz="3000" />
                            </ctl:CollapsiblePanel>

                            <!-- **DECODED TEXT SITS ABOVE WHAT PEOPLE ARE
                                 SAYING** (Tim, 2026-08-28: he is more interested
                                 in the text and expects to switch between
                                 them). -->
                            <ctl:CollapsiblePanel x:Name="DigitalDecodedPanel"
                                                  Family="Lavender"
                                                  Title="Decoded text"
                                                  Summary="14:22:45 UTC &#183; 4 shown"
                                                  IsExpanded="{Binding DigitalDecodedExpanded, Mode=TwoWay}">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="utc"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                               Margin="0,0,14,4"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="snr"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                               Margin="0,0,14,4"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="dt"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                               Margin="0,0,14,4"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="hz"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                               Margin="0,0,14,4"
                                               Foreground="{StaticResource HmTextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="message"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                               Margin="0,0,0,4"
                                               Foreground="{StaticResource HmTextMutedBrush}" />

                                    <!-- **THE FIRST ROW IS DRAWN SELECTED AND
                                         NOTHING SELECTS IT.** It is here so the
                                         operator can see what selection will
                                         look like before there is anything to
                                         select. -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="5"
                                            Background="{x:Static ctl:PanelPalette.LavenderFill}"
                                            CornerRadius="4" Margin="-4,0" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="142245"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="-19"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="-0.4"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="1502"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="1" Grid.Column="4" Text="W9XYZ K1ABC -13"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,0,1" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="142230"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="-13"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="0.2"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="1240"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="2" Grid.Column="4" Text="CQ K1ABC FN42"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,0,1" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="142230"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="-08"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="0.1"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="1875"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="3" Grid.Column="4" Text="CQ DX EA3QQ JN11"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,0,1" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="142215"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="-21"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="0.6"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="2310"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,14,1" />
                                    <TextBlock Grid.Row="4" Grid.Column="4" Text="VE7AA N0RR RR73"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,1,0,1" />
                                </Grid>
                            </ctl:CollapsiblePanel>

                            <ctl:CollapsiblePanel x:Name="DigitalSayingPanel"
                                                  Family="Lavender"
                                                  Title="What people are saying"
                                                  Summary="4 stations &#183; 2 contacts running"
                                                  IsExpanded="{Binding DigitalSayingExpanded, Mode=TwoWay}">
                                <StackPanel Spacing="10">

                                    <!-- Drawn in the same treatment as the
                                         selected decode row, and just as inert. -->
                                    <Border Background="{x:Static ctl:PanelPalette.LavenderFill}"
                                            CornerRadius="4" Padding="8,6">
                                        <Grid ColumnDefinitions="3,*">
                                            <Border Grid.Column="0" CornerRadius="2"
                                                    Background="{x:Static ctl:ModePalette.DigitalInk}" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                                <TextBlock Text="W9XYZ is answering K1ABC"
                                                           FontSize="13" TextWrapping="Wrap" />
                                                <TextBlock Text="and telling him he&#8217;s coming in weak"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource HmTextMutedBrush}" />
                                                <TextBlock Text="W9XYZ K1ABC -13"
                                                           FontFamily="Consolas,Menlo,monospace"
                                                           FontSize="11"
                                                           Foreground="{StaticResource HmTextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid ColumnDefinitions="3,*" Margin="0,0,0,0">
                                        <Border Grid.Column="0" CornerRadius="2"
                                                Background="{x:Static ctl:PanelPalette.LavenderEdge}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                            <TextBlock Text="K1ABC is calling anyone"
                                                       FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="Massachusetts &#183; about 480 miles &#183; strong"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{StaticResource HmTextMutedBrush}" />
                                            <TextBlock Text="CQ K1ABC FN42"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       FontSize="11"
                                                       Foreground="{StaticResource HmTextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="3,*">
                                        <Border Grid.Column="0" CornerRadius="2"
                                                Background="{x:Static ctl:PanelPalette.LavenderEdge}" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                            <TextBlock Text="EA3QQ is calling for distant stations"
                                                       FontSize="13" TextWrapping="Wrap" />

                                            <!-- **THE WHOLE REASON THIS ENTRY IS
                                                 IN THE PLACEHOLDER SET**: what a
                                                 looked-up fact looks like beside
                                                 facts that came off the air. The
                                                 country is the only thing here
                                                 Hamlet did not hear. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Spain" FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource HmTextMutedBrush}" />
                                                <Border CornerRadius="3" Padding="5,1"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Static ctl:PanelPalette.LavenderPillFill}">
                                                    <TextBlock Text="from the prefix list"
                                                               FontSize="10"
                                                               Foreground="{x:Static ctl:ModePalette.DigitalInk}" />
                                                </Border>
                                                <TextBlock Text="&#183; about 3,900 miles &#183; strong"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           Foreground="{StaticResource HmTextMutedBrush}" />
                                            </StackPanel>

                                            <TextBlock Text="CQ DX EA3QQ JN11"
                                                       FontFamily="Consolas,Menlo,monospace"
                                                       FontSize="11"
                                                       Foreground="{StaticResource HmTextMutedBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ctl:CollapsiblePanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="VoiceWorkspace"
                      IsVisible="{Binding IsVoiceMode}" />
                    </Panel>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource HmSlateTintBrush}"
                BorderBrush="{StaticResource HmSlateEdgeBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </Border>
    </Grid>
</Window>
