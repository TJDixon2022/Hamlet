<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Hamlet.App.Controls"
        xmlns:vm="using:Hamlet.App.ViewModels"
        x:Class="Hamlet.App.Views.AchievementsWindow"
        x:DataType="vm:AchievementsViewModel"
        Title="Achievements"
        Width="1040" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HmBackgroundBrush}">

    <!-- **HIS OWN OPERATING RECORD, WHICH IS THE SAME KIND OF THING AS HIS LOG**
         (Tim's ruling, 2026-09-08). Not Help: Help is *how do I use this*, and
         this is *what have I done*. It sits directly under `My contacts…` for
         that reason.

         **IT READS AND IT NEVER WRITES.** Nothing on it reaches the file or a send
         path; the only commands are the badge presses and the back control, and
         both only change which view of the same record is showing.

         **THE EXPOSURE HERE IS AN ACHIEVEMENT CLAIMED THAT WAS NOT EARNED**
         (§0.0). Every figure on it is derived from the records at the moment it is
         opened and nothing is remembered. -->

    <!-- **A CLICK-INTO SYSTEM, NOT A SCROLLER** (Tim, 2026-09-12, on unit 331's
         window: *"It should open like this, but not scroll. When you click on a
         category, that category replaces it."*). The page and a category are two
         states of this one grid; the old card view, the belt, *Your best* and the
         file path are gone from the window.

         **TEXT FITS, EVERYWHERE, AND NOTHING WRAPS** (work instruction 332 task 1).
         Every slot is sized to the longest string it can carry on the test host's
         flat ten pixels a character, which is wider than any face on the glass;
         `TheAchievementsPageClicksInTests` measures it. That is why the window is
         1000 wide where 331 left it at 820. -->

    <Window.Styles>
        <Style Selector="Button.hm-badge">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- **ONE BADGE, DRAWN ONCE** - the eight on the page and the seven inside
             Continents are the same shape, so they are the same template. -->
        <DataTemplate x:Key="HmBadgeTemplate" x:DataType="vm:AchievementBadge">
            <Button Classes="hm-chip hm-badge"
                    Margin="0,0,10,10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenCategoryCommand}"
                    CommandParameter="{Binding Kind}"
                    ToolTip.Tip="{Binding ScoreTip}">
                <Border Background="White"
                        BorderBrush="{StaticResource HmSlateEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <StackPanel>
                        <!-- **THE COLOR BAND, WITH THE EMBLEM AND THE NAME ON IT.** The
                             hue is the badge's own and claims no mode family (§0.5); the
                             name is on it in words, so the hue carries nothing by itself
                             (§0.6). -->
                        <Border Background="{Binding Band}" Padding="8,7">
                            <Grid ColumnDefinitions="Auto,*">
                                <ctl:BadgeEmblemControl Grid.Column="0"
                                                        Emblem="{Binding Emblem}"
                                                        Ink="White"
                                                        Width="22" Height="22"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Classes="badge-name"
                                           Text="{Binding Name}"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="White" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="8,6,8,8" Spacing="4">
                            <TextBlock Classes="badge-meaning"
                                       Text="{Binding Meaning}"
                                       FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <!-- **THE ONE CARD HE COULD EARN NEXT**, with the two forms
                                 of the mark: the ringed amber quill for a door and the
                                 still green one for a counter (§R16, §0.6). -->
                            <Border BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{StaticResource HmBackgroundBrush}"
                                    Padding="6,4"
                                    IsVisible="{Binding HasNextCard}">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <ctl:AchievementMarkControl
                                        Grid.RowSpan="2"
                                        Form="Door"
                                        IsNew="True"
                                        IsVisible="{Binding NextIsDoor}"
                                        Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />

                                    <ctl:AchievementMarkControl
                                        Grid.RowSpan="2"
                                        Form="Counter"
                                        IsNew="True"
                                        IsVisible="{Binding !NextIsDoor}"
                                        Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="next"
                                               FontSize="10"
                                               Foreground="{StaticResource HmTextMutedBrush}" />

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Classes="badge-next"
                                               Text="{Binding NextCard}"
                                               FontSize="12"
                                               Foreground="{StaticResource HmTextPrimaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- **THE CORNER, IN THREE SHORT LINES.** What he has - `0
                                 worked`, never `0 of 340` (§3.7) - then the points and
                                 level, then the gap. Absent rather than nought where the
                                 points file could not be read. -->
                            <TextBlock Classes="badge-corner"
                                       Text="{Binding Standing}"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="badge-corner"
                                       Text="{Binding PointsLine}"
                                       IsVisible="{Binding HasPointsLine}"
                                       TextAlignment="Right"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource HmGreenBrush}" />

                            <TextBlock Classes="badge-corner"
                                       Text="{Binding GapLine}"
                                       IsVisible="{Binding HasGapLine}"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">

        <!-- ============ THE PAGE: EIGHT BADGES AND NOTHING ELSE ============ -->
        <!-- **TITLE, THE RUNNING TOTAL, EIGHT BADGES IN TWO ROWS OF FOUR, THE LEGEND.**
             No scroller and nothing below the legend. **NO IMAGE ASSET IS REFERENCED
             HERE OR ANYWHERE IN `src/`**; every emblem is geometry in
             `BadgeEmblemControl`. -->
        <StackPanel x:Name="AchievementsPage"
                    IsVisible="{Binding ShowsPage}"
                    Spacing="10">
            <StackPanel Spacing="2">
                <TextBlock x:Name="AchievementsPageTitle"
                           Text="Achievements"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource HmTextPrimaryBrush}" />

                <TextBlock x:Name="AchievementsPageSubtitle"
                           Text="{Binding Page.Subtitle}"
                           FontSize="12"
                           Foreground="{StaticResource HmTextMutedBrush}" />

                <!-- **THE RUNNING TOTAL, ON THE PAGE, ALWAYS.** -->
                <TextBlock x:Name="AchievementsTotalLine"
                           Text="{Binding Page.TotalLine}"
                           IsVisible="{Binding Page.HasTotal}"
                           Margin="0,4,0,0"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource HmGreenBrush}" />

                <!-- **AND WHERE THE FILE COULD NOT BE READ, THE SENTENCE.** Amber
                     rather than red (HM-DEC-029's tone rule). **THE ONE LINE HERE
                     ALLOWED TO WRAP**, because it carries a path Hamlet does not
                     choose the length of. -->
                <TextBlock x:Name="AchievementsPointsProblem"
                           Text="{Binding Page.Problem}"
                           IsVisible="{Binding Page.HasProblem}"
                           Margin="0,4,0,0"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource HmAmberBrush}" />
            </StackPanel>

            <ItemsControl x:Name="AchievementsBadges"
                          ItemsSource="{Binding Page.Badges}"
                          ItemTemplate="{StaticResource HmBadgeTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="AchievementsLegend"
                       Text="Click a badge to open it. Orange ring: a door that opens a set. Green quill: a counter."
                       FontSize="11"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </StackPanel>

        <!-- ============ A CATEGORY, IN THE SAME FRAME ============ -->
        <!-- **A TEMPLATE OVER THE CATEGORY AND NOT BINDINGS THROUGH IT.** While the page
             shows there is no category, and bindings reaching through a null one each
             complain; with the category as content nothing is realized until there is
             one to draw. -->
        <ContentControl x:Name="AchievementsCategory"
                        IsVisible="{Binding ShowsCategory}"
                        Content="{Binding Category}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AchievementCategory">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- **THE BACK CONTROL, TOP LEFT, NAMING WHERE IT GOES.** -->
            <Button x:Name="AchievementsBack"
                    Grid.Row="0"
                    Classes="hm-chip"
                    HorizontalAlignment="Left"
                    Padding="6,4"
                    FontSize="13"
                    Content="{Binding BackLabel}"
                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).BackCommand}" />

            <!-- **THE BAND, AS `assets/category-page-countries.png` DRAWS IT** (work
                 instruction 335 task 1, R22): the emblem and the name; under the name what
                 the kind is, the count, the score and the level; on the right a bar to the
                 next level with what it is of in words above it. **Where there is no next
                 level the words say so and no bar is drawn**, because a bar is a fraction
                 and a fraction of nothing asserts something nobody measured (§0.0).
                 **The ink is computed** (`BandInk`): white wherever white clears 4.5:1
                 against the band, dark where it does not (§0.6). -->
            <Border x:Name="AchievementsCategoryBand"
                    Grid.Row="1"
                    Background="{Binding Band}"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,8,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <ctl:BadgeEmblemControl Grid.RowSpan="2"
                                            Emblem="{Binding Emblem}"
                                            Ink="{Binding BandInk}"
                                            Width="40" Height="40"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center" />

                    <TextBlock x:Name="AchievementsCategoryName"
                               Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{Binding BandInk}" />

                    <TextBlock x:Name="AchievementsCategoryBandLine"
                               Grid.Column="1" Grid.Row="1"
                               Text="{Binding BandLine}"
                               FontSize="12"
                               Foreground="{Binding BandInk}" />

                    <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                Width="300"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock x:Name="AchievementsLevelBarLine"
                                   Text="{Binding LevelBarLine}"
                                   IsVisible="{Binding HasLevelBar}"
                                   FontSize="12"
                                   Foreground="{Binding BandInk}" />

                        <ctl:BadgeProgressControl x:Name="AchievementsLevelBar"
                                                  IsVisible="{Binding HasLevelBar}"
                                                  Fraction="{Binding LevelFraction}"
                                                  Length="300"
                                                  Thickness="12"
                                                  Foreground="{Binding BandInk}"
                                                  Track="#40000000"
                                                  HorizontalAlignment="Left" />

                        <TextBlock x:Name="AchievementsNoNextLevel"
                                   Text="{Binding NoNextLevelLine}"
                                   IsVisible="{Binding HasNoNextLevel}"
                                   FontSize="12"
                                   Foreground="{Binding BandInk}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- **TOTAL MILES: THE RUNNING SUM AND A BAR TO THE NEXT TIER**, with both
                 figures in words beside it so the bar is never a bare fraction. -->
            <StackPanel Grid.Row="2"
                        IsVisible="{Binding HasBar}"
                        Spacing="4"
                        Margin="0,0,0,10">
                <TextBlock x:Name="AchievementsCategoryBarLine"
                           Text="{Binding BarLine}"
                           FontSize="12"
                           Foreground="{StaticResource HmTextPrimaryBrush}" />

                <ctl:BadgeProgressControl Fraction="{Binding BarFraction}"
                                          HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- **CONTINENTS: SEVEN BADGES IN THE SAME SHAPE**, each clicking in to its
                 countries. -->
            <!-- **PINNED TO THE TOP**: left to stretch, the uniform grid split the whole
                 remaining height between its two rows and the second row sat about 160 px
                 below the first (work instruction 332 task 5, measured). -->
            <ItemsControl x:Name="AchievementsSubBadges"
                          Grid.Row="3"
                          VerticalAlignment="Top"
                          IsVisible="{Binding HasSubBadges}"
                          ItemsSource="{Binding SubBadges}"
                          ItemTemplate="{StaticResource HmBadgeTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- **THE CARDS: EARNED, THEN THE NEAREST UNEARNED ONE, NOTHING BEYOND IT**
                 (§3.1). A kind can hold a hundred countries, so the cards scroll inside
                 the category; the page itself never does. -->
            <ScrollViewer Grid.Row="3"
                          IsVisible="{Binding HasCards}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AchievementsCategoryCards"
                              ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementCategoryCard">
                            <Border Margin="0,0,10,10"
                                    Background="White"
                                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Opacity="{Binding CardOpacity}">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Classes="card-title"
                                               Text="{Binding Title}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource HmTextPrimaryBrush}" />

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Figure}"
                                               IsVisible="{Binding HasFigure}"
                                               FontSize="11"
                                               Foreground="{StaticResource HmTextMutedBrush}" />

                                    <TextBlock Grid.Column="1" Grid.RowSpan="2"
                                               Text="{Binding PointsLine}"
                                               IsVisible="{Binding HasPoints}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource HmGreenBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</Window>
