<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Hamlet.App.Controls"
        xmlns:vm="using:Hamlet.App.ViewModels"
        xmlns:sys="using:System"
        x:Class="Hamlet.App.Views.AchievementsWindow"
        x:DataType="vm:AchievementsViewModel"
        Title="Achievements"
        Width="1280" Height="860"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HmBackgroundBrush}">

    <!-- **HIS OWN OPERATING RECORD, WHICH IS THE SAME KIND OF THING AS HIS LOG**
         (Tim's ruling, 2026-09-08). Not Help: Help is *how do I use this*, and
         this is *what have I done*. It sits directly under `My contacts…` for
         that reason.

         **IT READS AND IT NEVER WRITES.** Nothing on it reaches the file or a send
         path; the only commands are the tile presses, the row presses, the map
         buttons and the back control, and each only changes which view of the same
         record is showing.

         **THE EXPOSURE HERE IS AN ACHIEVEMENT CLAIMED THAT WAS NOT EARNED**
         (§0.0). Every figure on it is derived from the records at the moment it is
         opened and nothing is remembered. -->

    <!-- **A CLICK-INTO SYSTEM, NOT A SCROLLER** (Tim, 2026-09-12, on unit 331's
         window: *"It should open like this, but not scroll. When you click on a
         category, that category replaces it."*). The page and a category are two
         states of this one grid; the old card view, the belt, *Your best* and the
         file path are gone from the window.

         **OVERALL PROGRESS, WHAT IS LOCKED, AND THE MOMENT IT OPENS** (work instruction
         506, HM-DEC-211, replacing unit 331's title over eight badges and a legend).
         Tim, 2026-09-30: *"We need to show overall progress. We need unlocking."* The
         page is the approved picture, `assets/achievements-look/opening-page.html`: your
         standing in a ring at the left, and at the right the rank trail, eight tiles and
         who is within reach. **The window opens at 1280 by 860**, the picture's own
         size, where 505 left it at 1040 by 720; the author's, overrulable.

         **TEXT FITS, EVERYWHERE, AND NO WORD IS BROKEN** (work instruction 332 task 1,
         carried by 506). Every slot is sized to the longest string it can carry on the
         test host's flat ten pixels a character, which is wider than any face on the
         glass; `TheAchievementTilesTests` and `TheAchievementsPageClicksInTests` measure
         it. **One exception, and it is the picture's**: in a category's next-stamp column
         a sentence may run to a second line between words, as the picture draws it there. -->

    <Window.Styles>
        <Style Selector="Button.hm-badge">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- **A TILE IS PRESSED TO OPEN ITS KIND** (work instruction 506): the face is the tile, the button
             draws nothing of its own, and under the pointer the face's edge goes amber (§0.5.1). -->
        <Style Selector="Button.achievement-tile">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.achievement-tile /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.achievement-tile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.achievement-tile:pointerover Border.tile-face">
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberEdgeBrush}" />
        </Style>
        <Style Selector="Button.achievement-tile:pointerover Rectangle.tile-locked-edge">
            <Setter Property="Stroke" Value="{StaticResource HmAmberEdgeBrush}" />
        </Style>

        <!-- **JUST UNLOCKED READS AS PRESSABLE ON THE DARK PANEL** (work instruction 506, §0.5.1): a pale
             frame and a lighter ground at rest, lighter still under the pointer. -->
        <Style Selector="Button.standing-unlocked">
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.standing-unlocked /template/ ContentPresenter">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="Button.standing-unlocked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
        </Style>

        <!-- **A ROW THAT OPENS A MAP LOOKS PRESSABLE AT REST** (work instruction 505, §0.5.1):
             the hand cursor, the word `map` at its right end, and on the pointer its edge goes
             amber. The button draws no fill of its own; the row inside it is the face. -->
        <Style Selector="Button.category-row">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.category-row /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.category-row:pointerover Border.category-card">
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberEdgeBrush}" />
        </Style>

        <!-- **THE WORD `map` IS SAID ONLY BY A ROW THAT OPENS ONE WHEN PRESSED.** A continent's row
             opens its countries, and its map is the separate button beside it (task 4), so the
             word is set by where the row sits rather than by what the row holds. -->
        <Style Selector="TextBlock.card-open">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.category-row TextBlock.card-open">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- **THE TILE, ONE PER KIND** (work instruction 506 task 2, HM-DEC-211, replacing unit 331's
             badge): still the button that opens its kind. **Opened**, it carries a header in the kind's
             color with its emblem and name, its level in words, the count large and what it counts, a bar
             to the next level of his file with the gap in words, and what is next - `Opens a set:` in the
             amber ring for a door (R19), `Next:` otherwise. **Locked**, where nothing in the kind is earned,
             it is dashed and muted with a padlock, `Locked`, and what opens it. The words carry every state;
             the color only decorates them (§0.6). **No denominator of the world** (§3.7). -->
        <DataTemplate x:Key="HmTileTemplate" x:DataType="vm:AchievementBadge">
            <Button Classes="hm-badge achievement-tile"
                    Margin="0,0,14,14"
                    MinHeight="196"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenCategoryCommand}"
                    CommandParameter="{Binding Kind}"
                    ToolTip.Tip="{Binding ScoreTip}">
                <Panel>
                    <!-- ============ OPENED ============ -->
                    <Border Classes="tile-face"
                            IsVisible="{Binding IsOpened}"
                            Background="White"
                            BorderBrush="#D8D3C6"
                            BorderThickness="1"
                            CornerRadius="14"
                            ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{Binding TileBand}" Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <ctl:BadgeEmblemControl Emblem="{Binding Emblem}" Ink="White" Width="20" Height="20" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="tile-name" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="8,10,8,12" Spacing="6">
                                <Border IsVisible="{Binding HasLevelChip}"
                                        HorizontalAlignment="Left"
                                        Background="{Binding TileBand}"
                                        CornerRadius="999"
                                        Padding="8,1">
                                    <TextBlock Classes="tile-level" Text="{Binding LevelChip}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Classes="tile-count" Text="{Binding CountText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource HmTextPrimaryBrush}" />
                                </Viewbox>
                                <TextBlock Classes="tile-words" Text="{Binding CountWords}" FontSize="12" Foreground="#5F5C53" />

                                <ctl:BadgeProgressControl IsVisible="{Binding HasBar}"
                                                          Fraction="{Binding BarFraction}"
                                                          Length="160"
                                                          Thickness="8"
                                                          Track="#E6E1D5"
                                                          Foreground="{Binding TileBand}"
                                                          HorizontalAlignment="Left" />

                                <!-- **A GAP OR A COUNT IN MILES CAN OUTGROW THE TILE** (`9,000,000 mi to Platinum`), so each
                                     shrinks to it rather than clipping (§6), and draws full size wherever it fits. -->
                                <Viewbox IsVisible="{Binding HasBar}" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Classes="tile-gap" Text="{Binding BarGapLine}" FontSize="12" Foreground="#5F5C53" />
                                </Viewbox>

                                <Panel IsVisible="{Binding HasNextCard}">
                                    <Border IsVisible="{Binding !NextIsDoor}" Background="#F4F1EA" BorderBrush="#D8D3C6" BorderThickness="1" CornerRadius="10" Padding="6,5">
                                        <StackPanel>
                                            <TextBlock Classes="tile-next-label" Text="{Binding NextLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#3B6D11" />
                                            <TextBlock Classes="tile-next" Text="{Binding NextCard}" FontSize="11" Foreground="{StaticResource HmTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Border IsVisible="{Binding NextIsDoor}" Background="#F4F1EA" BorderBrush="#9A5B00" BorderThickness="2" CornerRadius="10" Padding="4,4">
                                        <StackPanel>
                                            <TextBlock Classes="tile-next-label" Text="{Binding NextLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#9A5B00" />
                                            <TextBlock Classes="tile-next" Text="{Binding NextCard}" FontSize="11" Foreground="{StaticResource HmTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- ============ LOCKED ============ -->
                    <Panel IsVisible="{Binding IsLocked}">
                        <Rectangle Classes="tile-locked-edge"
                                   Fill="#EFEBE1"
                                   Stroke="#B9B2A1"
                                   StrokeThickness="2"
                                   StrokeDashArray="3,2"
                                   RadiusX="14" RadiusY="14" />

                        <StackPanel Margin="12" Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <ctl:BadgeEmblemControl Emblem="{Binding Emblem}" Ink="#5F5C53" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="tile-name" Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#5F5C53" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="padlock"
                                      Data="M5 11 h14 v9 h-14 z M8 11 V8 a4 4 0 0 1 8 0 v3"
                                      Stroke="#5F5C53" StrokeThickness="1.8"
                                      Width="14" Height="14" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Locked" FontSize="11" FontWeight="SemiBold" Foreground="#5F5C53" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Classes="tile-none" Text="{Binding NoneYetLine}" FontSize="12" Foreground="#5F5C53" />

                            <Border Background="White" BorderBrush="#D8D3C6" BorderThickness="1" CornerRadius="10" Padding="6,5">
                                <StackPanel>
                                    <TextBlock Text="To open it:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HmTextPrimaryBrush}" />
                                    <TextBlock Classes="tile-open" Text="{Binding ToOpenLine}" FontSize="11" Foreground="{StaticResource HmTextPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Panel>
                </Panel>
            </Button>
        </DataTemplate>

        <!-- **ONE RANK ON THE TRAIL** (work instruction 506 task 2): the line into it and out of it, a circle
             checked for a rank passed, ringed with a dot for the one he holds, dashed with a padlock for the
             next, and its name and line under it. The words say which, not the circle alone (§0.6). -->
        <DataTemplate x:Key="HmRankStepTemplate" x:DataType="vm:AchievementRankStep">
            <StackPanel Spacing="4" MinWidth="90">
                <Grid ColumnDefinitions="*,34,*" Height="34">
                    <Border Grid.Column="0" Height="3" VerticalAlignment="Center" Background="#3B6D11" IsVisible="{Binding LineBeforeSolid}" />
                    <UniformGrid Grid.Column="0" Rows="1" Columns="4" VerticalAlignment="Center" IsVisible="{Binding LineBeforeDashed}">
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                    </UniformGrid>

                    <Border Grid.Column="2" Height="3" VerticalAlignment="Center" Background="#3B6D11" IsVisible="{Binding RightSolid}" />
                    <UniformGrid Grid.Column="2" Rows="1" Columns="4" VerticalAlignment="Center" IsVisible="{Binding RightDashed}">
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                        <Border Height="3" Margin="2,0" Background="#B9B2A1" />
                    </UniformGrid>

                    <Panel Grid.Column="1" Classes="rank-passed" IsVisible="{Binding IsPassed}">
                        <Ellipse Fill="#3B6D11" />
                        <Path Data="M5 12.5 L9.5 17 L19 7.5" Stroke="White" StrokeThickness="2.4" Width="16" Height="16" Stretch="Uniform" />
                    </Panel>

                    <Panel Grid.Column="1" Classes="rank-here" IsVisible="{Binding IsHere}">
                        <Ellipse Fill="White" Stroke="#3B6D11" StrokeThickness="3" />
                        <Ellipse Fill="#3B6D11" Width="12" Height="12" />
                    </Panel>

                    <Panel Grid.Column="1" Classes="rank-locked" IsVisible="{Binding IsLocked}">
                        <Ellipse Fill="#EFEBE1" Stroke="#8F8877" StrokeThickness="2" StrokeDashArray="2,2" />
                        <Path Data="M5 11 h14 v9 h-14 z M8 11 V8 a4 4 0 0 1 8 0 v3" Stroke="#5F5C53" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" />
                    </Panel>
                </Grid>

                <TextBlock Classes="rank-name" Text="{Binding Name}" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HmTextPrimaryBrush}" />
                <TextBlock Classes="rank-under" Text="{Binding Under}" HorizontalAlignment="Center" FontSize="11" Foreground="#5F5C53" />
            </StackPanel>
        </DataTemplate>

        <!-- **ONE ITEM OF A CATEGORY, DRAWN ONCE** (work instruction 505, HM-DEC-209). It replaces
             unit 335's trading card, which carried the path map across it at 231 px (R22, work
             instruction 342 rulings 11 and 16): Tim, 2026-09-30, *"we're just overdoing it on
             maps."* **No map is drawn here.** The one map in this window is the popup, on a click.

             **AN EARNED ONE IS A ROW**: the category's color at its left edge, the title bold,
             the call line under it, then the distance - the largest thing after the title, as
             it was on the card - band and mode over the date, the points, and at the right end
             the word that says what pressing it does. **Its height is the content's**, two lines
             of text and their padding, about sixty pixels: enough to read at arm's length, and
             small enough that a page of countries shows seven or eight at once. **The title's
             column is 340 px**, the longest entity name, Sovereign Military Order of Malta, at
             330 on the test host with room to spare, so no title clips and the distances down
             the page stand in one column. The author's, overrulable.

             **THE ONE UNEARNED ONE IS A PANEL**: the grey edge and `next` in words, what it
             wants, the quill line and the callers, exactly as the card drew them (§3.1, §0.6). -->
        <DataTemplate x:Key="HmCategoryItemTemplate" x:DataType="vm:AchievementCategoryCard">
            <Border Classes="category-card"
                    Background="White"
                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Opacity="{Binding CardOpacity}">
                <Grid ColumnDefinitions="6,*">
                    <Border Grid.Column="0"
                            IsVisible="{Binding Earned}"
                            Background="{Binding $parent[ItemsControl].((vm:AchievementCategory)DataContext).Band}" />

                    <Border Grid.Column="0"
                            IsVisible="{Binding !Earned}"
                            Background="#C9C5BA" />

                    <!-- ============ EARNED: ONE ROW ============ -->
                    <!-- **ITS SEAL AT THE LEFT** (work instruction 506 task 4): a double-ruled ring in the kind's
                         color, turned a few degrees, holding the short code of what was earned. **Band, mode and
                         date sit on a third line under the call line**, where the picture draws them in a column
                         of their own, so the row fits beside the next-stamp column at the window's own 1280 on
                         the test host's measure (§6). -->
                    <Grid Grid.Column="1"
                          IsVisible="{Binding Earned}"
                          Margin="14,8,14,8"
                          ColumnDefinitions="Auto,340,*,Auto,Auto,Auto">
                        <ctl:AchievementSealControl Grid.Column="0"
                                                    Classes="row-seal"
                                                    IsVisible="{Binding HasSeal}"
                                                    Code="{Binding SealCode}"
                                                    Ink="{Binding SealColor}"
                                                    Width="46" Height="46"
                                                    CodeSize="14"
                                                    Margin="0,0,18,0"
                                                    VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Classes="card-title"
                                       Text="{Binding Title}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <TextBlock Classes="card-callgrid"
                                       Text="{Binding CallGridLine}"
                                       IsVisible="{Binding HasCallGridLine}"
                                       FontFamily="Consolas, Menlo, monospace"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Classes="card-facts"
                                           Text="{Binding BandModeLine}"
                                           IsVisible="{Binding HasBandMode}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <TextBlock Classes="card-facts"
                                           Text="{Binding DateLine}"
                                           IsVisible="{Binding HasDate}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />
                            </StackPanel>

                            <TextBlock Classes="card-figure"
                                       Text="{Binding Figure}"
                                       IsVisible="{Binding ShowsFigure}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="card-count"
                                       Text="{Binding CountLine}"
                                       IsVisible="{Binding HasCountLine}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />
                        </StackPanel>

                        <!-- **A TIER'S BAR** (work instruction 335 task 4): Total Miles' tiers and a distance
                             first, with both figures in words above it so the bar is never a bare fraction. -->
                        <StackPanel Grid.Column="2"
                                    IsVisible="{Binding HasTierBar}"
                                    Spacing="4"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="card-tier"
                                       Text="{Binding TierLine}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <ctl:BadgeProgressControl Fraction="{Binding TierFraction}"
                                                      Length="200"
                                                      Thickness="8"
                                                      HorizontalAlignment="Left"
                                                      Foreground="{Binding $parent[ItemsControl].((vm:AchievementCategory)DataContext).Band}" />
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Classes="card-distance"
                                   Text="{Binding DistanceLine}"
                                   IsVisible="{Binding HasDistance}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                        <TextBlock Grid.Column="4"
                                   Classes="card-points"
                                   Text="{Binding PointsLine}"
                                   IsVisible="{Binding HasPoints}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource HmGreenBrush}" />

                        <StackPanel Grid.Column="5"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="card-open"
                                       Text="{x:Static vm:AchievementCategoryCard.MapWord}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#3B6D11" />

                            <TextBlock Classes="card-nomap"
                                       Text="{Binding NoMapWord}"
                                       IsVisible="{Binding HasNoMap}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- ============ THE ONE TO EARN NEXT: A PANEL ============ -->
                    <StackPanel Grid.Column="1"
                                IsVisible="{Binding !Earned}"
                                Margin="16,12,16,14"
                                Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="card-title"
                                       Text="{Binding Title}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <TextBlock Grid.Column="1"
                                       Classes="card-points"
                                       Text="{Binding PointsLine}"
                                       IsVisible="{Binding HasPoints}"
                                       Margin="12,0,0,0"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource HmGreenBrush}" />
                        </Grid>

                        <TextBlock Classes="card-figure"
                                   Text="{Binding Figure}"
                                   IsVisible="{Binding ShowsFigure}"
                                   FontSize="12"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <TextBlock Classes="card-count" TextWrapping="Wrap"
                                   Text="{Binding CountLine}"
                                   IsVisible="{Binding HasCountLine}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                        <StackPanel IsVisible="{Binding HasTierBar}"
                                    Spacing="4"
                                    Margin="0,2,0,2">
                            <TextBlock Classes="card-tier" TextWrapping="Wrap"
                                       Text="{Binding TierLine}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <ctl:BadgeProgressControl Fraction="{Binding TierFraction}"
                                                      Length="300"
                                                      Thickness="10"
                                                      HorizontalAlignment="Left"
                                                      Foreground="{Binding $parent[ItemsControl].((vm:AchievementCategory)DataContext).Band}" />
                        </StackPanel>

                        <!-- **WHAT IT WANTS, AND WHO ON THE CQ LIST WOULD EARN IT** (work
                             instruction 335 task 3). The heading carries the time the list was
                             read; each caller carries the quill his row on the decoded list
                             wears, and the place is said in words, so the mark is never alone
                             (§0.6). **The callers open no map**: a caller has no path. -->
                        <TextBlock Classes="card-wants" TextWrapping="Wrap"
                                   Text="{Binding WantsLine}"
                                   IsVisible="{Binding HasWants}"
                                   FontSize="12"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <TextBlock Classes="card-quill" TextWrapping="Wrap"
                                   Text="{Binding QuillLine}"
                                   IsVisible="{Binding HasQuillLine}"
                                   FontSize="12"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <Border Classes="card-list"
                                IsVisible="{Binding HasCallersPanel}"
                                Background="{StaticResource HmBackgroundBrush}"
                                BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="card-callers-heading" TextWrapping="Wrap"
                                           Text="{Binding CallersHeading}"
                                           IsVisible="{Binding HasCallersHeading}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <ItemsControl ItemsSource="{Binding Callers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NextCaller">
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                                                <ctl:AchievementMarkControl
                                                    Form="Door"
                                                    IsNew="True"
                                                    IsVisible="{Binding OpensContinent}"
                                                    Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />

                                                <ctl:AchievementMarkControl
                                                    Form="Counter"
                                                    IsNew="True"
                                                    IsVisible="{Binding IsCounter}"
                                                    Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           Classes="card-caller-place"
                                                           Text="{Binding Place}"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="{StaticResource HmTextPrimaryBrush}" />

                                                <TextBlock Grid.Column="1" Grid.Row="1" TextWrapping="Wrap"
                                                           Classes="card-caller-call"
                                                           Text="{Binding CallLine}"
                                                           Margin="0,1,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{StaticResource HmTextMutedBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="card-more-callers" TextWrapping="Wrap"
                                           Text="{Binding MoreCallersLine}"
                                           IsVisible="{Binding HasMoreCallers}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <TextBlock Classes="card-nocaller" TextWrapping="Wrap"
                                           Text="{Binding NoCallerLine}"
                                           IsVisible="{Binding HasNoCaller}"
                                           FontSize="13"
                                           Foreground="{StaticResource HmTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- **WHAT WAS JUST UNLOCKED: ITS SEAL, ITS NAME, THE STATION AND DISTANCE, ITS POINTS** (work
             instruction 506 task 1), drawn once for the button that opens its path and for the panel
             that has none. -->
        <DataTemplate x:Key="HmJustUnlockedFace" x:DataType="vm:AchievementStanding">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <ctl:AchievementSealControl Grid.Column="0"
                                            Code="{Binding JustUnlocked.SealCode, FallbackValue=''}"
                                            Ink="{Binding JustUnlockedSealInk}"
                                            Width="64" Height="64"
                                            CodeSize="18" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding JustUnlocked.Title, FallbackValue=''}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="{Binding JustUnlockedLine}"
                               FontFamily="Consolas, Menlo, monospace"
                               FontSize="13"
                               Foreground="#C9D3DB" />
                    <TextBlock Text="{Binding JustUnlockedPoints}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#9AD05F" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">

        <!-- **THE OPENING PAGE, AS `assets/achievements-look/opening-page.html` DRAWS IT** (work
             instruction 506, HM-DEC-211, replacing unit 331's title over eight badges): your standing
             at the left, and at the right the title, the rank trail, the eight tiles and who is within
             reach. Tim, 2026-09-30: *"We need to show overall progress. We need unlocking."* **No
             scroller; no image asset is referenced here or anywhere in `src/`**, and every emblem is
             geometry. **The picture's serif display face is not in the application**: the headings use
             the application's own face at the picture's sizes and weights. -->
        <Grid x:Name="AchievementsPage"
              IsVisible="{Binding ShowsPage}"
              ColumnDefinitions="340,*"
              ColumnSpacing="20">

            <!-- ============ YOUR STANDING ============ -->
            <!-- **THE RING, THE GAP, THREE FACTS, AND WHAT WAS JUST UNLOCKED** (work instruction 506
                 task 1). Every number is his file's arithmetic (`AchievementStanding`); where the file
                 cannot be read no ring and no number is drawn, the panel says why, and the rest of the
                 page still draws. -->
            <Border x:Name="AchievementsStanding"
                    Grid.Column="0"
                    Background="#14202B"
                    CornerRadius="18"
                    Padding="24">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="18">
                        <TextBlock Text="YOUR STANDING"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#C9D3DB" />

                        <Panel Width="232" Height="232"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding Standing.HasScores, FallbackValue=False}">
                            <ctl:StandingRingControl x:Name="AchievementsStandingRing"
                                                     Fraction="{Binding Standing.Fraction, FallbackValue=0}"
                                                     Foreground="#9AD05F"
                                                     Track="#2B3B49"
                                                     Thickness="16" />

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{Binding Standing.RankLabel, FallbackValue=''}"
                                           IsVisible="{Binding Standing.HasRankLabel, FallbackValue=False}"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#C9D3DB" />

                                <!-- A named rank can be longer than the ring is wide, so the figure
                                     shrinks to fit rather than clipping (§6). -->
                                <Viewbox MaxWidth="170" Height="80" StretchDirection="DownOnly">
                                    <TextBlock Classes="standing-rank"
                                               Text="{Binding Standing.RankBig, FallbackValue=''}"
                                               FontSize="80" FontWeight="Bold"
                                               Foreground="White" />
                                </Viewbox>

                                <TextBlock Text="{Binding Standing.PointsLine, FallbackValue=''}"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           Foreground="#C9D3DB" />
                            </StackPanel>
                        </Panel>

                        <TextBlock Text="{Binding Standing.GapLine, FallbackValue=''}"
                                   IsVisible="{Binding Standing.HasScores, FallbackValue=False}"
                                   HorizontalAlignment="Center"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#9AD05F" />

                        <!-- **WHERE THE FILE COULD NOT BE READ, THE SENTENCE AND NO NUMBER.** The one line
                             here allowed to wrap, because it carries a path Hamlet does not choose. -->
                        <TextBlock Text="{Binding Standing.Problem, FallbackValue=''}"
                                   IsVisible="{Binding Standing.HasProblem, FallbackValue=False}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="#F2C46B" />

                        <!-- **THREE FACTS, ONE TO A ROW** (work instruction 506 task 1). The picture sets
                             them three across; at the panel's 292 px a figure like `9,673` in large type
                             and a word like `countries` under it do not both fit a third of it without
                             clipping on the test host's measure (§6), so each is a row, the figure large
                             at the left and its words beside it. -->
                        <Border Classes="standing-fact" Background="#14FFFFFF" CornerRadius="10" Padding="12,8">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="96,*">
                                    <TextBlock Text="{Binding Standing.Contacts, FallbackValue=''}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Grid.Column="1" Text="contacts" FontSize="13" VerticalAlignment="Center" Foreground="#C9D3DB" />
                                </Grid>

                                <Grid ColumnDefinitions="96,*">
                                    <TextBlock Text="{Binding Standing.Countries, FallbackValue=''}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Grid.Column="1" Text="countries" FontSize="13" VerticalAlignment="Center" Foreground="#C9D3DB" />
                                </Grid>

                                <Grid ColumnDefinitions="96,*" IsVisible="{Binding Standing.HasFarthest, FallbackValue=False}">
                                    <TextBlock Text="{Binding Standing.Farthest, FallbackValue=''}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Grid.Column="1" Text="farthest, miles" FontSize="13" VerticalAlignment="Center" Foreground="#C9D3DB" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- **JUST UNLOCKED: THE MOST RECENT THING HE EARNED, BY THE DATE OF ITS CONTACT.** A
                         button that opens its path in the popup; with nothing earned, what the first
                         contact earns, and no seal. -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="10" VerticalAlignment="Bottom">
                        <TextBlock Text="JUST UNLOCKED"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#C9D3DB" />

                        <Button x:Name="AchievementsJustUnlocked"
                                Classes="standing-unlocked"
                                IsVisible="{Binding Standing.JustUnlockedOpensMap, FallbackValue=False}"
                                Command="{Binding OpenTheMapCommand}"
                                CommandParameter="{Binding Standing.JustUnlocked}"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                            <ContentControl Content="{Binding Standing}"
                                            ContentTemplate="{StaticResource HmJustUnlockedFace}" />
                        </Button>

                        <!-- **WITH NO PATH IT IS NOT A BUTTON**, as a row with no grid is not (unit 505): it
                             names what was earned and does not offer a map it cannot open. -->
                        <Border x:Name="AchievementsJustUnlockedNoMap"
                                IsVisible="{Binding Standing.JustUnlockedHasNoMap, FallbackValue=False}"
                                Padding="14"
                                CornerRadius="14"
                                BorderThickness="1"
                                BorderBrush="#38FFFFFF"
                                Background="#14FFFFFF">
                            <ContentControl Content="{Binding Standing}"
                                            ContentTemplate="{StaticResource HmJustUnlockedFace}" />
                        </Border>

                        <StackPanel IsVisible="{Binding Standing.HasNothingYet, FallbackValue=False}">
                            <TextBlock Text="{Binding Standing.NothingYetLine, FallbackValue=''}"
                                       FontSize="14"
                                       Foreground="White" />
                            <TextBlock Text="{Binding Standing.NothingYetWorth, FallbackValue=''}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#9AD05F" />
                        </StackPanel>
                    </StackPanel>

                    <Panel />
                </DockPanel>
            </Border>

            <!-- ============ THE RIGHT SIDE ============ -->
            <DockPanel Grid.Column="1">
                <!-- **WITHIN REACH RIGHT NOW** (work instruction 506 task 3): up to three stations on the CQ
                     list the window was opened with who would earn him something, what in words, and a door
                     ringed in amber with the words `opens` beside it (R19, §0.6). **It sends nothing and tunes
                     nothing.** The snapshot carries the time it was read and no band, so the heading says the
                     time. With nobody who would earn anything it says so in a line and draws no empty box. -->
                <Border x:Name="AchievementsWithinReach"
                        DockPanel.Dock="Bottom"
                        Margin="0,16,0,0"
                        Background="#14202B"
                        CornerRadius="14"
                        Padding="18,14">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Within reach right now" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding WithinReach.Heading, FallbackValue=''}" FontSize="13" Foreground="#C9D3DB" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <TextBlock Text="{Binding WithinReach.NobodyLine, FallbackValue=''}"
                                   IsVisible="{Binding WithinReach.HasNobody, FallbackValue=False}"
                                   FontSize="13"
                                   Foreground="#C9D3DB" />

                        <ItemsControl ItemsSource="{Binding WithinReach.Stations, FallbackValue={x:Null}}"
                                      IsVisible="{Binding WithinReach.HasStations, FallbackValue=False}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ReachableStation">
                                    <Border Classes="reach-station"
                                            Margin="0,0,12,0"
                                            Background="#14FFFFFF"
                                            BorderBrush="#2EFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Ellipse Classes="reach-ring" IsVisible="{Binding OpensContinent}" Width="12" Height="12" Fill="White" Stroke="#9A5B00" StrokeThickness="3" VerticalAlignment="Center" />
                                            <Ellipse Classes="reach-dot" IsVisible="{Binding IsCounter}" Width="12" Height="12" Fill="#3B6D11" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Callsign}" FontFamily="Consolas, Menlo, monospace" FontSize="14" Foreground="White" />
                                                    <TextBlock Text="{Binding Place}" FontSize="13" Foreground="#C9D3DB" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Earns}" FontSize="12" Foreground="#C9D3DB" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            <StackPanel Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="AchievementsPageTitle"
                               Text="Achievements"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <TextBlock x:Name="AchievementsPageSubtitle"
                               Text="What you have done on the air, and what is one contact away."
                               FontSize="13"
                               Foreground="#5F5C53" />

                    <!-- **WHERE THE FILE COULD NOT BE READ, THE SENTENCE.** Amber rather than red
                         (HM-DEC-029's tone rule), and the one line here allowed to wrap, because it
                         carries a path Hamlet does not choose the length of. -->
                    <TextBlock x:Name="AchievementsPointsProblem"
                               Text="{Binding Page.Problem}"
                               IsVisible="{Binding Page.HasProblem}"
                               Margin="0,4,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource HmAmberBrush}" />
                </StackPanel>

                <!-- **THE RANK TRAIL** (work instruction 506 task 2): each rank passed, checked; the one he
                     holds, `you are here`; the next one locked, with a padlock and where it opens; nothing
                     after it (§2: one locked rank, never the ladder). A solid line joins what is done and a
                     dashed one leads to the locked rank. Past four passed ranks the last three are drawn and
                     the rest are counted in words. The locked rank takes a cell of its own width, so its
                     line is never clipped. -->
                <Border x:Name="AchievementsRankTrail"
                        IsVisible="{Binding Page.Trail.HasSteps, FallbackValue=False}"
                        Background="White"
                        BorderBrush="#D8D3C6"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18,12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding Page.Trail.EarlierLine, FallbackValue=''}"
                                   IsVisible="{Binding Page.Trail.HasEarlierLine, FallbackValue=False}"
                                   VerticalAlignment="Top"
                                   Margin="0,8,12,0"
                                   FontSize="12"
                                   Foreground="#5F5C53" />

                        <ContentControl DockPanel.Dock="Right"
                                        Content="{Binding Page.Trail.Locked, FallbackValue={x:Null}}"
                                        IsVisible="{Binding Page.Trail.HasLocked, FallbackValue=False}"
                                        ContentTemplate="{StaticResource HmRankStepTemplate}" />

                        <ItemsControl ItemsSource="{Binding Page.Trail.Drawn, FallbackValue={x:Null}}"
                                      ItemTemplate="{StaticResource HmRankStepTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <ItemsControl x:Name="AchievementsBadges"
                              ItemsSource="{Binding Page.Badges}"
                              ItemTemplate="{StaticResource HmTileTemplate}"
                              Margin="0,0,-14,-14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ============ A CATEGORY, IN THE SAME FRAME ============ -->
        <!-- **A TEMPLATE OVER THE CATEGORY AND NOT BINDINGS THROUGH IT.** While the page
             shows there is no category, and bindings reaching through a null one each
             complain; with the category as content nothing is realized until there is
             one to draw. -->
        <ContentControl x:Name="AchievementsCategory"
                        IsVisible="{Binding ShowsCategory}"
                        Content="{Binding Category}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AchievementCategory">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- **THE BACK CONTROL, TOP LEFT, NAMING WHERE IT GOES** - the picture's plain link
                 since work instruction 342 (ruling 15). The words (`BackLabel`) and the command
                 are unchanged; only the chip's hover fill and padding go. Muted ink at rest, the
                 primary ink under the pointer and a hand cursor, so it still reads as pressable
                 without a box, and the words carry what it does (§0.6). -->
            <Button x:Name="AchievementsBack"
                    Grid.Row="0"
                    Classes="hm-backlink"
                    HorizontalAlignment="Left"
                    Padding="0,2"
                    FontSize="13"
                    Cursor="Hand"
                    Foreground="{StaticResource HmTextMutedBrush}"
                    Content="{Binding BackLabel}"
                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).BackCommand}">
                <Button.Styles>
                    <Style Selector="Button.hm-backlink /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button.hm-backlink:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource HmTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="Button.hm-backlink:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Button.Styles>
            </Button>

            <!-- **THE BAND, UNCHANGED BY WORK INSTRUCTION 505** (HM-DEC-209), which replaced the
                 trading cards under it with rows and left the band as unit 335 drew it from a
                 picture since superseded: the emblem and the name; under the name what
                 the kind is, the count, the score and the level; on the right a bar to the
                 next level with what it is of in words above it. **Where there is no next
                 level the words say so and no bar is drawn**, because a bar is a fraction
                 and a fraction of nothing asserts something nobody measured (§0.0).
                 **The ink is computed** (`BandInk`): white wherever white clears 4.5:1
                 against the band, dark where it does not (§0.6). -->
            <Border x:Name="AchievementsCategoryBand"
                    Grid.Row="1"
                    Background="{Binding Band}"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,8,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <ctl:BadgeEmblemControl Grid.RowSpan="2"
                                            Emblem="{Binding Emblem}"
                                            Ink="{Binding BandInk}"
                                            Width="40" Height="40"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center" />

                    <!-- **THE NAME AND ITS LEVEL IN WORDS** (work instruction 506 task 4): the chip is the
                         file's level, and there is none below the first. -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="AchievementsCategoryName"
                                   Text="{Binding Name}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{Binding BandInk}" />

                        <Border IsVisible="{Binding HasLevelChip}"
                                Background="#47000000"
                                CornerRadius="999"
                                Padding="10,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="AchievementsCategoryLevel"
                                       Text="{Binding LevelChip}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding BandInk}" />
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="AchievementsCategoryBandLine"
                               Grid.Column="1" Grid.Row="1"
                               Text="{Binding BandLine}"
                               FontSize="12"
                               Foreground="{Binding BandInk}" />

                    <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                Width="300"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock x:Name="AchievementsLevelBarLine"
                                   Text="{Binding LevelBarLine}"
                                   IsVisible="{Binding HasLevelBar}"
                                   FontSize="12"
                                   Foreground="{Binding BandInk}" />

                        <ctl:BadgeProgressControl x:Name="AchievementsLevelBar"
                                                  IsVisible="{Binding HasLevelBar}"
                                                  Fraction="{Binding LevelFraction}"
                                                  Length="300"
                                                  Thickness="12"
                                                  Foreground="{Binding BandInk}"
                                                  Track="#40000000"
                                                  HorizontalAlignment="Left" />

                        <TextBlock x:Name="AchievementsNoNextLevel"
                                   Text="{Binding NoNextLevelLine}"
                                   IsVisible="{Binding HasNoNextLevel}"
                                   FontSize="12"
                                   Foreground="{Binding BandInk}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- **TOTAL MILES' OWN BAR ROW IS GONE** (work instruction 335 task 4): each tier
                 row carries its bar, and the band carries the level bar. -->

            <!-- **CONTINENTS: SEVEN ROWS, EACH PRESSABLE INTO ITS COUNTRIES** (work instruction
                 505, HM-DEC-209, replacing unit 335's seven trading cards). Each is the same row
                 every kind draws, inside the button that opens its countries. **They scroll inside
                 the category**, as every kind's rows do; the page itself still never scrolls. -->
            <ScrollViewer Grid.Row="3"
                          IsVisible="{Binding HasSubBadges}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AchievementsSubBadges"
                              ItemsSource="{Binding SubBadges}">
                    <ItemsControl.ItemTemplate>
                        <!-- **TWO PRESSABLE THINGS, SIDE BY SIDE AND NEVER ONE INSIDE THE OTHER**
                             (work instruction 505 task 4). The row opens the continent's countries,
                             as it did; the small `map` beside it opens the path of the contact that
                             opened the continent. An unearned continent has no path and no map
                             button. -->
                        <DataTemplate x:DataType="vm:AchievementBadge">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <Button Classes="hm-badge"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenCategoryCommand}"
                                        CommandParameter="{Binding Kind}"
                                        ToolTip.Tip="{Binding ScoreTip}">
                                    <ContentControl Content="{Binding Card}"
                                                    ContentTemplate="{StaticResource HmCategoryItemTemplate}" />
                                </Button>

                                <Button Grid.Column="1"
                                        Classes="category-map"
                                        IsVisible="{Binding Card.OpensAMap, FallbackValue=False}"
                                        Content="{x:Static vm:AchievementCategoryCard.MapWord}"
                                        Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenTheMapCommand}"
                                        CommandParameter="{Binding Card}"
                                        Margin="8,0,0,0"
                                        Padding="12,6"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        ToolTip.Tip="Open the path of the contact that opened it." />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- **THE STAMPS, NEWEST FIRST, AND THE NEXT ONE IN ITS OWN COLUMN** (work instruction 506 task
                 4, `assets/achievements-look/countries-page.html`, replacing unit 505's next-first list).
                 The list is the earned rows, newest first, one column; the one unearned card of §3.1 stands
                 at the right as the next stamp, dashed and muted with a padlock, where it is always seen, and
                 `Your reach` under it says the farthest and the newest. A kind can hold a hundred countries,
                 so the list scrolls inside the category; the page itself never does. -->
            <Grid Grid.Row="3"
                  IsVisible="{Binding HasCards}"
                  ColumnDefinitions="*,330"
                  ColumnSpacing="20">
                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="YOUR STAMPS, NEWEST FIRST"
                                   IsVisible="{Binding HasEarnedRows}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#5F5C53" />
                        <TextBlock Grid.Column="1"
                                   Text="Click a row to see where it is."
                                   IsVisible="{Binding HasEarnedRows}"
                                   FontSize="13"
                                   Foreground="#5F5C53" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AchievementsCategoryCards"
                                      ItemsSource="{Binding DrawnCards}">
                            <!-- **THE ROW IS THE THING HE PRESSES** (work instruction 505). Where the
                                 contact has a map the whole row is a button on `OpenTheMapCommand`, with a
                                 hand cursor, reachable from the keyboard, and it says `map` in words at its
                                 right end, so it reads as pressable at rest and never on a hover (§0.5.1,
                                 §0.6). **Where there is no map it is not a button**: it says why in a word,
                                 and the contacts the card used to list sit in its tooltip. -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AchievementCategoryCard">
                                    <Panel Margin="0,0,0,8">
                                        <Button Classes="category-row"
                                                IsVisible="{Binding OpensAMap}"
                                                Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenTheMapCommand}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource HmCategoryItemTemplate}" />
                                        </Button>

                                        <ContentControl IsVisible="{Binding !OpensAMap}"
                                                        Content="{Binding}"
                                                        ContentTemplate="{StaticResource HmCategoryItemTemplate}"
                                                        ToolTip.Tip="{Binding ContactTip}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <!-- **THE NEXT STAMP** (§3.1): the one nearest unearned card, drawn as the card draws it,
                         inside a dashed, muted frame with a padlock and `Next stamp` in words (§0.6). Its
                         sentences may run to a second line between words, as the picture draws them in a
                         column this narrow; no word is ever broken. **Its callers open no map.** -->
                    <Panel IsVisible="{Binding HasNextStamp}">
                        <Rectangle Fill="#EFEBE1" Stroke="#8F8877" StrokeThickness="2" StrokeDashArray="3,2" RadiusX="14" RadiusY="14" />

                        <StackPanel Margin="14" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="M5 11 h14 v9 h-14 z M8 11 V8 a4 4 0 0 1 8 0 v3" Stroke="#5F5C53" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="NEXT STAMP" FontSize="12" FontWeight="SemiBold" Foreground="#5F5C53" VerticalAlignment="Center" />
                            </StackPanel>

                            <ItemsControl x:Name="AchievementsNextCard"
                                          Classes="next-stamp"
                                          ItemsSource="{Binding NextStamps}"
                                          ItemTemplate="{StaticResource HmCategoryItemTemplate}" />
                        </StackPanel>
                    </Panel>

                    <!-- **YOUR REACH**: the farthest of the stamps and the newest, both from the cards
                         already built. -->
                    <Border x:Name="AchievementsReach"
                            IsVisible="{Binding HasReach}"
                            Background="#14202B"
                            CornerRadius="14"
                            Padding="18">
                        <StackPanel Spacing="10">
                            <TextBlock Text="YOUR REACH" FontSize="12" FontWeight="SemiBold" Foreground="#C9D3DB" />

                            <StackPanel IsVisible="{Binding HasReachFarthest}">
                                <TextBlock Text="Farthest" FontSize="13" Foreground="#C9D3DB" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ReachFarthest}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                </Viewbox>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding HasReachNewest}">
                                <TextBlock Text="Newest" FontSize="13" Foreground="#C9D3DB" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ReachNewest}" FontSize="16" FontWeight="Bold" Foreground="White" />
                                </Viewbox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ============ A ROW'S MAP, OPENED ============ -->
        <!-- **THE ONE MAP IN THIS WINDOW, ON A CLICK** (work instruction 505, HM-DEC-209). It was
             the card's map enlarged (work instruction 342, ruling 16) and it is built exactly as
             that ruling built it; what changed is that it is now the only place a map is drawn
             here, since no row carries one. The conversation card's light-dismiss popup centred on
             the window, the same dismiss X and the same control opened to the path with the same
             ceiling, so a click outside closes it and nothing here is a second mechanism. **One
             popup for the window**, holding whichever row was pressed (`OpenedMap`, `OpenedCard`).
             **Its heading says where as well as who**, `Norway · LA1ZZZ`, because his question is
             where that is. Centred on a 720 px window it starts well below the back control, so it
             never covers it. **It writes nothing and transmits nothing.** -->
        <Popup x:Name="AchievementsMapPopup"
               IsOpen="{Binding MapIsOpen, Mode=TwoWay}"
               Placement="Center"
               PlacementTarget="{Binding $parent[Window]}"
               IsLightDismissEnabled="True">
            <Border Background="{StaticResource HmPanelBrush}"
                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0"
                               x:Name="AchievementsMapHeading"
                               Text="{Binding OpenedMapHeading}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <Button x:Name="AchievementsMapClose"
                            Grid.Row="0"
                            Content="&#x2715;"
                            Command="{Binding CloseTheMapCommand}"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,0"
                            Cursor="Hand"
                            ToolTip.Tip="Put it away." />

                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            HorizontalAlignment="Left">
                        <ctl:Ft8GlobeControl x:Name="AchievementsOpenedGlobe"
                                             Opened="True"
                                             MaxWidth="720"
                                             MaxHeight="400"
                                             Plot="{Binding OpenedMap}" />
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
