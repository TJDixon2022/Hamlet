<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Hamlet.App.Controls"
        xmlns:vm="using:Hamlet.App.ViewModels"
        xmlns:sys="using:System"
        x:Class="Hamlet.App.Views.AchievementsWindow"
        x:DataType="vm:AchievementsViewModel"
        Title="Achievements"
        Width="1040" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource HmBackgroundBrush}">

    <!-- **HIS OWN OPERATING RECORD, WHICH IS THE SAME KIND OF THING AS HIS LOG**
         (Tim's ruling, 2026-09-08). Not Help: Help is *how do I use this*, and
         this is *what have I done*. It sits directly under `My contacts…` for
         that reason.

         **IT READS AND IT NEVER WRITES.** Nothing on it reaches the file or a send
         path; the only commands are the badge presses and the back control, and
         both only change which view of the same record is showing.

         **THE EXPOSURE HERE IS AN ACHIEVEMENT CLAIMED THAT WAS NOT EARNED**
         (§0.0). Every figure on it is derived from the records at the moment it is
         opened and nothing is remembered. -->

    <!-- **A CLICK-INTO SYSTEM, NOT A SCROLLER** (Tim, 2026-09-12, on unit 331's
         window: *"It should open like this, but not scroll. When you click on a
         category, that category replaces it."*). The page and a category are two
         states of this one grid; the old card view, the belt, *Your best* and the
         file path are gone from the window.

         **TEXT FITS, EVERYWHERE, AND NOTHING WRAPS** (work instruction 332 task 1).
         Every slot is sized to the longest string it can carry on the test host's
         flat ten pixels a character, which is wider than any face on the glass;
         `TheAchievementsPageClicksInTests` measures it. That is why the window is
         1000 wide where 331 left it at 820. -->

    <Window.Styles>
        <Style Selector="Button.hm-badge">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- **A ROW THAT OPENS A MAP LOOKS PRESSABLE AT REST** (work instruction 505, §0.5.1):
             the hand cursor, the word `map` at its right end, and on the pointer its edge goes
             amber. The button draws no fill of its own; the row inside it is the face. -->
        <Style Selector="Button.category-row">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.category-row /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.category-row:pointerover Border.category-card">
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberEdgeBrush}" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <!-- **ONE BADGE, DRAWN ONCE** - the eight on the page and the seven inside
             Continents are the same shape, so they are the same template. -->
        <DataTemplate x:Key="HmBadgeTemplate" x:DataType="vm:AchievementBadge">
            <Button Classes="hm-chip hm-badge"
                    Margin="0,0,10,10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenCategoryCommand}"
                    CommandParameter="{Binding Kind}"
                    ToolTip.Tip="{Binding ScoreTip}">
                <Border Background="White"
                        BorderBrush="{StaticResource HmSlateEdgeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <StackPanel>
                        <!-- **THE COLOR BAND, WITH THE EMBLEM AND THE NAME ON IT.** The
                             hue is the badge's own and claims no mode family (§0.5); the
                             name is on it in words, so the hue carries nothing by itself
                             (§0.6). -->
                        <Border Background="{Binding Band}" Padding="8,7">
                            <Grid ColumnDefinitions="Auto,*">
                                <ctl:BadgeEmblemControl Grid.Column="0"
                                                        Emblem="{Binding Emblem}"
                                                        Ink="White"
                                                        Width="22" Height="22"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Classes="badge-name"
                                           Text="{Binding Name}"
                                           FontSize="13" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="White" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="8,6,8,8" Spacing="4">
                            <TextBlock Classes="badge-meaning"
                                       Text="{Binding Meaning}"
                                       FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <!-- **THE ONE CARD HE COULD EARN NEXT**, with the two forms
                                 of the mark: the ringed amber quill for a door and the
                                 still green one for a counter (§R16, §0.6). -->
                            <Border BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Background="{StaticResource HmBackgroundBrush}"
                                    Padding="6,4"
                                    IsVisible="{Binding HasNextCard}">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <ctl:AchievementMarkControl
                                        Grid.RowSpan="2"
                                        Form="Door"
                                        IsNew="True"
                                        IsVisible="{Binding NextIsDoor}"
                                        Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />

                                    <ctl:AchievementMarkControl
                                        Grid.RowSpan="2"
                                        Form="Counter"
                                        IsNew="True"
                                        IsVisible="{Binding !NextIsDoor}"
                                        Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="next"
                                               FontSize="10"
                                               Foreground="{StaticResource HmTextMutedBrush}" />

                                    <TextBlock Grid.Column="1" Grid.Row="1"
                                               Classes="badge-next"
                                               Text="{Binding NextCard}"
                                               FontSize="12"
                                               Foreground="{StaticResource HmTextPrimaryBrush}" />
                                </Grid>
                            </Border>

                            <!-- **THE CORNER, IN THREE SHORT LINES.** What he has - `0
                                 worked`, never `0 of 340` (§3.7) - then the points and
                                 level, then the gap. Absent rather than nought where the
                                 points file could not be read. -->
                            <TextBlock Classes="badge-corner"
                                       Text="{Binding Standing}"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="badge-corner"
                                       Text="{Binding PointsLine}"
                                       IsVisible="{Binding HasPointsLine}"
                                       TextAlignment="Right"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource HmGreenBrush}" />

                            <TextBlock Classes="badge-corner"
                                       Text="{Binding GapLine}"
                                       IsVisible="{Binding HasGapLine}"
                                       TextAlignment="Right"
                                       FontSize="11"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>

        <!-- **ONE ITEM OF A CATEGORY, DRAWN ONCE** (work instruction 505, HM-DEC-209). It replaces
             unit 335's trading card, which carried the path map across it at 231 px (R22, work
             instruction 342 rulings 11 and 16): Tim, 2026-09-30, *"we're just overdoing it on
             maps."* **No map is drawn here.** The one map in this window is the popup, on a click.

             **AN EARNED ONE IS A ROW**: the category's color at its left edge, the title bold,
             the call line under it, then the distance - the largest thing after the title, as
             it was on the card - band and mode over the date, the points, and at the right end
             the word that says what pressing it does. **Its height is the content's**, two lines
             of text and their padding, about sixty pixels: enough to read at arm's length, and
             small enough that a page of countries shows seven or eight at once. **The title's
             column is 340 px**, the longest entity name, Sovereign Military Order of Malta, at
             330 on the test host with room to spare, so no title clips and the distances down
             the page stand in one column. The author's, overrulable.

             **THE ONE UNEARNED ONE IS A PANEL**: the grey edge and `next` in words, what it
             wants, the quill line and the callers, exactly as the card drew them (§3.1, §0.6). -->
        <DataTemplate x:Key="HmCategoryItemTemplate" x:DataType="vm:AchievementCategoryCard">
            <Border Classes="category-card"
                    Background="White"
                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Opacity="{Binding CardOpacity}">
                <Grid ColumnDefinitions="6,*">
                    <Border Grid.Column="0"
                            IsVisible="{Binding Earned}"
                            Background="{Binding $parent[ItemsControl].((vm:AchievementCategory)DataContext).Band}" />

                    <Border Grid.Column="0"
                            IsVisible="{Binding !Earned}"
                            Background="#C9C5BA" />

                    <!-- ============ EARNED: ONE ROW ============ -->
                    <Grid Grid.Column="1"
                          IsVisible="{Binding Earned}"
                          Margin="14,8,14,8"
                          ColumnDefinitions="340,*,Auto,Auto,Auto,Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Classes="card-title"
                                       Text="{Binding Title}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <TextBlock Classes="card-callgrid"
                                       Text="{Binding CallGridLine}"
                                       IsVisible="{Binding HasCallGridLine}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="card-figure"
                                       Text="{Binding Figure}"
                                       IsVisible="{Binding ShowsFigure}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="card-count"
                                       Text="{Binding CountLine}"
                                       IsVisible="{Binding HasCountLine}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />
                        </StackPanel>

                        <!-- **A TIER'S BAR** (work instruction 335 task 4): Total Miles' tiers
                             and a distance first, with both figures in words above it so the bar
                             is never a bare fraction. -->
                        <StackPanel Grid.Column="1"
                                    IsVisible="{Binding HasTierBar}"
                                    Spacing="4"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="card-tier"
                                       Text="{Binding TierLine}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <ctl:BadgeProgressControl Fraction="{Binding TierFraction}"
                                                      Length="200"
                                                      Thickness="8"
                                                      HorizontalAlignment="Left"
                                                      Foreground="{Binding $parent[ItemsControl].((vm:AchievementCategory)DataContext).Band}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Classes="card-distance"
                                   Text="{Binding DistanceLine}"
                                   IsVisible="{Binding HasDistance}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                        <StackPanel Grid.Column="3"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="card-facts"
                                       Text="{Binding BandModeLine}"
                                       IsVisible="{Binding HasBandMode}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="card-facts"
                                       Text="{Binding DateLine}"
                                       IsVisible="{Binding HasDate}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="4"
                                   Classes="card-points"
                                   Text="{Binding PointsLine}"
                                   IsVisible="{Binding HasPoints}"
                                   Margin="20,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource HmGreenBrush}" />

                        <StackPanel Grid.Column="5"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="card-open"
                                       Text="{x:Static vm:AchievementCategoryCard.MapWord}"
                                       IsVisible="{Binding HasMap}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />

                            <TextBlock Classes="card-nomap"
                                       Text="{Binding NoMapWord}"
                                       IsVisible="{Binding HasNoMap}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextMutedBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- ============ THE ONE TO EARN NEXT: A PANEL ============ -->
                    <StackPanel Grid.Column="1"
                                IsVisible="{Binding !Earned}"
                                Margin="16,12,16,14"
                                Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="card-title"
                                       Text="{Binding Title}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <TextBlock Grid.Column="1"
                                       Classes="card-points"
                                       Text="{Binding PointsLine}"
                                       IsVisible="{Binding HasPoints}"
                                       Margin="12,0,0,0"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource HmGreenBrush}" />
                        </Grid>

                        <TextBlock Classes="card-figure"
                                   Text="{Binding Figure}"
                                   IsVisible="{Binding ShowsFigure}"
                                   FontSize="12"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <TextBlock Classes="card-count"
                                   Text="{Binding CountLine}"
                                   IsVisible="{Binding HasCountLine}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource HmTextPrimaryBrush}" />

                        <StackPanel IsVisible="{Binding HasTierBar}"
                                    Spacing="4"
                                    Margin="0,2,0,2">
                            <TextBlock Classes="card-tier"
                                       Text="{Binding TierLine}"
                                       FontSize="12"
                                       Foreground="{StaticResource HmTextPrimaryBrush}" />

                            <ctl:BadgeProgressControl Fraction="{Binding TierFraction}"
                                                      Length="300"
                                                      Thickness="10"
                                                      HorizontalAlignment="Left"
                                                      Foreground="{Binding $parent[ItemsControl].((vm:AchievementCategory)DataContext).Band}" />
                        </StackPanel>

                        <!-- **WHAT IT WANTS, AND WHO ON THE CQ LIST WOULD EARN IT** (work
                             instruction 335 task 3). The heading carries the time the list was
                             read; each caller carries the quill his row on the decoded list
                             wears, and the place is said in words, so the mark is never alone
                             (§0.6). **The callers open no map**: a caller has no path. -->
                        <TextBlock Classes="card-wants"
                                   Text="{Binding WantsLine}"
                                   IsVisible="{Binding HasWants}"
                                   FontSize="12"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <TextBlock Classes="card-quill"
                                   Text="{Binding QuillLine}"
                                   IsVisible="{Binding HasQuillLine}"
                                   FontSize="12"
                                   Foreground="{StaticResource HmTextMutedBrush}" />

                        <Border Classes="card-list"
                                IsVisible="{Binding HasCallersPanel}"
                                Background="{StaticResource HmBackgroundBrush}"
                                BorderBrush="{StaticResource HmSlateEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="card-callers-heading"
                                           Text="{Binding CallersHeading}"
                                           IsVisible="{Binding HasCallersHeading}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <ItemsControl ItemsSource="{Binding Callers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NextCaller">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                                <ctl:AchievementMarkControl
                                                    Form="Door"
                                                    IsNew="True"
                                                    IsVisible="{Binding OpensContinent}"
                                                    Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />

                                                <ctl:AchievementMarkControl
                                                    Form="Counter"
                                                    IsNew="True"
                                                    IsVisible="{Binding IsCounter}"
                                                    Width="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Height="{x:Static ctl:AchievementMarkControl.RowSide}"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1"
                                                           Classes="card-caller-place"
                                                           Text="{Binding Place}"
                                                           VerticalAlignment="Center"
                                                           FontSize="14"
                                                           Foreground="{StaticResource HmTextPrimaryBrush}" />

                                                <TextBlock Grid.Column="2"
                                                           Classes="card-caller-call"
                                                           Text="{Binding CallLine}"
                                                           Margin="12,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{StaticResource HmTextMutedBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Classes="card-more-callers"
                                           Text="{Binding MoreCallersLine}"
                                           IsVisible="{Binding HasMoreCallers}"
                                           FontSize="12"
                                           Foreground="{StaticResource HmTextMutedBrush}" />

                                <TextBlock Classes="card-nocaller"
                                           Text="{Binding NoCallerLine}"
                                           IsVisible="{Binding HasNoCaller}"
                                           FontSize="13"
                                           Foreground="{StaticResource HmTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">

        <!-- ============ THE PAGE: EIGHT BADGES AND NOTHING ELSE ============ -->
        <!-- **TITLE, THE RUNNING TOTAL, EIGHT BADGES IN TWO ROWS OF FOUR, THE LEGEND.**
             No scroller and nothing below the legend. **NO IMAGE ASSET IS REFERENCED
             HERE OR ANYWHERE IN `src/`**; every emblem is geometry in
             `BadgeEmblemControl`. -->
        <StackPanel x:Name="AchievementsPage"
                    IsVisible="{Binding ShowsPage}"
                    Spacing="10">
            <StackPanel Spacing="2">
                <TextBlock x:Name="AchievementsPageTitle"
                           Text="Achievements"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource HmTextPrimaryBrush}" />

                <TextBlock x:Name="AchievementsPageSubtitle"
                           Text="{Binding Page.Subtitle}"
                           FontSize="12"
                           Foreground="{StaticResource HmTextMutedBrush}" />

                <!-- **THE RUNNING TOTAL, ON THE PAGE, ALWAYS.** -->
                <TextBlock x:Name="AchievementsTotalLine"
                           Text="{Binding Page.TotalLine}"
                           IsVisible="{Binding Page.HasTotal}"
                           Margin="0,4,0,0"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource HmGreenBrush}" />

                <!-- **AND WHERE THE FILE COULD NOT BE READ, THE SENTENCE.** Amber
                     rather than red (HM-DEC-029's tone rule). **THE ONE LINE HERE
                     ALLOWED TO WRAP**, because it carries a path Hamlet does not
                     choose the length of. -->
                <TextBlock x:Name="AchievementsPointsProblem"
                           Text="{Binding Page.Problem}"
                           IsVisible="{Binding Page.HasProblem}"
                           Margin="0,4,0,0"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource HmAmberBrush}" />
            </StackPanel>

            <ItemsControl x:Name="AchievementsBadges"
                          ItemsSource="{Binding Page.Badges}"
                          ItemTemplate="{StaticResource HmBadgeTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="AchievementsLegend"
                       Text="Click a badge to open it. Orange ring: a door that opens a set. Green quill: a counter."
                       FontSize="11"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </StackPanel>

        <!-- ============ A CATEGORY, IN THE SAME FRAME ============ -->
        <!-- **A TEMPLATE OVER THE CATEGORY AND NOT BINDINGS THROUGH IT.** While the page
             shows there is no category, and bindings reaching through a null one each
             complain; with the category as content nothing is realized until there is
             one to draw. -->
        <ContentControl x:Name="AchievementsCategory"
                        IsVisible="{Binding ShowsCategory}"
                        Content="{Binding Category}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:AchievementCategory">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- **THE BACK CONTROL, TOP LEFT, NAMING WHERE IT GOES** - the picture's plain link
                 since work instruction 342 (ruling 15). The words (`BackLabel`) and the command
                 are unchanged; only the chip's hover fill and padding go. Muted ink at rest, the
                 primary ink under the pointer and a hand cursor, so it still reads as pressable
                 without a box, and the words carry what it does (§0.6). -->
            <Button x:Name="AchievementsBack"
                    Grid.Row="0"
                    Classes="hm-backlink"
                    HorizontalAlignment="Left"
                    Padding="0,2"
                    FontSize="13"
                    Cursor="Hand"
                    Foreground="{StaticResource HmTextMutedBrush}"
                    Content="{Binding BackLabel}"
                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).BackCommand}">
                <Button.Styles>
                    <Style Selector="Button.hm-backlink /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style Selector="Button.hm-backlink:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource HmTextPrimaryBrush}" />
                    </Style>
                    <Style Selector="Button.hm-backlink:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                </Button.Styles>
            </Button>

            <!-- **THE BAND, AS `assets/category-page-countries.png` DRAWS IT** (work
                 instruction 335 task 1, R22): the emblem and the name; under the name what
                 the kind is, the count, the score and the level; on the right a bar to the
                 next level with what it is of in words above it. **Where there is no next
                 level the words say so and no bar is drawn**, because a bar is a fraction
                 and a fraction of nothing asserts something nobody measured (§0.0).
                 **The ink is computed** (`BandInk`): white wherever white clears 4.5:1
                 against the band, dark where it does not (§0.6). -->
            <Border x:Name="AchievementsCategoryBand"
                    Grid.Row="1"
                    Background="{Binding Band}"
                    CornerRadius="10"
                    Padding="16,12"
                    Margin="0,8,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <ctl:BadgeEmblemControl Grid.RowSpan="2"
                                            Emblem="{Binding Emblem}"
                                            Ink="{Binding BandInk}"
                                            Width="40" Height="40"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center" />

                    <TextBlock x:Name="AchievementsCategoryName"
                               Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{Binding BandInk}" />

                    <TextBlock x:Name="AchievementsCategoryBandLine"
                               Grid.Column="1" Grid.Row="1"
                               Text="{Binding BandLine}"
                               FontSize="12"
                               Foreground="{Binding BandInk}" />

                    <StackPanel Grid.Column="2" Grid.RowSpan="2"
                                Width="300"
                                Spacing="6"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock x:Name="AchievementsLevelBarLine"
                                   Text="{Binding LevelBarLine}"
                                   IsVisible="{Binding HasLevelBar}"
                                   FontSize="12"
                                   Foreground="{Binding BandInk}" />

                        <ctl:BadgeProgressControl x:Name="AchievementsLevelBar"
                                                  IsVisible="{Binding HasLevelBar}"
                                                  Fraction="{Binding LevelFraction}"
                                                  Length="300"
                                                  Thickness="12"
                                                  Foreground="{Binding BandInk}"
                                                  Track="#40000000"
                                                  HorizontalAlignment="Left" />

                        <TextBlock x:Name="AchievementsNoNextLevel"
                                   Text="{Binding NoNextLevelLine}"
                                   IsVisible="{Binding HasNoNextLevel}"
                                   FontSize="12"
                                   Foreground="{Binding BandInk}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- **TOTAL MILES' OWN BAR ROW IS GONE** (work instruction 335 task 4): each tier
                 row carries its bar, and the band carries the level bar. -->

            <!-- **CONTINENTS: SEVEN ROWS, EACH PRESSABLE INTO ITS COUNTRIES** (work instruction
                 505, HM-DEC-209, replacing unit 335's seven trading cards). Each is the same row
                 every kind draws, inside the button that opens its countries. **They scroll inside
                 the category**, as every kind's rows do; the page itself still never scrolls. -->
            <ScrollViewer Grid.Row="3"
                          IsVisible="{Binding HasSubBadges}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AchievementsSubBadges"
                              ItemsSource="{Binding SubBadges}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementBadge">
                            <Button Classes="hm-badge"
                                    Margin="0,0,0,8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenCategoryCommand}"
                                    CommandParameter="{Binding Kind}"
                                    ToolTip.Tip="{Binding ScoreTip}">
                                <ContentControl Content="{Binding Card}"
                                                ContentTemplate="{StaticResource HmCategoryItemTemplate}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- **THE LIST: EARNED, AND THE NEAREST UNEARNED ONE, NOTHING BEYOND IT** (§3.1),
                 one column, full width (work instruction 505, HM-DEC-209, replacing unit 335's
                 two-column trading cards). A kind can hold a hundred countries, so the list
                 scrolls inside the category; the page itself never does. -->
            <ScrollViewer Grid.Row="3"
                          IsVisible="{Binding HasCards}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AchievementsCategoryCards"
                              ItemsSource="{Binding Cards}">
                    <!-- **THE ROW IS THE THING HE PRESSES** (work instruction 505). Where the
                         contact has a map the whole row is a button on `OpenTheMapCommand`, with a
                         hand cursor, reachable from the keyboard, and it says `map` in words at its
                         right end, so it reads as pressable at rest and never on a hover (§0.5.1,
                         §0.6). **Where there is no map it is not a button**: it says why in a word,
                         and the contacts the card used to list sit in its tooltip. -->
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementCategoryCard">
                            <Panel Margin="0,0,0,8">
                                <Button Classes="category-row"
                                        IsVisible="{Binding OpensAMap}"
                                        Command="{Binding $parent[Window].((vm:AchievementsViewModel)DataContext).OpenTheMapCommand}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource HmCategoryItemTemplate}" />
                                </Button>

                                <ContentControl IsVisible="{Binding !OpensAMap}"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource HmCategoryItemTemplate}"
                                                ToolTip.Tip="{Binding ContactTip}" />
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- ============ A CARD'S MAP, OPENED ============ -->
        <!-- **THE CONVERSATION CARD'S ENLARGED MAP, AGAIN** (work instruction 342, ruling 16):
             the same light-dismiss popup centred on the window, the same dismiss X and the same
             control opened to the path with the same ceiling, so a click outside closes it and
             nothing here is a second mechanism. **One popup for the window**, holding whichever
             card's map was clicked (`OpenedMap`). Centred on a 720 px window it starts well below
             the back control, so it never covers it. **It writes nothing and transmits nothing.** -->
        <Popup x:Name="AchievementsMapPopup"
               IsOpen="{Binding MapIsOpen, Mode=TwoWay}"
               Placement="Center"
               PlacementTarget="{Binding $parent[Window]}"
               IsLightDismissEnabled="True">
            <Border Background="{StaticResource HmPanelBrush}"
                    BorderBrush="{StaticResource HmSlateEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0"
                               Text="{Binding OpenedMapCallsign}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource HmTextPrimaryBrush}" />

                    <Button x:Name="AchievementsMapClose"
                            Grid.Row="0"
                            Content="&#x2715;"
                            Command="{Binding CloseTheMapCommand}"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,0"
                            Cursor="Hand"
                            ToolTip.Tip="Put it away." />

                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            BorderBrush="{StaticResource HmSlateEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            ClipToBounds="True"
                            HorizontalAlignment="Left">
                        <ctl:Ft8GlobeControl x:Name="AchievementsOpenedGlobe"
                                             Opened="True"
                                             MaxWidth="720"
                                             MaxHeight="400"
                                             Plot="{Binding OpenedMap}" />
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
