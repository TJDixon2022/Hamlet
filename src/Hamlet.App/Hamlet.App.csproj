<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- The engine has had this since the start; the shell had not, which
         meant a public member here could ship undocumented and nothing would
         say so. With TreatWarningsAsErrors on, CS1591 is now a build failure
         rather than a note nobody reads. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.0" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Playback only. The audio itself is generated in the engine, which
         stays free of any device or UI dependency (§0.1, HM-DEC-027). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hamlet.RadioEngine\Hamlet.RadioEngine.csproj" />
  </ItemGroup>

  <!-- The bylines live in /data with everything else the app reads, and are
       embedded so they ship with it (HM-DEC-039). One file, no copy to drift. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\bylines.json"
                      LogicalName="Hamlet.App.Data.bylines.json" />
  </ItemGroup>

  <!-- **THE MARKS, WHERE AVALONIA LOOKS FOR A RESOURCE.** They are not `/data`:
       that folder holds cited facts the application reads and reasons from, and a
       logo is neither cited nor reasoned from. It is a resource of the shell, and
       the shell is the only thing that may know what a picture is (§0.1). -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />

    <!-- The world coastline ships at the repository root because it is a
         PROJECT asset rather than an application one: it was drawn for this
         project, it is not survey data, and the note beside it says so.
         Linked rather than copied so there is one file (work instruction 299
         task 3). -->
    <AvaloniaResource Include="..\..\assets\world-coastline.svg" Link="Assets\world-coastline.svg" />
    <AvaloniaResource Include="..\..\assets\achievement-quill.svg" Link="Assets\achievement-quill.svg" />

    <!-- The azimuthal map, centred on the North Pole so it is the same
         picture for every operator rather than one file per station
         (Tim, 2026-09-10). Its geometry and its SHA-256 live together in
         AzimuthalMap.NorthPolar, and placing refuses against a file the
         hash does not recognise. -->
    <AvaloniaResource Include="..\..\assets\azimuthal-north-polar.png" Link="Assets\azimuthal-north-polar.png" />

    <!-- The flat relief map, ruled in by Tim on 2026-09-10: use this one,
         make it work. Its projection and SHA-256 live together in
         FlatWorldMap.Relief, and placing refuses against a file the hash
         does not recognise. Its licence is unknown and is raised in the
         asks queue - see assets/PROVENANCE.md. -->
    <AvaloniaResource Include="..\..\assets\world-flat-relief.png" Link="Assets\world-flat-relief.png" />

    <!-- The world coastline ships at the repository root because it is a
         PROJECT asset rather than an application one: it was drawn for this
         project, it is not survey data, and the note beside it says so.
         Linked rather than copied so there is one file (work instruction 299
         task 3). -->
    <AvaloniaResource Include="..\..\assets\world-coastline.svg" Link="Assets\world-coastline.svg" />
  </ItemGroup>

  <!-- The sample provider is an implementation detail of playback with a
       promise attached: it must hand back every generated sample, in order,
       for every mode. The test reaches it directly rather than the type being
       widened to public just to be provable — the same trade the engine makes
       for its telemetry format. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hamlet.App.Tests" />
  </ItemGroup>

</Project>
