<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hamlet.App.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- The collapsible-panel theme (HM-DEC-021). Self-contained:
                 it references no palette resource, so merge order is not a
                 trap for a future session. -->
            <ResourceInclude Source="avares://Hamlet.App/Controls/CollapsiblePanel.axaml" />
        </ResourceDictionary.MergedDictionaries>

        <!-- Hamlet palette (HM-DEC-012): light with COLOR. Each panel
             owns a color family: amber = tuning, blue = spectrum,
             green = decode. -->
        <Color x:Key="HmBackground">#F6F3EC</Color>
        <Color x:Key="HmTextPrimary">#2B2B28</Color>
        <Color x:Key="HmTextMuted">#6E6E66</Color>

        <Color x:Key="HmAmber">#C25E00</Color>
        <Color x:Key="HmAmberDeep">#9A4A00</Color>
        <Color x:Key="HmAmberTint">#FDF1DE</Color>
        <Color x:Key="HmAmberEdge">#E8C093</Color>

        <Color x:Key="HmBlue">#1F5FA8</Color>
        <Color x:Key="HmBlueTint">#EAF2FB</Color>
        <Color x:Key="HmBlueEdge">#AECBEA</Color>

        <Color x:Key="HmGreen">#0F7B4D</Color>
        <Color x:Key="HmGreenTint">#EAF6EF</Color>
        <Color x:Key="HmGreenEdge">#A9D8C1</Color>

        <Color x:Key="HmSlateTint">#EDEAE1</Color>
        <Color x:Key="HmSlateEdge">#D5CFC0</Color>

        <SolidColorBrush x:Key="HmBackgroundBrush" Color="{StaticResource HmBackground}" />
        <SolidColorBrush x:Key="HmTextPrimaryBrush" Color="{StaticResource HmTextPrimary}" />
        <SolidColorBrush x:Key="HmTextMutedBrush" Color="{StaticResource HmTextMuted}" />

        <SolidColorBrush x:Key="HmAmberBrush" Color="{StaticResource HmAmber}" />
        <SolidColorBrush x:Key="HmAmberDeepBrush" Color="{StaticResource HmAmberDeep}" />
        <SolidColorBrush x:Key="HmAmberTintBrush" Color="{StaticResource HmAmberTint}" />
        <SolidColorBrush x:Key="HmAmberEdgeBrush" Color="{StaticResource HmAmberEdge}" />

        <SolidColorBrush x:Key="HmBlueBrush" Color="{StaticResource HmBlue}" />
        <SolidColorBrush x:Key="HmBlueTintBrush" Color="{StaticResource HmBlueTint}" />
        <SolidColorBrush x:Key="HmBlueEdgeBrush" Color="{StaticResource HmBlueEdge}" />

        <SolidColorBrush x:Key="HmGreenBrush" Color="{StaticResource HmGreen}" />
        <SolidColorBrush x:Key="HmGreenTintBrush" Color="{StaticResource HmGreenTint}" />
        <SolidColorBrush x:Key="HmGreenEdgeBrush" Color="{StaticResource HmGreenEdge}" />

        <SolidColorBrush x:Key="HmSlateTintBrush" Color="{StaticResource HmSlateTint}" />
        <SolidColorBrush x:Key="HmSlateEdgeBrush" Color="{StaticResource HmSlateEdge}" />

        <FontFamily x:Key="HmMonoFont">Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
      </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- WHAT A BUTTON LOOKS LIKE WHEN IT CAN BE PRESSED (HM-DEC-087).

             Fluent's default button is a pale grey fill in every state
             including the working one, and its disabled state is a slightly
             paler grey. On warm paper those are near enough identical that a
             live control and a dead one cannot be told apart, and the operator
             reasonably assumes the worse of the two.

             This has now been diagnosed three times: twice as a state bug that
             was not there, and once as nine dead tray items that really were
             dead and looked exactly like the seven live ones beside them. Each
             time it was fixed for the two or three controls that had been
             complained about. Fixing it here is what stops a fourth.

             Ordinary buttons are white-faced with an amber edge and amber
             lettering, which reads as press me without shouting on a screen
             that can hold forty of them. The loud treatments stay where they
             are: the connect button, the send buttons and the band cards
             declare their own classes in the window's styles, which are applied
             after these and win. -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource HmAmberDeepBrush}" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberTintBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource HmAmberDeepBrush}" />
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="TextElement.Foreground" Value="White" />
        </Style>

        <!-- GREY MEANS UNPRESSABLE AND NOTHING ELSE (HM-DEC-079), which only
             becomes true once everything pressable has stopped being grey. This
             is the one appearance reserved for a control that genuinely cannot
             be used. -->
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#F2F0EA" />
            <Setter Property="BorderBrush" Value="#DAD6CC" />
            <Setter Property="TextElement.Foreground" Value="#9A968C" />
        </Style>
    </Application.Styles>

</Application>
