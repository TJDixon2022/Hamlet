<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HamManager.App.ViewModels"
        x:Class="HamManager.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Ham Manager"
        Width="1100" Height="720"
        MinWidth="860" MinHeight="560"
        Background="{StaticResource HmBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.hm-connect">
            <Setter Property="Background" Value="{StaticResource HmAmberBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,10" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.hm-connect:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.hm-connect:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource HmAmberDeepBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="TextBlock.hm-panel-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="4,0,4,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Ham"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource HmAmberBrush}" />
                <TextBlock Text="Manager"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource HmBlueBrush}" />
            </StackPanel>
            <TextBlock Text="The IC-7300 command console — the air, decoded."
                       FontSize="13"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </StackPanel>

        <!-- Frequency face: amber family -->
        <Border Grid.Row="1"
                Background="{StaticResource HmAmberTintBrush}"
                BorderBrush="{StaticResource HmAmberEdgeBrush}"
                BorderThickness="1" CornerRadius="8"
                Padding="24,16" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding FrequencyDisplay}"
                               FontFamily="{StaticResource HmMonoFont}"
                               FontSize="44" FontWeight="SemiBold"
                               Foreground="{StaticResource HmAmberDeepBrush}" />
                    <TextBlock Text="MHz  ·  CW"
                               FontSize="16" VerticalAlignment="Bottom"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource HmAmberBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="hm-connect"
                        Content="Connect"
                        Command="{Binding ToggleConnectCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Body: waterfall (blue family) over CW terminal (green family) -->
        <Grid Grid.Row="2" RowDefinitions="3*,2*">

            <Border Grid.Row="0"
                    Background="{StaticResource HmBlueTintBrush}"
                    BorderBrush="{StaticResource HmBlueEdgeBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="Waterfall"
                               Classes="hm-panel-label"
                               Margin="16,12"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource HmBlueBrush}" />
                    <TextBlock Text="Spectrum scope lands here — CI-V 0x27, HM-DEC-005"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource HmMonoFont}"
                               Foreground="{StaticResource HmBlueEdgeBrush}"
                               FontSize="14" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource HmGreenTintBrush}"
                    BorderBrush="{StaticResource HmGreenEdgeBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="CW terminal"
                               Classes="hm-panel-label"
                               Margin="16,12,16,4"
                               Foreground="{StaticResource HmGreenBrush}" />
                    <TextBlock Grid.Row="1"
                               Text="&gt; decoded text will arrive here — phase 1"
                               Margin="16,4,16,12"
                               FontFamily="{StaticResource HmMonoFont}"
                               Foreground="{StaticResource HmGreenBrush}"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar: slate -->
        <Border Grid.Row="3"
                Background="{StaticResource HmSlateTintBrush}"
                BorderBrush="{StaticResource HmSlateEdgeBrush}"
                BorderThickness="1" CornerRadius="6"
                Padding="12,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="{StaticResource HmTextMutedBrush}" />
        </Border>
    </Grid>
</Window>
