<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- CLAUDE.md §0.1: this project references no UI assembly, ever. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />

    <!-- Receive audio capture (§6, §0.1). Audio and DSP belong to the engine,
         so the device seam lives here rather than in the shell. NAudio is not
         a UI assembly and does not make it one. The WASAPI implementation is
         one class behind IAudioSource; everything else in the engine, the
         decoder included, only ever meets the interface. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- The FT8 decoder, built over steps 1 to 6 of this phase as a library with
       its own licence and its own version, and consumed here for the first time
       in unit 224. **The reference goes this way and only this way**: Ft8Sharp
       declares no ProjectReference at all and a test refuses one, which is what
       keeps it extractable (PHASE_PLAN.md, "the boundary is mechanical"). The
       engine is where audio and DSP live (§0.1), so the join sits here rather
       than in the shell. -->
  <ItemGroup>
    <ProjectReference Include="..\Ft8Sharp\Ft8Sharp.csproj" />

    <!-- **THE SIBLING, ADDED IN UNIT 249, AND IT DOES NOT WEAKEN THE PORT'S
         BOUNDARY.** What keeps `Ft8Sharp` extractable is that IT references
         nothing, which its own test enforces by reading its project file and
         refusing any reference at all. An application referencing the sibling is
         an arrow pointing the other way and touches none of that.

         `Ft8Sharp.Deep` is GPL-3.0 and Hamlet is headed for GPL-3.0 release
         (ruled 2026-09-04), so the licences sit correctly. -->
    <ProjectReference Include="..\Ft8Sharp.Deep\Ft8Sharp.Deep.csproj" />
  </ItemGroup>

  <!-- The cited Part 97 privileges data lives in /data as its single source
       of truth (HM-OPEN-005) and is embedded so it ships with the app. One
       file, so there is no copy to drift away from the regulation. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\privileges\us-part97-privileges.json" LogicalName="Hamlet.RadioEngine.Data.Privileges.us-part97-privileges.json" />
  </ItemGroup>

  <!-- The neighborhood conventions live in /data beside the privileges they
       are deliberately not (HM-DEC-054): that file says what may be
       transmitted, this one says what will actually be found there. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\bands\us-neighborhoods.json" LogicalName="Hamlet.RadioEngine.Data.Bands.us-neighborhoods.json" />
    <EmbeddedResource Include="..\..\data\bands\mode-receiver-conditions.json" LogicalName="Hamlet.RadioEngine.Data.Bands.mode-receiver-conditions.json" />
  </ItemGroup>

  <!-- The glossary lives in /data with the other editorial content and is
       embedded so it ships with the app (HM-DEC-041). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\glossary.json" LogicalName="Hamlet.RadioEngine.Data.glossary.json" />
  </ItemGroup>

  <!-- The telemetry line format is an internal detail with a public promise
       attached (HM-DEC-018), so the schema test reaches it directly rather
       than the format being widened to public just to be provable. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Hamlet.RadioEngine.Tests" />
  </ItemGroup>

</Project>
