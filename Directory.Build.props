  <!--
    1.12.258 -> 1.12.259, UNIT 296 TASK 8, UNDER HM-DEC-150. A PATCH, AND IT IS BOOKKEEPING.
    PHASE_OUTCOME.md gains unit 296's entry, written with the file editing tools in the format
    outcome-entry.py produces and saying so on its own face; the arguments are committed at
    tools/arbiter/unit296-append.bat so it can be replayed rather than reconstructed. Units 288 to
    295's entries were not touched, including the two STATE_AFTER verdicts each carries, and neither
    was the header block - it is a cursor and the entries win. PHASE_STATUS.md's WORK_INSTRUCTION
    line is set and nothing else. The validator exits 0, VALID, all seven rules, after failing rule 6
    once on an ordering block that carried no READ IN THIS ORDER line and spelled its count in words.
  -->
  <PropertyGroup>
    <Version>1.13.2</Version>
  </PropertyGroup>

  <!--
    THE BUILD DATE IS STAMPED AT COMPILE TIME (HM-DEC-079).

    About used to read it off the assembly file's last-write time, which is a
    property of a file copy rather than of a build: an incremental build that
    did not recompile this project, or a copy that preserved timestamps, made it
    report a day that had nothing to do with the code running. It showed
    2026-08-14 while running code built the next day.

    A build date that can be stale is worse than no build date, because it is
    the row somebody uses to check that two machines are running the same code.
    This one comes from the compilation itself and cannot be a copy artifact.
  -->
  <PropertyGroup>
    <BuildStampUtc>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm"))</BuildStampUtc>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildStampUtc</_Parameter1>
      <_Parameter2>$(BuildStampUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
