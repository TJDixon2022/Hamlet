+    /// <summary>How many times the window has been read.</summary>
+    public long Reads { get; private set; }
+
+    /// <summary>
+    /// Read the stretch that arrived while acquiring again, at the pitch and speed now
+    /// proved, and settle that reading in place of the ordinary read's.
+    /// </summary>
+    /// <param name="pitchHz">The pitch the tracker reports, proved.</param>
+    /// <param name="wordsPerMinute">The speed the last read decoded at, proved.</param>
+    /// <remarks>
+    /// <para>**CALLED ONCE, AT THE FIRST READ WITH BOTH PROOF STATES PROVED AFTER ONE
+    /// WITHOUT** (work instruction 471, DECIDED (3) and (4)). The window's raw audio
+    /// is mixed down again at the proved pitch through the same trailing integrator,
+    /// decoded at the proved speed with the gap lengths the read just used, and every
+    /// letter of it that ends after the settled mark and by the previous read's newest
+    /// hop is pinned. Where that decode has nothing, nothing of the ordinary read's
+    /// settles there.</para>
+    /// <para>**NOTHING ALREADY SETTLED IS TOUCHED**, and the window, the delay and the
+    /// read cadence are as they were. It uses the audio and the two proved values and
+    /// nothing else (R72).</para>
+    /// </remarks>
+    public void ReadAgainAtProvedValues(double pitchHz, double wordsPerMinute)
+    {
+        _pinned.Clear();
+        _pinnedSettled.Clear();
+        _pinnedThrough = -1;
+
+        if (_envelopeCount == 0 || wordsPerMinute <= 0 || _previousReadHop <= _settledThrough)
+        {
+            return;
+        }
+
+        var window = Remixed(pitchHz);
+        var result = CwProbabilisticDecoder.Decode(window, pitchHz, wordsPerMinute, _lastGapMilliseconds);
+        var windowStartHop = _hopsSeen - _envelopeCount;
+
+        foreach (var character in result.Characters)
+        {
+            var absolute = windowStartHop + character.EndHop;
+
+            if (character.Pattern.Length == 0 || absolute <= _settledThrough || absolute > _previousReadHop)
+            {
+                continue;
+            }
+
+            var at = TimeSpan.FromSeconds(absolute * CwProbabilisticDecoder.HopMilliseconds / 1000.0);
+
+            _pinned.Add((absolute - Math.Max(1, character.SpanHops), absolute, Character(character, result, at, window)));
+        }
+
+        _pinnedThrough = _previousReadHop;
+    }
+
+    /// <summary>The window as it would have been taken had every hop been mixed down at one pitch.</summary>
+    private double[] Remixed(double pitchHz)
+    {
+        var window = new double[_envelopeCount];
+        var from = Math.Max(0, _envelopeRawEnd[0] - _windowSamples);
+        var to = _envelopeRawEnd[_envelopeCount - 1];
+        var mixedI = new float[to - from];
+        var mixedQ = new float[to - from];
+        var step = 2 * Math.PI * pitchHz / _sampleRate;
+
+        for (var j = from; j < to; j++)
+        {
+            var phase = step * j % (2 * Math.PI);
+            var sample = _raw[j % _raw.Length];
+
+            mixedI[j - from] = (float)(sample * Math.Cos(phase));
+            mixedQ[j - from] = (float)(sample * -Math.Sin(phase));
+        }
+
+        for (var k = 0; k < _envelopeCount; k++)
+        {
+            var end = _envelopeRawEnd[k];
+            var filled = (int)Math.Min(end, _windowSamples);
+            double i = 0;
+            double q = 0;
+
+            for (var n = 0; n < filled; n++)
+            {
+                var w = _taper[_windowSamples - filled + n];
+                var at = end - filled + n - from;
+
+                i += mixedI[at] * w;
+                q += mixedQ[at] * w;
+            }
+
+            window[k] = Math.Sqrt((i * i) + (q * q)) / _taperWeight;
+        }
+
+        return window;
+    }
+
+    /// <summary>Settle every pinned letter that ends by an absolute hop, in order.</summary>
+    private void SettlePinnedThrough(long absolute)
+    {
+        while (_pinned.Count > 0 && _pinned[0].End <= absolute)
+        {
+            var (start, end, character) = _pinned[0];
+
+            _pinned.RemoveAt(0);
+
+            if (end <= _settledThrough)
+            {
+                continue;
+            }
+
+            _pinnedSettled.Add((start, end));
+            _settledThrough = end;
+            _settledCount++;
+            CharacterSettled?.Invoke(character);
+        }
+
+        if (_pinned.Count == 0 && _settledThrough > _pinnedThrough)
+        {
+            _pinnedSettled.Clear();
+        }
+    }
+
+    /// <summary>Whether a span crosses a pinned letter, settled or waiting.</summary>
+    private bool OverlapsPinned(long start, long end)
+        => _pinned.Any(p => Math.Min(p.End, end) - Math.Max(p.Start, start) > 0)
+           || _pinnedSettled.Any(p => Math.Min(p.End, end) - Math.Max(p.Start, start) > 0);
+
