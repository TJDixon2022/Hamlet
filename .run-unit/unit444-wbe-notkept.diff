+    /// <summary>The gaps a sender keyed, without the dropouts inside marks.</summary>
+    /// <param name="gaps">Every key-up the trigger produced, in milliseconds.</param>
+    /// <param name="unitMilliseconds">The dit.</param>
+    /// <returns>The key-ups at least half a dit long.</returns>
+    /// <remarks>
+    /// **A KEY-UP SHORTER THAN HALF A DIT IS A FADE INSIDE A MARK, NOT A GAP** (work
+    /// instruction 444, task 2). The three clusters are seeded across the range, so
+    /// one such key-up takes the shortest cluster to itself: on 17:37 a single 10 to
+    /// 15 millisecond key-up, 0.14 to 0.21 units and 1 of 44 gaps, did it in every
+    /// window where G1's condition held, the element heap became the character heap,
+    /// and no character gap was measured. The key puts the sender's shortest element
+    /// gap on that stretch at 0.57 units. G1 is unchanged; this only stops a dropout
+    /// from making its condition.
+    /// </remarks>
+    private static List<double> KeyedGaps(IReadOnlyList<double> gaps, double unitMilliseconds)
+        => gaps.Where(g => g >= unitMilliseconds / 2).ToList();
