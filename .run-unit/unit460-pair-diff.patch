+    /// <summary>How many dot-dash pairs fldigi's speed tracker averages over (cw.h, TRACKING_FILTER_SIZE).</summary>
+    public const int PairsTracked = 16;
+
+    /// <summary>
+    /// The dit the sender's dot-dash pairs imply, taken as fldigi's receiver tracks
+    /// its speed.
+    /// </summary>
+    /// <param name="marks">Mark lengths in milliseconds, in the order they were sent.</param>
+    /// <returns>The dit in milliseconds, or NaN where no pair was found.</returns>
+    /// <remarks>
+    /// <para>**THE SECOND DECODER'S SPEED TRACKING, TAKEN INTO OURS** (HM-REQ-129,
+    /// work instruction 459). Our code, written for our marks, following
+    /// `src/cw_rtty/cw.cxx` at fldigi `61b97f41`: a mark shorter than half the
+    /// tracked dit is a spike and is passed over (515, 818-822); a mark more than
+    /// two and less than four times the one before it, or the one before it that
+    /// many times this one, is a dot-dash pair (831-843), and its mean, two dits,
+    /// goes into a moving average of <see cref="PairsTracked"/> that fills with
+    /// its first value (update_tracking, 524-535; Cmovavg, filters.cxx:273). The
+    /// speed follows from the average (sync_parameters, 502).</para>
+    /// <para>**NO GAP IS ASKED, AND A BURST CANNOT PAIR.** <see cref="Measure"/>
+    /// takes the two short clusters, so a window where one mark in five is a 20 ms
+    /// burst reads its sender at twice his speed: `032050` read a 17 WPM sender at
+    /// 34.3 and printed U as `A`. A burst is more than four times shorter than the
+    /// marks beside it, so it never makes a pair, and a sender's dits and dahs do
+    /// (task 1's trace, `.run-unit/unit459-trace.txt`).</para>
+    /// <para>fldigi's own seed, its operator's speed setting, is not taken: the
+    /// average starts at the first pair, which is what Cmovavg does when empty.</para>
+    /// </remarks>
+    public static double PairUnit(IReadOnlyList<double> marks)
+    {
+        ArgumentNullException.ThrowIfNull(marks);
+
+        // update_tracking's own bounds: a dit at 200 WPM and a dah at 5 (cw.cxx:526-527).
+        const double shortestDit = 1200.0 / 200;
+        const double longestDah = 3 * 1200.0 / 5;
+
+        var window = new Queue<double>(PairsTracked);
+        var sum = 0.0;
+        var last = 0.0;
+
+        foreach (var mark in marks)
+        {
+            if (window.Count > 0 && mark < sum / window.Count / 4)
+            {
+                continue;
+            }
+
+            if (last > 0)
+            {
+                var (dit, dah) = mark > 2 * last && mark < 4 * last ? (last, mark)
+                    : last > 2 * mark && last < 4 * mark ? (mark, last)
+                    : (0.0, 0.0);
+
+                if (dit >= shortestDit && dah <= longestDah)
+                {
+                    var twoDits = (dit + dah) / 2;
+
+                    if (window.Count == 0)
+                    {
+                        for (var i = 0; i < PairsTracked; i++)
+                        {
+                            window.Enqueue(twoDits);
+                        }
+
+                        sum = PairsTracked * twoDits;
+                    }
+                    else
+                    {
+                        sum += twoDits - window.Dequeue();
+                        window.Enqueue(twoDits);
+                    }
+                }
+            }
+
+            last = mark;
+        }
+
+        return window.Count == 0 ? double.NaN : sum / window.Count / 2;
+    }
+
     /// <summary>Every mark and every gap the trigger produces.</summary>
     /// <param name="envelope">Envelope magnitudes.</param>
     /// <param name="hopMilliseconds">How long one hop lasts.</param>
