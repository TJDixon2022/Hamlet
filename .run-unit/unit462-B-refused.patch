+    /// <param name="unit">The dit in hops at the speed the lattice is run at.</param>
+    /// <returns>The shortest span.</returns>
+    private static int Shortest(Kind kind, double want, double unit)
+    {
+        var shortest = Math.Max(1, (int)(want * ShortestShare));
+
+        // A mark under half a dit is not an element (cw.cxx:515, 818-822).
+        return kind.IsKeyDown
+            ? Math.Max(shortest, (int)Math.Ceiling((SpikeDits * unit) - 1e-9))
+            : shortest;
+    }
