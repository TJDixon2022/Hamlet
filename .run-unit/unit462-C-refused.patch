+    /// <summary>The longest mark that is a dit, in dits; anything longer is a dah.</summary>
+    /// <remarks>
+    /// **FLDIGI'S CLASS EDGE, TAKEN AT ITS OWN RATIO** (work instruction 462,
+    /// HM-REQ-129): "a dot is anything shorter than 2 dot times", `if (element_usec
+    /// &lt;= two_dots)`, `cw.cxx:846-855` at `61b97f41`. It bounds which kind a
+    /// mark's span may take, at the dit the lattice is run at; the length penalty
+    /// still scores how well the span fits the kind it takes.
+    /// </remarks>
+    private const double ClassEdgeDits = 2.0;
+
+    /// <summary>The shortest and longest span one kind may take, in hops.</summary>
+    /// <param name="k">The kind.</param>
+    /// <param name="want">Its expected length in hops.</param>
+    /// <param name="unit">The dit in hops at the speed the lattice is run at.</param>
+    /// <returns>The bounds, both inclusive.</returns>
+    private static (int Shortest, int Longest) Spans(int k, double want, double unit)
+    {
+        var shortest = Math.Max(1, (int)(want * ShortestShare));
+        var longest = Math.Max(shortest + 1, (int)(want * LongestShare));
+
+        // A mark up to two dits is a dit and a longer one is a dah (cw.cxx:846-855).
+        var twoDots = (int)Math.Floor((ClassEdgeDits * unit) + 1e-9);
+
+        return k switch
+        {
+            0 => (shortest, Math.Max(shortest, Math.Min(longest, twoDots))),
+            1 => (Math.Min(longest, Math.Max(shortest, twoDots + 1)), longest),
+            _ => (shortest, longest),
+        };
+    }
