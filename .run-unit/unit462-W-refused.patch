+    /// <summary>The gap that ends a character, and the gap past which a word space is read, in dits.</summary>
+    /// <remarks>
+    /// **FLDIGI'S GAP EDGES, TAKEN AT THEIR OWN RATIOS** (work instruction 462,
+    /// HM-REQ-129): a silence of two dits up to four ends a character and one past
+    /// four is a word space, `cw.cxx:883-914` at `61b97f41`. They bound which kind a
+    /// gap's span may take, at the dit the lattice is run at, whether or not the
+    /// sender's own gaps are held; each kind's wanted length, and so its penalty,
+    /// is unchanged.
+    /// </remarks>
+    private const double CharacterEdgeDits = 2.0;
+
+    private const double WordEdgeDits = 4.0;
+
+    /// <summary>The shortest and longest span one kind may take, in hops.</summary>
+    /// <param name="k">The kind.</param>
+    /// <param name="want">Its expected length in hops.</param>
+    /// <param name="unit">The dit in hops at the speed the lattice is run at.</param>
+    /// <returns>The bounds, both inclusive.</returns>
+    private static (int Shortest, int Longest) Spans(int k, double want, double unit)
+    {
+        var shortest = Math.Max(1, (int)(want * ShortestShare));
+        var longest = Math.Max(shortest + 1, (int)(want * LongestShare));
+
+        // Under two dits nothing ends; two to four ends a character; past four is a word (cw.cxx:883-914).
+        var character = (int)Math.Ceiling((CharacterEdgeDits * unit) - 1e-9);
+        var word = (int)Math.Floor((WordEdgeDits * unit) + 1e-9);
+
+        return k switch
+        {
+            2 => (Math.Min(shortest, character - 1), character - 1),
+            3 => (character, word),
+            4 => (word + 1, Math.Max(longest, word + 2)),
+            _ => (shortest, longest),
+        };
+    }
