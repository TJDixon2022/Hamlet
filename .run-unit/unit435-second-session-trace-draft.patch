+    /// <summary>
+    /// 7.4, work instruction 435 task 1: per read, the speed the estimator
+    /// measured, the speed the entry decoder used, and the speed the carry rule
+    /// of section 6 would have used, on the opening and on a locked stretch.
+    /// </summary>
+    /// <remarks>
+    /// <para>**A PRINTER. IT ASSERTS NOTHING AND WRITES NOTHING.** The rule is
+    /// replayed over the reads by <see cref="UnderTheRule"/>; nothing under `src`
+    /// is consulted for it.</para>
+    /// <para>The opening is the spliced stream 27.0 to 46.2 s, three seconds
+    /// before 7.4's stretch so the carry has the reads before it; the locked
+    /// stretch is the stream 90.0 to 106.2 s, which is `004108` 13.8 to 30 s; and
+    /// `003919` is decoded cold, whole.</para>
+    /// </remarks>
+    [Fact]
+    public void WhatTheSpeedRuleWouldHaveUsed()
+    {
+        _output.WriteLine(string.Create(
+            Invariant,
+            $"check | rule: carry the estimator's last taken speed {CarrySeconds:0.0} s; set aside an estimate unready, outside {CwProbabilisticDecoder.SlowestWpm:0} to {CwProbabilisticDecoder.FastestWpm:0} wpm, or departing by more than {DepartureFactor:0.0} either way; a departure on two consecutive reads is taken; no carry, the grid"));
+
+        var (samples, rate, pieces) = Splice(Session);
+        var stream = Trace(samples, rate);
+        var ruled = UnderTheRule(stream.Reads);
+
+        foreach (var (label, from, to) in new[] { ("opening", 27.0, 46.2), ("locked", 90.0, 106.2) })
+        {
+            var piece = pieces.Last(p => p.StreamStart / (double)rate <= from);
+            var offset = (piece.Skip - piece.StreamStart) / (double)rate;
+
+            _output.WriteLine("");
+            _output.WriteLine(string.Create(
+                Invariant,
+                $"{label.ToUpperInvariant()} | stream {from:0.0} to {to:0.0} s, which is {piece.Name} {from + offset:0.0} to {to + offset:0.0} s | text {stream.Text(from, to)}"));
+            PrintRuleReads(label, ruled.Where(x => x.Read.Seconds >= from && x.Read.Seconds < to));
+        }
+
+        var inOpening = ruled.Where(x => x.Read.Seconds >= 30.0 && x.Read.Seconds < 46.2).ToList();
+
+        _output.WriteLine("");
+        _output.WriteLine(string.Create(
+            Invariant,
+            $"stop | stream 30 to 46.2 s: {inOpening.Count} reads, {inOpening.Count(x => !x.Usable)} at the grid at entry, {inOpening.Count(x => x.Differs)} where the rule's speed differs from the entry's"));
+
+        var cold = WavAudio.Read(Path.Combine(Folder, "cw-2026-09-24-003919.wav"));
+        var coldRun = Trace(cold.Samples, cold.SampleRate);
+        var coldRuled = UnderTheRule(coldRun.Reads);
+
+        _output.WriteLine("");
+        _output.WriteLine($"COLD 003919 | whole | text {coldRun.Text()}");
+        PrintRuleReads("003919 cold", coldRuled);
+        _output.WriteLine($"stop | 003919 cold: {coldRuled.Count} reads, {coldRuled.Count(x => !x.Usable)} at the grid at entry, {coldRuled.Count(x => x.Differs)} where the rule's speed differs");
+    }
