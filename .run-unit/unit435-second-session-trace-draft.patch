+    /// <summary>
+    /// 7.4, work instruction 435 task 1: over every capture row and every keyed
+    /// recording, how many reads the carry rule would have decoded at a speed the
+    /// entry did not.
+    /// </summary>
+    /// <remarks>
+    /// A forecast for 3.2's four tests and not a gate. Each recording is decoded
+    /// cold, as the captures type and the keyed scorers decode it, and once even
+    /// where it is both.
+    /// </remarks>
+    [Fact]
+    public void WhereTheSpeedRuleWouldDiffer()
+    {
+        var names = TheCapturesThatDecodeKeepDecodingTests.Floors
+            .Select(row => (string)row[0])
+            .Concat(WhatTheStrayLettersRestOnTests.KeyedRecordings.Select(k => k.Name))
+            .Distinct(StringComparer.Ordinal)
+            .ToList();
+
+        var keyed = WhatTheStrayLettersRestOnTests.KeyedRecordings.Select(k => k.Name).ToHashSet(StringComparer.Ordinal);
+        var rows = TheCapturesThatDecodeKeepDecodingTests.Floors.Select(row => (string)row[0]).ToHashSet(StringComparer.Ordinal);
+        var touched = new List<string>();
+        var allReads = 0;
+        var allDiffer = 0;
+
+        _output.WriteLine("differ | recording | capture row | keyed | reads | at the grid at entry | carried on unready or outside | carried on a departure | differs | s where it differs");
+
+        foreach (var name in names)
+        {
+            var audio = WavAudio.Read(Path.Combine(CapturedSignalTests.Folder, name + ".wav"));
+            var ruled = UnderTheRule(Trace(audio.Samples, audio.SampleRate).Reads);
+            var differ = ruled.Where(x => x.Differs).ToList();
+
+            allReads += ruled.Count;
+            allDiffer += differ.Count;
+
+            if (differ.Count > 0)
+            {
+                touched.Add(name);
+            }
+
+            _output.WriteLine(string.Create(
+                Invariant,
+                $"differ | {name} | {(rows.Contains(name) ? "yes" : "-")} | {(keyed.Contains(name) ? "yes" : "-")} | {ruled.Count} | {ruled.Count(x => !x.Usable)} | {differ.Count(x => !x.Usable)} | {differ.Count(x => x.Usable)} | {differ.Count} | {string.Join(" ", differ.Select(x => x.Read.Seconds.ToString("0.0", Invariant)))}"));
+        }
+
+        _output.WriteLine(string.Create(
+            Invariant,
+            $"differ | all | {names.Count} recordings, {rows.Count} capture rows, {keyed.Count} keyed | {allReads} reads | {allDiffer} differ | on {touched.Count} recordings: {string.Join(", ", touched)}"));
+    }
