+    /// <summary>How far the estimator may depart from the carried speed, either way, before it is set aside (work instruction 435, section 6).</summary>
+    private const double DepartureFactor = 1.5;
+
+    /// <summary>How long a speed taken from the estimator may be carried, in seconds of audio (work instruction 435, section 6).</summary>
+    private const double CarrySeconds = 3.0;
+
+    /// <summary>What the speed rule of work instruction 435 would have used on one read.</summary>
+    /// <param name="Read">The read, as the decoder made it.</param>
+    /// <param name="EstimatorWpm">The estimator's own speed on the read's window, or nought when it was not ready.</param>
+    /// <param name="Usable">Whether the entry decoder took it: ready and inside the range.</param>
+    /// <param name="RuleWpm">The speed the rule would have used, or null for the grid.</param>
+    /// <param name="Clause">Which clause of the rule decided it.</param>
+    internal sealed record RuleRead(Read Read, double EstimatorWpm, bool Usable, double? RuleWpm, string Clause)
+    {
+        /// <summary>True where the rule would have decoded at a speed the entry did not.</summary>
+        public bool Differs => Clause.StartsWith("carried", StringComparison.Ordinal)
+            && RuleWpm is { } wpm
+            && Math.Abs(wpm - Read.HeldWpm) > 1e-6;
+
+        /// <summary>The rule's speed as printed.</summary>
+        public string RuleText => RuleWpm is { } wpm ? wpm.ToString("0.0", Invariant) : "grid";
+    }
+
+    /// <summary>
+    /// The rule of work instruction 435, section 6, replayed over the reads a
+    /// run made. It changes nothing the run decoded.
+    /// </summary>
+    /// <remarks>
+    /// The estimator measures the window, and the window does not depend on the
+    /// speed a read decodes at, so the estimator's figure on every read is the
+    /// same with or without the rule and the replay is exact about which speed
+    /// the rule would have handed the path. What the path would then have spelled
+    /// is task 2's to measure.
+    /// </remarks>
+    internal static IReadOnlyList<RuleRead> UnderTheRule(IReadOnlyList<Read> reads)
+    {
+        var ruled = new List<RuleRead>();
+        double? carried = null;
+        var carriedAt = 0.0;
+        var departedLast = false;
+
+        foreach (var r in reads)
+        {
+            var estimator = r.EstimatorUnitMs > 0 ? 1200.0 / r.EstimatorUnitMs : 0;
+            var fresh = carried is not null && r.Seconds - carriedAt <= CarrySeconds + 1e-9;
+            double? wpm;
+            string clause;
+
+            if (r.FromEstimator)
+            {
+                var departs = fresh
+                    && Math.Max(estimator / carried!.Value, carried.Value / estimator) > DepartureFactor;
+
+                if (!departs)
+                {
+                    clause = fresh ? "estimator, within 1.5 of the carried" : "estimator, nothing carried within 3.0 s";
+                    wpm = estimator;
+                    carried = estimator;
+                    carriedAt = r.Seconds;
+                    departedLast = false;
+                }
+                else if (departedLast)
+                {
+                    clause = "estimator, departed on two consecutive reads, taken";
+                    wpm = estimator;
+                    carried = estimator;
+                    carriedAt = r.Seconds;
+                    departedLast = false;
+                }
+                else
+                {
+                    clause = "carried, the estimator departs by more than 1.5";
+                    wpm = carried;
+                    departedLast = true;
+                }
+            }
+            else
+            {
+                departedLast = false;
+
+                if (fresh)
+                {
+                    clause = estimator > 0 ? "carried, the estimator is outside the range" : "carried, the estimator is not ready";
+                    wpm = carried;
+                }
+                else
+                {
+                    clause = "grid, nothing carried within 3.0 s";
+                    wpm = null;
+                }
+            }
+
+            ruled.Add(new RuleRead(r, estimator, r.FromEstimator, wpm, clause));
+        }
+
+        return ruled;
+    }
+
+    private void PrintRuleReads(string label, IEnumerable<RuleRead> ruled)
+    {
+        _output.WriteLine($"{label} | s | estimator wpm | estimator unit ms | estimator | entry wpm | entry from | rule wpm | rule clause | differs");
+
+        foreach (var x in ruled)
+        {
+            _output.WriteLine(string.Create(
+                Invariant,
+                $"{label} | {x.Read.Seconds:0.0} | {x.EstimatorWpm:0.0} | {x.Read.EstimatorUnitMs:0.0} | {(x.EstimatorWpm <= 0 ? "not ready" : x.Usable ? "usable" : "outside the range")} | {x.Read.HeldWpm:0.0} | {x.Read.SpeedFrom} | {x.RuleText} | {x.Clause} | {(x.Differs ? "yes" : "-")}"));
+        }
+    }
