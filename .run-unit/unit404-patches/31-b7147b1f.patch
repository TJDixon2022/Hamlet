+    /// <param name="db">The envelope in decibels.</param>
+    /// <returns>The threshold in decibels.</returns>
+    /// <remarks>
+    /// <para>**OTSU ASSUMES TWO CLASSES OF COMPARABLE MASS AND A BAND MOSTLY
