+    /// <summary>One mixed sample into the 8 kHz ring, each 8 kHz sample the mean of those in it.</summary>
+    /// <remarks>
+    /// The same rule <see cref="CwProbabilisticDecoder.FrontEndBaseband"/> keeps
+    /// offline (work instruction 463, form A1).
+    /// </remarks>
+    private void FrontEnd(float i, float q)
+    {
+        var bucket = _mixedCount * CwProbabilisticDecoder.FrontEndRate / _sampleRate;
+
+        while (bucket > _frontCount)
+        {
+            var at = (int)(_frontCount % _frontI.Length);
+
+            _frontI[at] = _frontTaken > 0 ? (float)(_frontSumI / _frontTaken) : 0f;
+            _frontQ[at] = _frontTaken > 0 ? (float)(_frontSumQ / _frontTaken) : 0f;
+            _frontFilled = Math.Min(_frontFilled + 1, _frontI.Length);
+            _frontCount++;
+            _frontSumI = 0;
+            _frontSumQ = 0;
+            _frontTaken = 0;
+        }
+
+        _frontSumI += i;
+        _frontSumQ += q;
+        _frontTaken++;
+        _mixedCount++;
+    }
+
+    /// <summary>
+    /// The window again through fldigi's front end at one speed, centred where
+    /// each hop's own integrator is centred (work instruction 463, form A1).
+    /// </summary>
+    private double[] FrontEndWindow(double wordsPerMinute)
+    {
+        var lead = (_windowSamples - 1) / 2;
+        var centres = new double[_envelopeCount];
+
+        for (var h = 0; h < _envelopeCount; h++)
+        {
+            centres[h] = CwProbabilisticDecoder.FrontEndPosition(
+                _pushedAt[h] - 1 - lead, _sampleRate);
+        }
+
+        var first = _frontCount - _frontFilled;
+        var i = new float[_frontFilled];
+        var q = new float[_frontFilled];
+
+        for (var n = 0; n < _frontFilled; n++)
+        {
+            var at = (int)((first + n) % _frontI.Length);
+
+            i[n] = _frontI[at];
+            q[n] = _frontQ[at];
+        }
+
+        return CwProbabilisticDecoder.SpeedMatchedEnvelope(i, q, first, wordsPerMinute, centres);
+    }
