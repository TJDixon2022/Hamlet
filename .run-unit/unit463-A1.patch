+    /// <summary>The audio mixed to the pitch and averaged down to 8 kHz, as fldigi reads it.</summary>
+    /// <param name="samples">The audio.</param>
+    /// <param name="sampleRate">Samples per second.</param>
+    /// <param name="toneHz">The pitch.</param>
+    /// <returns>The two quadrature arms at 8 kHz.</returns>
+    /// <remarks>
+    /// The same mixdown <see cref="Envelope(IReadOnlyList{float}, int, double, double)"/>
+    /// makes; each 8 kHz sample is the mean of the audio samples that fall in it.
+    /// </remarks>
+    public static (float[] I, float[] Q) FrontEndBaseband(
+        IReadOnlyList<float> samples, int sampleRate, double toneHz)
+    {
+        ArgumentNullException.ThrowIfNull(samples);
+
+        var count = (int)((long)samples.Count * FrontEndRate / sampleRate);
+        var sumI = new double[count];
+        var sumQ = new double[count];
+        var taken = new int[count];
+        var omega = -2 * Math.PI * toneHz / sampleRate;
+
+        for (var n = 0; n < samples.Count; n++)
+        {
+            var k = (int)((long)n * FrontEndRate / sampleRate);
+
+            if (k >= count)
+            {
+                break;
+            }
+
+            sumI[k] += samples[n] * Math.Cos(omega * n);
+            sumQ[k] += samples[n] * Math.Sin(omega * n);
+            taken[k]++;
+        }
+
+        var i = new float[count];
+        var q = new float[count];
+
+        for (var k = 0; k < count; k++)
+        {
+            if (taken[k] > 0)
+            {
+                i[k] = (float)(sumI[k] / taken[k]);
+                q[k] = (float)(sumQ[k] / taken[k]);
+            }
+        }
+
+        return (i, q);
+    }
+
+    /// <summary>
+    /// fldigi's detection envelope at one speed, one magnitude at each of the
+    /// given centres (work instruction 463, form A1; HM-REQ-129).
+    /// </summary>
+    /// <param name="i">The in-phase arm at 8 kHz.</param>
+    /// <param name="q">The quadrature arm at 8 kHz.</param>
+    /// <param name="firstIndex">The 8 kHz sample the arrays begin at, counted from the first.</param>
+    /// <param name="wordsPerMinute">The speed the read is decoded at.</param>
+    /// <param name="centres">Where each hop sits, in 8 kHz samples counted from the first.</param>
+    /// <returns>One magnitude per centre.</returns>
+    /// <remarks>
+    /// <para>**FLDIGI'S FRONT END, AT THE READ'S OWN SPEED** (`cw.cxx` at
+    /// `61b97f41`): a Blackman-windowed sinc low-pass of 1024 taps at 5 x WPM / 1.2
+    /// hertz (352-356, 396, 696; `fftfilt.cxx` 128-160), its magnitude every
+    /// sixteenth sample (704-707), and a moving average of symbollen / (2 x 16) of
+    /// those, half a dit (326, 358-361, 428-431, 708).</para>
+    /// <para>**CENTRED ON EACH HOP**, where fldigi's runs behind the audio, so the
+    /// marks it forms sit on the hops the 45 hertz envelope's do and every timing
+    /// read from that envelope still lines up. A decimated sample the arrays do not
+    /// cover counts as nought.</para>
+    /// </remarks>
+    public static double[] SpeedMatchedEnvelope(
+        float[] i, float[] q, long firstIndex, double wordsPerMinute, IReadOnlyList<double> centres)
+    {
+        ArgumentNullException.ThrowIfNull(i);
+        ArgumentNullException.ThrowIfNull(q);
+        ArgumentNullException.ThrowIfNull(centres);
+
+        var envelope = new double[centres.Count];
+
+        if (centres.Count == 0 || i.Length == 0 || wordsPerMinute <= 0)
+        {
+            return envelope;
+        }
+
+        const int half = FrontEndTaps / 2;
+        var fc = 5.0 * wordsPerMinute / 1.2 / FrontEndRate;
+        var taps = new double[FrontEndTaps];
+
+        for (var t = 0; t < FrontEndTaps; t++)
+        {
+            var sinc = t == half
+                ? 2.0 * fc
+                : Math.Sin(2 * Math.PI * fc * (t - half)) / (Math.PI * (t - half));
+            var blackman = 0.42
+                - (0.50 * Math.Cos(2.0 * Math.PI * t / FrontEndTaps))
+                + (0.08 * Math.Cos(4.0 * Math.PI * t / FrontEndTaps));
+
+            taps[t] = sinc * blackman;
+        }
+
+        var gain = taps.Sum();
+        var bfv = Math.Max(1, (int)Math.Round(FrontEndRate * 1.2 / wordsPerMinute) / (2 * FrontEndDecimation));
+        var lead = (bfv - 1) / 2;
+        var last = firstIndex + i.Length;
+
+        long First(double centre) => (long)Math.Round(centre / FrontEndDecimation) - lead;
+
+        var from = First(centres[0]);
+        var to = First(centres[^1]) + bfv;
+        var magnitudes = new double[Math.Max(0, to - from)];
+
+        for (var p = from; p < to; p++)
+        {
+            var at = p * FrontEndDecimation;
+
+            if (at < firstIndex || at >= last)
+            {
+                continue;
+            }
+
+            double si = 0;
+            double sq = 0;
+            var start = Math.Max(0, (int)(firstIndex - (at - half)));
+            var stop = Math.Min(FrontEndTaps, (int)(last - (at - half)));
+
+            for (var t = start; t < stop; t++)
+            {
+                var n = (int)(at - half + t - firstIndex);
+
+                si += taps[t] * i[n];
+                sq += taps[t] * q[n];
+            }
+
+            magnitudes[p - from] = Math.Sqrt((si * si) + (sq * sq)) / gain;
+        }
+
+        for (var h = 0; h < centres.Count; h++)
+        {
+            var first = First(centres[h]);
+            double sum = 0;
+
+            for (var b = 0; b < bfv; b++)
+            {
+                var p = first + b - from;
+
+                if (p >= 0 && p < magnitudes.Length)
+                {
+                    sum += magnitudes[p];
+                }
+            }
+
+            envelope[h] = sum / bfv;
+        }
+
+        return envelope;
+    }
