+    /// <summary>Where one audio sample sits on the front end's 8 kHz clock.</summary>
+    /// <param name="sample">The audio sample, counted from the first.</param>
+    /// <param name="sampleRate">Samples per second.</param>
+    /// <returns>Its position in 8 kHz samples.</returns>
+    public static double FrontEndPosition(double sample, int sampleRate)
