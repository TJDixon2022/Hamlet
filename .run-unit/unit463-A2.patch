+    /// <summary>fldigi's AGC attack in our hops: 200 decimated samples at 500 a second, 0.4 s.</summary>
+    /// <remarks>`cwrx_attack` case 1, the default (`cw.cxx` 599-603 at `61b97f41`).</remarks>
+    public const int AgcAttackHops = 80;
+
+    /// <summary>fldigi's AGC decay in our hops: 1000 decimated samples at 500 a second, 2 s.</summary>
+    /// <remarks>`cwrx_decay` case 1, the default (`cw.cxx` 604-608 at `61b97f41`).</remarks>
+    public const int AgcDecayHops = 400;
+
+    /// <summary>
+    /// fldigi's signal, noise-floor and peak trackers, dividing each envelope
+    /// magnitude by the peak (work instruction 463, form A2; HM-REQ-129).
+    /// </summary>
+    /// <remarks>
+    /// <para>**FLDIGI'S OWN, STEP FOR STEP** (`cw.cxx` at `61b97f41`): the signal
+    /// average at the decay; the floor below it at the attack when falling under
+    /// itself and at the decay otherwise; the peak above it at the attack when
+    /// rising over itself and at the decay otherwise (610-623); then the value over
+    /// the peak, or nought where the peak is nought (629-632). They start where the
+    /// constructor starts them, at 0, 1 and 1 (347, 376-377).</para>
+    /// <para>**ONE STEP PER HOP**, where fldigi steps every decimated sample, so its
+    /// weights are carried over as the same times in our hops.</para>
+    /// </remarks>
+    public sealed class FrontEndAgc
+    {
+        private double _signal;
+        private double _floor = 1.0;
+        private double _peak = 1.0;
+
+        /// <summary>Step the trackers on one magnitude and return it over the peak.</summary>
+        /// <param name="value">The envelope magnitude.</param>
+        /// <returns>The magnitude divided by the tracked peak.</returns>
+        public double Divide(double value)
+        {
+            _signal = DecayAverage(_signal, value, AgcDecayHops);
+
+            if (value < _signal)
+            {
+                _floor = value < _floor
+                    ? DecayAverage(_floor, value, AgcAttackHops)
+                    : DecayAverage(_floor, value, AgcDecayHops);
+            }
+
+            if (value > _signal)
+            {
+                _peak = value > _peak
+                    ? DecayAverage(_peak, value, AgcAttackHops)
+                    : DecayAverage(_peak, value, AgcDecayHops);
+            }
+
+            return _peak != 0 ? value / _peak : 0;
+        }
+
+        /// <summary>`decayavg` (`misc.h` 59-63).</summary>
+        private static double DecayAverage(double average, double input, int weight)
+            => weight <= 1 ? input : ((input - average) / weight) + average;
+    }
+
+    /// <summary>A whole envelope through <see cref="FrontEndAgc"/> from its first hop.</summary>
+    /// <param name="envelope">The envelope.</param>
+    /// <returns>Each magnitude over the peak tracked to it.</returns>
+    public static double[] AgcDivided(IReadOnlyList<double> envelope)
+    {
+        ArgumentNullException.ThrowIfNull(envelope);
+
+        var agc = new FrontEndAgc();
+        var divided = new double[envelope.Count];
+
+        for (var h = 0; h < divided.Length; h++)
+        {
+            divided[h] = agc.Divide(envelope[h]);
+        }
+
+        return divided;
+    }
+
